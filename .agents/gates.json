{
  "schema": 1,
  "baseline": {
    "revision": null,
    "tree_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "maxima": {
      "directory_entries": 0,
      "code_file_lines": 0,
      "function_lines": 0
    }
  },
  "limits": {
    "directory_entries": 30,
    "code_file_lines": 1000,
    "function_lines": 100
  },
  "function_adapters": {
    ".sh": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".bash": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".lua": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".c": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".cc": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".cpp": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".cxx": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".h": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".hpp": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".cu": ["{python}", ".agents/checks/function_spans.py", "{file}"],
    ".cuh": ["{python}", ".agents/checks/function_spans.py", "{file}"]
  },
  "code_suffixes": [],
  "code_paths": [],
  "checks": [
    {
      "name": "Staged source lint and formatting",
      "kind": "static",
      "path_only": true,
      "paths": [
        ".clang-format", ".clang-tidy", "ruff.toml", "*.py", "*.pyi", "*.c", "*.cc", "*.cpp",
        "*.cxx", "*.cu", "*.h", "*.hh", "*.hpp", "*.hxx", "*.h++", "*.cuh", "*.inl", "*.ipp",
        "*.tpp"
      ],
      "command": ["{python}", "-B", ".agents/checks/source_style.py"],
      "timeout": 1200
    },
    {
      "name": "XMake host and SM100 build",
      "kind": "static",
      "path_only": true,
      "paths": [
        "xmake.lua", "tools/build.sh", "tools/build-probe.sh", "tools/toolchain-xmake.sh",
        "src/*", "include/*", "*.c", "*.cc", "*.cpp", "*.cxx", "*.cu", "*.h", "*.hh",
        "*.hpp", "*.hxx", "*.h++", "*.cuh", "*.inl", "*.ipp", "*.tpp"
      ],
      "command": ["/bin/bash", "tools/build.sh", "--offline"],
      "timeout": 480
    },
    {
      "name": "maintenance contract",
      "kind": "test",
      "paths": [".agents/*", ".githooks/*", "tests/*"],
      "command": [
        "{python}", "-IB", "-m", "pytest", "-q", "-p", "no:cacheprovider",
        "tests/test_gate_contract.py", "tests/test_gate_regressions.py",
        "--junitxml=.gate-results/contracts.xml"
      ],
      "report": ".gate-results/contracts.xml",
      "timeout": 90
    },
    {
      "name": "offline benchmark fixture",
      "kind": "test",
      "paths": ["benchmarks/vllm/*", "tests/test_vllm_fixture.py"],
      "command": [
        "{python}", "-IB", "-m", "pytest", "-q", "-p", "no:cacheprovider",
        "tests/test_vllm_fixture.py", "--junitxml=.gate-results/benchmark.xml"
      ],
      "report": ".gate-results/benchmark.xml",
      "timeout": 90
    }
  ],
  "shared_paths": ["tests/conftest.py"]
}
