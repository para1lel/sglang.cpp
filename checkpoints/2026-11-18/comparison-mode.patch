+def load_reference(path, manifest, cases, gpu_uuid):
+    raw = path.read_bytes()
+    previous = json.loads(raw)
+    digest = hashlib.sha256(raw).hexdigest()
+    frozen = previous["manifest"]
+    if frozen["client_sha256"] not in FROZEN_CLIENTS | {manifest["client_sha256"]}:
+        raise ValueError("Unknown baseline client SHA-256")
+    if (frozen["clock"] != manifest["clock"] or frozen["workload_order"] != list(SHAPES)
+            or frozen["schedule"] != [list(phase) for phase in SCHEDULE]):
+        raise ValueError("Reference does not use the frozen W1/W2 measurement protocol")
+    for name in cases:
+        for field in ("fixture_sha256", "request_sha256"):
+            if manifest[field][name] != frozen[field][name]:
+                raise ValueError(f"{name} differs from baseline {field}")
+        baseline = previous["workloads"][name]
+        if not baseline["valid"] or "thresholds" not in baseline:
+            raise ValueError(f"{name} reference requires a successful baseline")
+        ids = baseline["greedy_output_ids"]
+        if not token_ids(ids) or len(ids) != SHAPES[name][1]:
+            raise ValueError(f"{name} reference requires the complete baseline output IDs")
+    if gpu_uuid is not None:
+        archive = previous.get("archive")
+        if archive is None:
+            published = Path(__file__).with_name("gpu3-reference.json")
+            archive = json.loads(published.read_bytes())["archive"]
+            if digest != archive["measurement_summary_sha256"]:
+                raise ValueError("Reference lacks a GPU UUID or a matching published archive")
+        if gpu_uuid != archive["gpu"]["uuid"]:
+            raise ValueError("Candidate GPU UUID differs from the frozen baseline")
+    return previous["workloads"], digest
+
+
+def output_diagnostic(candidate_ids, baseline_ids):
+    if candidate_ids is None:
+        return None
+    differences = [
+        index for index, (candidate, baseline) in enumerate(zip(candidate_ids, baseline_ids))
+        if candidate != baseline
+    ]
+    return {
+        "different_positions": len(differences),
+        "first_different_index": differences[0] if differences else None,
+    }
+
