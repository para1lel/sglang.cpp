diff --git a/apps/server/batch_service.cpp b/apps/server/batch_service.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1587a80190601e19545c57f12170daab7c5e5ca0
--- /dev/null
+++ b/apps/server/batch_service.cpp
@@ -0,0 +1,248 @@
+#include "sglang/server/batch_service.h"
+
+#include "sglang/decoder_batch.h"
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <exception>
+#include <iostream>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+
+namespace sglang::server {
+namespace {
+
+struct Job {
+    std::vector<int> prompt;
+    DecoderOptions options;
+    std::optional<int> token;
+    std::optional<DecoderFinishReason> finish;
+    std::exception_ptr error;
+    bool admitted = false;
+    bool cancelled = false;
+
+    bool ready() const { return cancelled || !token; }
+};
+
+using Jobs = std::array<std::shared_ptr<Job>, decoder_batch_max_lanes>;
+using Selection = std::array<bool, decoder_batch_max_lanes>;
+constexpr auto disconnect_poll = std::chrono::milliseconds(10);
+constexpr auto mailbox_grace = std::chrono::milliseconds(1);
+
+}
+
+struct BatchService::State {
+    State(const Decoder& decoder, bool trace) : batch(decoder), trace(trace) {
+        worker = std::thread([this] { run(); });
+    }
+
+    ~State() {
+        {
+            const std::lock_guard lock(mutex);
+            closing = true;
+        }
+        changed.notify_all();
+        worker.join();
+    }
+
+    void run();
+    bool prepare(int slot, const std::shared_ptr<Job>& job);
+    void publish_locked(int slot, Job& job, DecoderBatchStep step);
+    void trace_step(const Selection& selected,
+                    const std::array<DecoderBatchStep, decoder_batch_max_lanes>& steps);
+    void cancel(std::unique_lock<std::mutex>& lock, int slot, Job& job);
+
+    DecoderBatch batch;
+    bool trace;
+    std::size_t traced_bytes = 0;
+    std::mutex mutex;
+    std::condition_variable changed;
+    Jobs jobs;
+    std::exception_ptr failure;
+    bool closing = false;
+    std::thread worker;
+};
+
+bool BatchService::State::prepare(int slot, const std::shared_ptr<Job>& job) {
+    bool cancelled = false;
+    {
+        const std::lock_guard lock(mutex);
+        if (!job || !job->ready()) {
+            return false;
+        }
+        cancelled = job->cancelled;
+    }
+    if (cancelled) {
+        if (job->admitted) {
+            batch.cancel(slot);
+        }
+        const std::lock_guard lock(mutex);
+        publish_locked(slot, *job, {std::nullopt, DecoderFinishReason::cancelled});
+        changed.notify_all();
+        return false;
+    }
+    if (!job->admitted) {
+        try {
+            batch.admit(slot, std::move(job->prompt), job->options);
+            job->admitted = true;
+        } catch (const std::invalid_argument&) {
+            const std::lock_guard lock(mutex);
+            job->error = std::current_exception();
+            jobs[slot].reset();
+            changed.notify_all();
+            return false;
+        }
+    }
+    return true;
+}
+
+void BatchService::State::publish_locked(int slot, Job& job, DecoderBatchStep step) {
+    if (step.token && !job.cancelled) {
+        job.token = step.token;
+    }
+    if (step.finish_reason) {
+        job.finish = step.finish_reason;
+        jobs[slot].reset();
+    }
+}
+
+void BatchService::State::trace_step(
+    const Selection& selected, const std::array<DecoderBatchStep, decoder_batch_max_lanes>& steps) {
+    if (!trace) {
+        return;
+    }
+    const auto bytes = batch.request_device_allocation_bytes();
+    const auto decode = std::count_if(steps.begin(), steps.end(),
+                                      [](const DecoderBatchStep& step) { return step.decode; });
+    const auto width = std::count(selected.begin(), selected.end(), true);
+    if (width || bytes != traced_bytes) {
+        std::cerr << "batch width=" << width << " decode=" << decode
+                  << " request_bytes=" << bytes << '\n';
+        traced_bytes = bytes;
+    }
+}
+
+void BatchService::State::run() {
+    try {
+        for (;;) {
+            Jobs snapshot;
+            {
+                std::unique_lock lock(mutex);
+                changed.wait(lock, [&] {
+                    return closing || std::any_of(jobs.begin(), jobs.end(),
+                                                  [](const auto& job) {
+                                                      return job && job->ready();
+                                                  });
+                });
+                changed.wait_for(lock, mailbox_grace, [&] {
+                    return closing || std::all_of(jobs.begin(), jobs.end(), [](const auto& job) {
+                        return !job || job->ready();
+                    });
+                });
+                if (closing) {
+                    return;
+                }
+                snapshot = jobs;
+            }
+            Selection selected{};
+            for (int slot = 0; slot < decoder_batch_max_lanes; ++slot) {
+                selected[slot] = prepare(slot, snapshot[slot]);
+            }
+            const auto steps = batch.advance(selected);
+            trace_step(selected, steps);
+            {
+                const std::lock_guard lock(mutex);
+                for (int slot = 0; slot < decoder_batch_max_lanes; ++slot) {
+                    if (selected[slot] && (steps[slot].token || steps[slot].finish_reason)) {
+                        publish_locked(slot, *snapshot[slot], steps[slot]);
+                    }
+                }
+            }
+            changed.notify_all();
+        }
+    } catch (...) {
+        const std::lock_guard lock(mutex);
+        failure = std::current_exception();
+        for (auto& job : jobs) {
+            if (job) {
+                job->error = failure;
+                job.reset();
+            }
+        }
+        changed.notify_all();
+    }
+}
+
+void BatchService::State::cancel(std::unique_lock<std::mutex>& lock, int slot, Job& job) {
+    job.cancelled = true;
+    changed.notify_all();
+    changed.wait(lock, [&] { return jobs[slot].get() != &job; });
+}
+
+BatchService::BatchService(const Decoder& decoder, bool trace)
+    : state_(std::make_unique<State>(decoder, trace)) {}
+
+BatchService::~BatchService() = default;
+
+DecoderResult BatchService::generate(int slot, const std::vector<int>& prompt,
+                                     const DecoderOptions& options,
+                                     const DecoderCallbacks& callbacks) {
+    auto job = std::make_shared<Job>();
+    job->prompt = prompt;
+    job->options = options;
+    DecoderResult result;
+    std::unique_lock lock(state_->mutex);
+    if (state_->failure) {
+        std::rethrow_exception(state_->failure);
+    }
+    auto& queue = state_->jobs.at(slot);
+    if (queue) {
+        throw std::logic_error("Connection already has an active decoder job");
+    }
+    queue = job;
+    state_->changed.notify_all();
+    try {
+        for (;;) {
+            lock.unlock();
+            const bool disconnected = callbacks.is_cancelled && callbacks.is_cancelled();
+            lock.lock();
+            if (disconnected) {
+                state_->cancel(lock, slot, *job);
+                result.finish_reason = DecoderFinishReason::cancelled;
+                return result;
+            }
+            if (job->error) {
+                std::rethrow_exception(job->error);
+            }
+            if (job->token) {
+                const int token = *std::exchange(job->token, std::nullopt);
+                state_->changed.notify_all();
+                lock.unlock();
+                result.output_token_ids.push_back(token);
+                const bool accepted = !callbacks.on_token || callbacks.on_token(token);
+                lock.lock();
+                if (!accepted) {
+                    state_->cancel(lock, slot, *job);
+                    result.finish_reason = DecoderFinishReason::cancelled;
+                    return result;
+                }
+            } else if (job->finish) {
+                result.finish_reason = *job->finish;
+                return result;
+            } else {
+                state_->changed.wait_for(lock, disconnect_poll);
+            }
+        }
+    } catch (...) {
+        if (!lock.owns_lock()) {
+            lock.lock();
+        }
+        state_->cancel(lock, slot, *job);
+        throw;
+    }
+}
+
+}
