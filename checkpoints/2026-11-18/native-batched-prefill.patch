+#pragma once
+
+#include "sglang/text_ops.h"
+
+namespace sglang {
+
+/// All arrays are contiguous and reside on the stream's device. Calls enqueue
+/// work asynchronously. The caller keeps disjoint buffers alive through work
+/// completion. Dimensions are positive and the inputs are finite.
+
+/// Quantizes BF16 [rows, width] to E4M3 [rows, width] and FP32 scales
+/// [rows, text_fp8_group_count(width)] using the vector quantizer's policy.
+cudaError_t text_quantize_fp8_batch(const __nv_bfloat16* input, int rows, int width,
+                                   TextFp8Activation output, cudaStream_t stream);
+
+/// Multiplies a shared quantized activation [rows, in_width] by checkpoint
+/// weights [out_width, in_width]. Weight scales are BF16 multipliers in
+/// [ceil(out_width / 128), ceil(in_width / 128)] order. Accumulates each input
+/// group separately in FP32, applies its scales and rounds the final output
+/// [rows, out_width] once to BF16.
+cudaError_t text_fp8_gemm(const std::uint8_t* weight, const __nv_bfloat16* weight_scales,
+                         TextFp8ActivationView input, int rows, int out_width,
+                         int in_width, __nv_bfloat16* output, cudaStream_t stream);
+
+/// Multiplies BF16 input [rows, in_width] by BF16 weights
+/// [out_width, in_width], accumulating in FP32 and writing BF16 [rows, out_width].
+cudaError_t text_bf16_gemm(const __nv_bfloat16* weight, const __nv_bfloat16* input,
+                          int rows, int out_width, int in_width, __nv_bfloat16* output,
+                          cudaStream_t stream);
+
+}
