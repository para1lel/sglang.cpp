+#include "sglang/text_prefill_ops.h"
+
+#include <cstddef>
+
+#include <cuda.h>
+#include <cuda_runtime.h>
+#include <cudaTypedefs.h>
+
+namespace sglang {
+namespace {
+
+constexpr int tile_rows = 128;
+constexpr int group_size = text_fp8_group_size;
+constexpr int copy_stages = 4;
+constexpr int accum_stages = 2;
+constexpr int warp_size = 32;
+constexpr int consumer_warps = tile_rows / warp_size;
+constexpr int thread_count = (consumer_warps + 2) * warp_size;
+
+struct Pipeline {
+    unsigned long long copy_ready[copy_stages];
+    unsigned long long copy_empty[copy_stages];
+    unsigned long long accum_ready[accum_stages];
+    unsigned long long accum_empty[accum_stages];
+    unsigned tmem;
+};
+
+__device__ unsigned shared_address(const void* pointer) {
+    return static_cast<unsigned>(__cvta_generic_to_shared(pointer));
+}
+
+__device__ void init_barrier(unsigned long long* barrier, int arrivals) {
+    asm volatile("mbarrier.init.shared::cta.b64 [%0], %1;"
+                 :: "r"(shared_address(barrier)), "r"(arrivals) : "memory");
+}
+
+__device__ void wait_barrier(const unsigned long long* barrier, unsigned phase) {
+    asm volatile("{ .reg .pred ready;\n"
+                 "WAIT: mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 ready, [%0], %1;\n"
+                 "@!ready bra.uni WAIT; }"
+                 :: "r"(shared_address(barrier)), "r"(phase) : "memory");
+}
+
+__device__ void arrive_barrier(unsigned long long* barrier) {
+    asm volatile("mbarrier.arrive.release.cta.shared::cta.b64 _, [%0];"
+                 :: "r"(shared_address(barrier)) : "memory");
+}
+
+__device__ void commit_mma(unsigned long long* barrier) {
+    asm volatile("tcgen05.commit.cta_group::1.mbarrier::arrive::one.b64 [%0];"
+                 :: "r"(shared_address(barrier)) : "memory");
+}
+
+__device__ void copy_tile(const CUtensorMap* map, unsigned shared, unsigned barrier,
+                          int col, int row) {
+    asm volatile("cp.async.bulk.tensor.2d.shared::cta.global.mbarrier::complete_tx::bytes "
+                 "[%0], [%1, {%2, %3}], [%4];"
+                 :: "r"(shared), "l"(map), "r"(col), "r"(row), "r"(barrier) : "memory");
+}
+
+template <int TileCols>
+__device__ void produce_tiles(Pipeline& pipe, unsigned shared, const CUtensorMap* input,
+                              const CUtensorMap* weight, int row_base, int col_base, int groups) {
+    constexpr int stage_bytes = (tile_rows + TileCols) * group_size;
+    for (int group = 0; group < groups; ++group) {
+        const int slot = group % copy_stages;
+        if (group >= copy_stages) {
+            wait_barrier(&pipe.copy_empty[slot], (group / copy_stages - 1) % 2);
+        }
+        const unsigned barrier = shared_address(&pipe.copy_ready[slot]);
+        asm volatile("mbarrier.arrive.expect_tx.release.cta.shared::cta.b64 _, [%0], %1;"
+                     :: "r"(barrier), "r"(stage_bytes) : "memory");
+        const unsigned start = shared + slot * stage_bytes;
+        copy_tile(input, start, barrier, group * group_size, row_base);
+        copy_tile(weight, start + tile_rows * group_size, barrier, group * group_size, col_base);
+    }
+}
+
+__device__ std::uint64_t matrix_desc(unsigned start) {
+    constexpr std::uint64_t stride = 8 * group_size / 16;
+    constexpr std::uint64_t swizzle_128b = std::uint64_t{2} << 61;
+    constexpr std::uint64_t descriptor_version = std::uint64_t{1} << 46;
+    constexpr std::uint64_t leading_offset = std::uint64_t{1} << 16;
+    return swizzle_128b | descriptor_version | (stride << 32) | leading_offset |
+           ((start & 0x3ffffu) >> 4);
+}
+
+template <int TileCols>
+__device__ void multiply_tiles(Pipeline& pipe, unsigned shared, int groups) {
+    constexpr int stage_bytes = (tile_rows + TileCols) * group_size;
+    constexpr unsigned accumulator_f32 = 1 << 4;
+    constexpr unsigned instruction = ((tile_rows / 16) << 24) | ((TileCols / 8) << 17) |
+                                     accumulator_f32;
+    for (int group = 0; group < groups; ++group) {
+        const int stage = group % copy_stages;
+        const int accum = group % accum_stages;
+        if (group >= accum_stages) {
+            wait_barrier(&pipe.accum_empty[accum], (group / accum_stages - 1) % 2);
+        }
+        wait_barrier(&pipe.copy_ready[stage], (group / copy_stages) % 2);
+        asm volatile("tcgen05.fence::after_thread_sync;" ::: "memory");
+        const unsigned start = shared + stage * stage_bytes;
+        #pragma unroll
+        for (int chunk = 0; chunk < group_size; chunk += 32) {
+            const auto input_desc = matrix_desc(start + chunk);
+            const auto weight_desc = matrix_desc(start + tile_rows * group_size + chunk);
+            asm volatile("{ .reg .pred accumulate;\n"
+                         "setp.ne.u32 accumulate, %4, 0;\n"
+                         "tcgen05.mma.cta_group::1.kind::f8f6f4 [%0], %1, %2, %3, accumulate; }"
+                         :: "r"(pipe.tmem + accum * TileCols), "l"(input_desc), "l"(weight_desc),
+                            "r"(instruction), "r"(chunk) : "memory");
+        }
+        commit_mma(&pipe.copy_empty[stage]);
+        commit_mma(&pipe.accum_ready[accum]);
+    }
+}
+
+__device__ void load_partial(unsigned source, float (&value)[32]) {
+    asm volatile("{ .reg .b32 v<32>;\n"
+                 "tcgen05.ld.sync.aligned.32x32b.x32.b32 "
+                 "{v0,v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12,v13,v14,v15,"
+                 "v16,v17,v18,v19,v20,v21,v22,v23,v24,v25,v26,v27,v28,v29,v30,v31}, [%32];\n"
+                 "tcgen05.wait::ld.sync.aligned;\n"
+                 "mov.b32 %0,v0; mov.b32 %1,v1; mov.b32 %2,v2; mov.b32 %3,v3;\n"
+                 "mov.b32 %4,v4; mov.b32 %5,v5; mov.b32 %6,v6; mov.b32 %7,v7;\n"
+                 "mov.b32 %8,v8; mov.b32 %9,v9; mov.b32 %10,v10; mov.b32 %11,v11;\n"
+                 "mov.b32 %12,v12; mov.b32 %13,v13; mov.b32 %14,v14; mov.b32 %15,v15;\n"
+                 "mov.b32 %16,v16; mov.b32 %17,v17; mov.b32 %18,v18; mov.b32 %19,v19;\n"
+                 "mov.b32 %20,v20; mov.b32 %21,v21; mov.b32 %22,v22; mov.b32 %23,v23;\n"
+                 "mov.b32 %24,v24; mov.b32 %25,v25; mov.b32 %26,v26; mov.b32 %27,v27;\n"
+                 "mov.b32 %28,v28; mov.b32 %29,v29; mov.b32 %30,v30; mov.b32 %31,v31; }"
+                 : "=f"(value[0]), "=f"(value[1]), "=f"(value[2]), "=f"(value[3]),
+                   "=f"(value[4]), "=f"(value[5]), "=f"(value[6]), "=f"(value[7]),
+                   "=f"(value[8]), "=f"(value[9]), "=f"(value[10]), "=f"(value[11]),
+                   "=f"(value[12]), "=f"(value[13]), "=f"(value[14]), "=f"(value[15]),
+                   "=f"(value[16]), "=f"(value[17]), "=f"(value[18]), "=f"(value[19]),
+                   "=f"(value[20]), "=f"(value[21]), "=f"(value[22]), "=f"(value[23]),
+                   "=f"(value[24]), "=f"(value[25]), "=f"(value[26]), "=f"(value[27]),
+                   "=f"(value[28]), "=f"(value[29]), "=f"(value[30]), "=f"(value[31])
+                 : "r"(source) : "memory");
+}
+
+__device__ void scale_pair(float& result0, float& result1, float value0, float value1,
+                           float activation, float weight) {
+    asm("{ .reg .b64 values, ascales, wscales, sums;\n"
+                 "mov.b64 values, {%2,%3};\n"
+                 "mov.b64 ascales, {%4,%4};\n"
+                 "mov.b64 wscales, {%5,%5};\n"
+                 "mov.b64 sums, {%0,%1};\n"
+                 "mul.rn.f32x2 wscales, wscales, ascales;\n"
+                 "fma.rn.f32x2 sums, values, wscales, sums;\n"
+                 "mov.b64 {%0,%1}, sums; }"
+                 : "+f"(result0), "+f"(result1)
+                 : "f"(value0), "f"(value1), "f"(activation), "f"(weight));
+}
+
+template <int TileCols>
+__device__ void accumulate(Pipeline& pipe, const float* activation, const __nv_bfloat16* weight,
+                           int groups, float (&result)[TileCols]) {
+    const int warp = threadIdx.x / warp_size;
+    const int lane = threadIdx.x % warp_size;
+    const unsigned tmem = pipe.tmem + (warp * warp_size << 16);
+    for (int group = 0; group < groups; ++group) {
+        const int slot = group % accum_stages;
+        const float activation_scale = activation ? activation[group] : 0.0f;
+        const float weight_scale = __bfloat162float(weight[group]);
+        wait_barrier(&pipe.accum_ready[slot], (group / accum_stages) % 2);
+        asm volatile("tcgen05.fence::after_thread_sync;" ::: "memory");
+        #pragma unroll
+        for (int col = 0; col < TileCols; col += 32) {
+            float partial[32];
+            load_partial(tmem + slot * TileCols + col, partial);
+            #pragma unroll
+            for (int elem = 0; elem < 32; elem += 2) {
+                scale_pair(result[col + elem], result[col + elem + 1],
+                           partial[elem], partial[elem + 1], activation_scale, weight_scale);
+            }
+        }
+        asm volatile("tcgen05.fence::before_thread_sync;" ::: "memory");
+        __syncwarp();
+        if (lane == 0) {
+            arrive_barrier(&pipe.accum_empty[slot]);
+        }
+    }
+}
+
+template <int TileCols>
+__global__ __launch_bounds__(thread_count, 2)
+void fp8_tma(const __grid_constant__ CUtensorMap activation_map,
+              const __grid_constant__ CUtensorMap weight_map, const float* activation_scales,
+              const __nv_bfloat16* weight_scales, int rows, int cols, int groups,
+              int row_tile_group, __nv_bfloat16* output) {
+    alignas(1024) extern __shared__ unsigned char tiles[];
+    __shared__ Pipeline pipe;
+    auto* epilogue = reinterpret_cast<__nv_bfloat16 (*)[TileCols + 2]>(tiles);
+    const int warp = threadIdx.x / warp_size;
+    const int lane = threadIdx.x % warp_size;
+    const int row_base = (blockIdx.y * row_tile_group + blockIdx.x % row_tile_group) * tile_rows;
+    const int col_base = (blockIdx.x / row_tile_group) * TileCols;
+    if (row_base >= rows) {
+        return;
+    }
+    const unsigned shared = shared_address(tiles);
+    if (threadIdx.x == 0) {
+        for (int slot = 0; slot < copy_stages; ++slot) {
+            init_barrier(&pipe.copy_ready[slot], 1);
+            init_barrier(&pipe.copy_empty[slot], 1);
+        }
+        for (int slot = 0; slot < accum_stages; ++slot) {
+            init_barrier(&pipe.accum_ready[slot], 1);
+            init_barrier(&pipe.accum_empty[slot], consumer_warps);
+        }
+        asm volatile("fence.mbarrier_init.release.cluster;" ::: "memory");
+    }
+    if (warp == consumer_warps) {
+        asm volatile("tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%0], %1;"
+                     :: "r"(shared_address(&pipe.tmem)), "r"(accum_stages * TileCols) : "memory");
+        asm volatile("tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;" ::: "memory");
+    }
+    __syncthreads();
+
+    float result[TileCols] = {};
+    if (warp < consumer_warps) {
+        const int row = row_base + threadIdx.x;
+        const auto* activation = row < rows ? activation_scales + std::size_t(row) * groups
+                                            : nullptr;
+        const auto* weight = weight_scales + std::size_t(col_base / group_size) * groups;
+        accumulate(pipe, activation, weight, groups, result);
+    } else if (warp == consumer_warps && lane == 0) {
+        multiply_tiles<TileCols>(pipe, shared, groups);
+    } else if (warp == consumer_warps + 1 && lane == 0) {
+        produce_tiles<TileCols>(pipe, shared, &activation_map, &weight_map, row_base, col_base,
+                                groups);
+    }
+    __syncthreads();
+
+    if (warp < consumer_warps) {
+        #pragma unroll
+        for (int col = 0; col < TileCols; col += 2) {
+            const auto packed = __floats2bfloat162_rn(result[col], result[col + 1]);
+            *reinterpret_cast<__nv_bfloat162*>(&epilogue[threadIdx.x][col]) = packed;
+        }
+    }
+    if (warp == consumer_warps) {
+        asm volatile("tcgen05.dealloc.cta_group::1.sync.aligned.b32 %0, %1;"
+                     :: "r"(pipe.tmem), "r"(accum_stages * TileCols) : "memory");
+    }
+    __syncthreads();
+    for (int index = threadIdx.x; index < tile_rows * TileCols; index += thread_count) {
+        const int row = index / TileCols;
+        const int col = index % TileCols;
+        if (row_base + row < rows && col_base + col < cols) {
+            output[std::size_t(row_base + row) * cols + col_base + col] = epilogue[row][col];
+        }
+    }
+}
+
+CUresult encode_map(PFN_cuTensorMapEncodeTiled_v12000 encode, CUtensorMap& map,
+                    const std::uint8_t* data, int rows, int width, int tile) {
+    const cuuint64_t dimensions[] = {static_cast<cuuint64_t>(width), static_cast<cuuint64_t>(rows)};
+    const cuuint64_t stride[] = {static_cast<cuuint64_t>(width)};
+    const cuuint32_t box[] = {group_size, static_cast<cuuint32_t>(tile)};
+    const cuuint32_t element_stride[] = {1, 1};
+    return encode(&map, CU_TENSOR_MAP_DATA_TYPE_UINT8, 2, const_cast<std::uint8_t*>(data),
+                  dimensions, stride, box, element_stride, CU_TENSOR_MAP_INTERLEAVE_NONE,
+                  CU_TENSOR_MAP_SWIZZLE_128B, CU_TENSOR_MAP_L2_PROMOTION_NONE,
+                  CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+}
+
+PFN_cuTensorMapEncodeTiled_v12000 tensor_map_encoder() {
+    static const auto encode = [] {
+        void* entry = nullptr;
+        cudaDriverEntryPointQueryResult result;
+        const auto status = cudaGetDriverEntryPointByVersion("cuTensorMapEncodeTiled", &entry,
+                                                           12000, cudaEnableDefault, &result);
+        return status == cudaSuccess && result == cudaDriverEntryPointSuccess
+            ? reinterpret_cast<PFN_cuTensorMapEncodeTiled_v12000>(entry) : nullptr;
+    }();
+    return encode;
+}
+
+template <int TileCols>
+cudaError_t launch_tma(PFN_cuTensorMapEncodeTiled_v12000 encode, const std::uint8_t* weight,
+                       const __nv_bfloat16* weight_scales, TextFp8ActivationView input,
+                       int rows, int out_width, int in_width, __nv_bfloat16* output,
+                       cudaStream_t stream, int row_tile_group) {
+    constexpr int shared_bytes = copy_stages * (tile_rows + TileCols) * group_size;
+    CUtensorMap activation_map, weight_map;
+    if (encode_map(encode, activation_map, input.values, rows, in_width, tile_rows) !=
+            CUDA_SUCCESS ||
+        encode_map(encode, weight_map, weight, out_width, in_width, TileCols) != CUDA_SUCCESS) {
+        return cudaErrorNotSupported;
+    }
+    const auto kernel = fp8_tma<TileCols>;
+    const auto status = cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize,
+                                            shared_bytes);
+    if (status != cudaSuccess) {
+        return status;
+    }
+    int groups = in_width / group_size;
+    void* args[] = {&activation_map, &weight_map, &input.scales, &weight_scales,
+                    &rows, &out_width, &groups, &row_tile_group, &output};
+    const dim3 grid((1 + (out_width - 1) / TileCols) * row_tile_group,
+                    1 + (rows - 1) / (tile_rows * row_tile_group));
+    return cudaLaunchKernel(kernel, grid, thread_count, args, shared_bytes, stream);
+}
+
+}
+
+cudaError_t text_fp8_gemm_sm100(const std::uint8_t* weight, const __nv_bfloat16* weight_scales,
+                               TextFp8ActivationView input, int rows, int out_width, int in_width,
+                               __nv_bfloat16* output, cudaStream_t stream) {
+    if (in_width % group_size != 0 || reinterpret_cast<std::uintptr_t>(weight) % 16 != 0 ||
+        reinterpret_cast<std::uintptr_t>(input.values) % 16 != 0 ||
+        (rows - 1) / tile_rows >= 65535) {
+        return cudaErrorNotSupported;
+    }
+    const auto encode = tensor_map_encoder();
+    if (!encode) {
+        return cudaErrorNotSupported;
+    }
+    if (rows <= tile_rows && out_width <= 8192) {
+        return launch_tma<32>(encode, weight, weight_scales, input, rows, out_width,
+                              in_width, output, stream, 1);
+    }
+    const int row_tile_group = rows >= 2048 ? 16 : rows >= 512 ? 4 : 1;
+    return launch_tma<64>(encode, weight, weight_scales, input, rows, out_width,
+                          in_width, output, stream, row_tile_group);
+}
+
+}
