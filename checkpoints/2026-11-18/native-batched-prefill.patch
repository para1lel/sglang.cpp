diff --git a/src/decoder_batch_ops.cu b/src/decoder_batch_ops.cu
new file mode 100644
index 0000000..e5584bb
--- /dev/null
+++ b/src/decoder_batch_ops.cu
@@ -0,0 +1,94 @@
+#include "sglang/decoder_internal.h"
+
+#include <cuda_runtime.h>
+
+namespace sglang::decoder {
+namespace {
+
+constexpr int warp_size = 32;
+constexpr int block_threads = 256;
+constexpr int block_warps = block_threads / warp_size;
+constexpr float rms_epsilon = 1.0e-6f;
+
+static_assert(hidden_size % block_threads == 0);
+
+__global__ void gather_embeddings(const Bf16* embedding, const int* tokens, Bf16* output) {
+    const auto* source = embedding + static_cast<std::size_t>(tokens[blockIdx.y]) * hidden_size;
+    const int column = blockIdx.x * block_threads + threadIdx.x;
+    output[blockIdx.y * hidden_size + column] = source[column];
+}
+
+__device__ float warp_sum(float value) {
+    for (int offset = warp_size / 2; offset > 0; offset /= 2) {
+        value += __shfl_down_sync(0xffffffffu, value, offset);
+    }
+    return value;
+}
+
+__device__ float residual_sum(const Bf16* branch, const Bf16* residual, int column) {
+    const float value = __bfloat162float(branch[column]);
+    return residual ? value + __bfloat162float(residual[column]) : value;
+}
+
+__global__ void normalize_rows(const Bf16* branch, Bf16* residual, const Bf16* weight,
+                               Bf16* output) {
+    __shared__ float warp_squares[block_warps];
+    __shared__ float inverse_rms;
+    const int row_offset = blockIdx.x * hidden_size;
+    branch += row_offset;
+    output += row_offset;
+    if (residual) {
+        residual += row_offset;
+    }
+    const int lane = threadIdx.x % warp_size;
+    const int warp = threadIdx.x / warp_size;
+    float squares = 0.0f;
+    for (int column = threadIdx.x; column < hidden_size; column += block_threads) {
+        const float value = residual_sum(branch, residual, column);
+        squares = fmaf(value, value, squares);
+    }
+    squares = warp_sum(squares);
+    if (lane == 0) {
+        warp_squares[warp] = squares;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        squares = warp_sum(lane < block_warps ? warp_squares[lane] : 0.0f);
+        if (lane == 0) {
+            inverse_rms = rsqrtf(squares / static_cast<float>(hidden_size) + rms_epsilon);
+        }
+    }
+    __syncthreads();
+    for (int column = threadIdx.x; column < hidden_size; column += block_threads) {
+        const float value = residual_sum(branch, residual, column);
+        const float gain = 1.0f + __bfloat162float(weight[column]);
+        if (residual) {
+            residual[column] = __float2bfloat16_rn(value);
+        }
+        output[column] = __float2bfloat16_rn((value * inverse_rms) * gain);
+    }
+}
+
+}
+
+cudaError_t embed_prefill(const Bf16* embedding, const int* tokens, int rows,
+                          Bf16* output, cudaStream_t stream) {
+    if (!embedding || !tokens || !output || rows < 1 || rows > prefill_chunk_rows) {
+        return cudaErrorInvalidValue;
+    }
+    void* arguments[] = {&embedding, &tokens, &output};
+    return cudaLaunchKernel(gather_embeddings, dim3(hidden_size / block_threads, rows),
+                            block_threads, arguments, 0, stream);
+}
+
+cudaError_t normalize_prefill(const Bf16* branch, Bf16* residual, const Bf16* weight,
+                               int rows, Bf16* output, cudaStream_t stream) {
+    if (!branch || !weight || !output || output == residual
+        || rows < 1 || rows > prefill_chunk_rows) {
+        return cudaErrorInvalidValue;
+    }
+    void* arguments[] = {&branch, &residual, &weight, &output};
+    return cudaLaunchKernel(normalize_rows, rows, block_threads, arguments, 0, stream);
+}
+
+}
diff --git a/src/decoder_prefill.cpp b/src/decoder_prefill.cpp
new file mode 100644
index 0000000..e2665f5
--- /dev/null
+++ b/src/decoder_prefill.cpp
@@ -0,0 +1,158 @@
+#include "sglang/decoder_internal.h"
+#include "sglang/text_prefill_ops.h"
+
+#include <algorithm>
+
+namespace sglang {
+namespace {
+
+using namespace decoder;
+
+TextFp8ActivationView quantize_rows(const Bf16* input, int rows, int width,
+                                    TextFp8Activation scratch, cudaStream_t stream) {
+    check(text_quantize_fp8_batch(input, rows, width, scratch, stream),
+          "Quantize prefill projections");
+    return {scratch.values, scratch.scales};
+}
+
+void project_rows(Fp8Weight weight, TextFp8ActivationView input, int rows,
+                  Bf16* output, cudaStream_t stream) {
+    check(text_fp8_gemm(weight.values, weight.scales, input, rows, weight.rows,
+                        weight.columns, output, stream), "Run prefill FP8 projection");
+}
+
+void project_rows(Bf16Weight weight, const Bf16* input, int rows,
+                  Bf16* output, cudaStream_t stream) {
+    check(text_bf16_gemm(weight.values, input, rows, weight.rows, weight.columns, output, stream),
+          "Run prefill BF16 projection");
+}
+
+void prefill_gdn(const GdnLayer& layer, Request& request, TextGdnState state, int rows) {
+    auto& work = *request.prefill_work;
+    const auto stream = request.memory.stream();
+    const auto input = quantize_rows(work.normalized, rows, hidden_size, work.activation, stream);
+    project_rows(layer.qkv, input, rows, work.gdn_qkv, stream);
+    project_rows(layer.z, input, rows, work.gdn_z, stream);
+    project_rows(layer.b, work.normalized, rows, work.gdn_b, stream);
+    project_rows(layer.a, work.normalized, rows, work.gdn_a, stream);
+    check(text_gdn_forward(rows, TextGdnMode::prefill, work.gdn_qkv, work.gdn_z, work.gdn_b,
+                           work.gdn_a, layer.recurrent, state, work.gdn_scratch,
+                           text_gdn_workspace_bytes(work.row_capacity), work.attention, stream),
+          "Advance prefill Gated DeltaNet state");
+    const auto attention =
+        quantize_rows(work.attention, rows, text_gdn_value_width, work.activation, stream);
+    project_rows(layer.output, attention, rows, work.projected_attention, stream);
+}
+
+void prefill_gqa(const GqaLayer& layer, Request& request, Mxfp8KvCache cache,
+                 int first_position, int rows) {
+    auto& work = *request.prefill_work;
+    const auto stream = request.memory.stream();
+    const auto input = quantize_rows(work.normalized, rows, hidden_size, work.activation, stream);
+    project_rows(layer.q_gate, input, rows, work.q_gate, stream);
+    project_rows(layer.key, input, rows, work.keys, stream);
+    project_rows(layer.value, input, rows, work.values, stream);
+    check(text_gqa_preprocess(first_position, rows, work.q_gate, work.keys,
+                              layer.query_norm, layer.key_norm, work.rope_queries, work.rope_keys,
+                              stream), "Normalize and rotate prefill Q/K");
+    check(mxfp8_kv_append(cache, request.pages, first_position, rows,
+                          work.rope_keys, work.values, stream), "Append prefill MXFP8 KV");
+    check(mxfp8_gqa_attention(cache, request.pages, first_position + rows, first_position,
+                             rows, work.rope_queries, work.attention, stream),
+          "Read causal prefill MXFP8 attention");
+    check(text_gqa_postgate(rows, work.q_gate, work.attention, work.attention, stream),
+          "Gate prefill grouped-query attention");
+    const auto attention =
+        quantize_rows(work.attention, rows, text_gqa_q_width, work.activation, stream);
+    project_rows(layer.output, attention, rows, work.projected_attention, stream);
+}
+
+void prefill_mlp(const Layer& layer, PrefillWorkspace& work, int rows, cudaStream_t stream) {
+    const auto input = quantize_rows(work.normalized, rows, hidden_size, work.activation, stream);
+    project_rows(layer.mlp_gate, input, rows, work.mlp_gate, stream);
+    project_rows(layer.mlp_up, input, rows, work.mlp_up, stream);
+    check(text_swiglu(work.mlp_gate, work.mlp_up, rows * intermediate_size, work.mlp_gate, stream),
+          "Apply prefill SwiGLU");
+    const auto activated =
+        quantize_rows(work.mlp_gate, rows, intermediate_size, work.activation, stream);
+    project_rows(layer.mlp_down, activated, rows, work.hidden, stream);
+}
+
+}
+
+void Decoder::Model::prefill_chunk(Request& request, const int* tokens,
+                                   int first_position, int rows) const {
+    if (!request.prefill_work || !tokens || rows < 2 || rows > request.prefill_work->row_capacity
+        || first_position < 0 || first_position > request.prefill_work->prompt_count - rows) {
+        throw std::invalid_argument("Prefill chunk falls outside request capacity");
+    }
+    auto& work = *request.prefill_work;
+    const auto stream = request.memory.stream();
+    check(embed_prefill(embedding, tokens, rows, work.residual, stream),
+          "Gather prefill embeddings");
+    int gdn_index = 0;
+    int gqa_index = 0;
+    for (int index = 0; index < layer_count; ++index) {
+        const auto& layer = layers[index];
+        const auto* input = index == 0 ? work.residual : work.hidden;
+        auto* residual = index == 0 ? nullptr : work.residual;
+        check(normalize_prefill(input, residual, layer.input_norm, rows, work.normalized, stream),
+              "Normalize prefill layer input");
+        if (is_full_attention(index)) {
+            prefill_gqa(layer.gqa, request, request.caches[gqa_index++], first_position, rows);
+        } else {
+            prefill_gdn(layer.gdn, request, request.states[gdn_index++], rows);
+        }
+        check(normalize_prefill(work.projected_attention, work.residual, layer.attention_norm,
+                                rows, work.normalized, stream),
+              "Normalize prefill post-attention residual");
+        prefill_mlp(layer, work, rows, stream);
+    }
+}
+
+bool Decoder::Model::prefill(Request& request, const std::vector<int>& prompt,
+                             const std::function<bool()>& cancelled) const {
+    if (cancelled()) {
+        return false;
+    }
+    if (!request.prefill_work) {
+        for (int position = 0; position < static_cast<int>(prompt.size()); ++position) {
+            if (position != 0 && cancelled()) {
+                return false;
+            }
+            forward(request, prompt[position], position, TextGdnMode::prefill);
+        }
+        return true;
+    }
+    auto& work = *request.prefill_work;
+    auto& host_tokens = request.memory.transfers().prompt_tokens;
+    host_tokens = prompt;
+    const auto stream = request.memory.stream();
+    check(cudaMemcpyAsync(work.tokens, host_tokens.data(), host_tokens.size() * sizeof(int),
+                          cudaMemcpyHostToDevice, stream), "Upload prefill tokens");
+    int final_rows = 0;
+    for (int position = 0; position < work.prompt_count;) {
+        if (position != 0 && cancelled()) {
+            return false;
+        }
+        const int rows = std::min(work.row_capacity, work.prompt_count - position);
+        if (rows == 1) {
+            forward(request, prompt[position], position, TextGdnMode::prefill);
+        } else {
+            prefill_chunk(request, work.tokens + position, position, rows);
+        }
+        final_rows = rows;
+        position += rows;
+    }
+    if (final_rows > 1) {
+        const auto offset = (final_rows - 1) * hidden_size;
+        const auto bytes = hidden_size * sizeof(Bf16);
+        check(cudaMemcpyAsync(request.work.hidden, work.hidden + offset, bytes,
+                              cudaMemcpyDeviceToDevice, stream), "Stage final prefill hidden row");
+        check(cudaMemcpyAsync(request.work.residual, work.residual + offset, bytes,
+                              cudaMemcpyDeviceToDevice, stream), "Stage final prefill residual row");
+    }
+    return true;
+}
+
+}
