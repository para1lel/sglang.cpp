diff --git a/src/text_gdn_chunk.cu b/src/text_gdn_chunk.cu
new file mode 100644
index 0000000..d3108cd
--- /dev/null
+++ b/src/text_gdn_chunk.cu
@@ -0,0 +1,494 @@
+#include "sglang/text_gdn_chunk.h"
+
+#include <cuda_runtime.h>
+#include <mma.h>
+#include <type_traits>
+
+namespace sglang {
+namespace {
+
+namespace wmma = nvcuda::wmma;
+using BF16 = __nv_bfloat16;
+constexpr int rows = 64;
+constexpr int features = text_gdn_head_dim;
+constexpr int warp_size = 32;
+constexpr int warps = 8;
+constexpr int threads = warp_size * warps;
+constexpr int tile = 16;
+constexpr unsigned all_lanes = 0xffffffffu;
+constexpr int heads_per_qk = text_gdn_value_heads / text_gdn_qk_heads;
+constexpr float query_scale = 0.08838834764831845f;
+
+struct alignas(32) Shared {
+    BF16 q[rows][features];
+    BF16 k[rows][features];
+    BF16 inverse[rows][rows];
+    BF16 qk[rows][rows];
+    BF16 state[features][features];
+    BF16 corrected[features][rows];
+    BF16 nv[features][rows];
+    BF16 dv[features][rows];
+    BF16 intermediate[32 * 32];
+    float product[warps][tile * tile];
+    float log_prefix[rows];
+    float prefix[rows];
+    float beta[rows];
+};
+
+struct Convolved {
+    const BF16* qkv;
+    const BF16* b;
+    const BF16* a;
+    const BF16* a_log;
+    const BF16* dt_bias;
+};
+
+__device__ float warp_sum(float value) {
+    for (int offset = warp_size / 2; offset > 0; offset /= 2) {
+        value += __shfl_xor_sync(all_lanes, value, offset);
+    }
+    return value;
+}
+
+__device__ float sigmoid(float value) {
+    return 1.0f / (1.0f + expf(-value));
+}
+
+__device__ float exp2_approx(float value) {
+    float result;
+    asm("ex2.approx.f32 %0, %1;" : "=f"(result) : "f"(value));
+    return result;
+}
+
+template <class RhsLayout, int reduction>
+__device__ void product(const BF16* lhs, int lhs_stride, const BF16* rhs, int rhs_stride,
+                         float* result, bool seed = false) {
+    wmma::fragment<wmma::matrix_a, tile, tile, tile, BF16, wmma::row_major> left;
+    wmma::fragment<wmma::matrix_b, tile, tile, tile, BF16, RhsLayout> right;
+    wmma::fragment<wmma::accumulator, tile, tile, tile, float> sum;
+    if (seed) {
+        __syncwarp();
+        wmma::load_matrix_sync(sum, result, tile, wmma::mem_row_major);
+    } else {
+        wmma::fill_fragment(sum, 0.0f);
+    }
+    #pragma unroll
+    for (int offset = 0; offset < reduction; offset += tile) {
+        wmma::load_matrix_sync(left, lhs + offset, lhs_stride);
+        const int rhs_offset = std::is_same_v<RhsLayout, wmma::row_major>
+                                   ? offset * rhs_stride : offset;
+        wmma::load_matrix_sync(right, rhs + rhs_offset, rhs_stride);
+        wmma::mma_sync(sum, left, right, sum);
+    }
+    wmma::store_matrix_sync(result, sum, tile, wmma::mem_row_major);
+    __syncwarp();
+}
+
+__device__ void prepare(Shared& shared, const TextGdnPrepared& input, int first, int valid,
+                         int head, int qk_head) {
+    for (int index = threadIdx.x; index < rows * features; index += threads) {
+        const int row = index / features;
+        const int key = index % features;
+        const auto base = static_cast<std::size_t>(first + row) * text_gdn_qk_width;
+        const int column = qk_head * features + key;
+        shared.q[row][key] = row < valid ? input.q[base + column] : BF16{};
+        shared.k[row][key] = row < valid ? input.k[base + column] : BF16{};
+    }
+}
+
+__device__ void prepare(Shared& shared, const Convolved& input, int first, int valid,
+                         int, int qk_head) {
+    const int warp = threadIdx.x / warp_size;
+    const int lane = threadIdx.x % warp_size;
+    for (int item = warp; item < 2 * rows; item += warps) {
+        const int row = item % rows;
+        auto* output = item < rows ? shared.q[row] : shared.k[row];
+        const auto offset = static_cast<std::size_t>(first + row) * text_gdn_qkv_width
+                            + (item / rows) * text_gdn_qk_width + qk_head * features;
+        float components[features / warp_size];
+        float squares = 0.0f;
+        #pragma unroll
+        for (int part = 0; part < features / warp_size; ++part) {
+            const int key = part * warp_size + lane;
+            const float value = row < valid ? __bfloat162float(input.qkv[offset + key]) : 0.0f;
+            components[part] = value;
+            squares += warp_sum(value * value);
+        }
+        const float inverse_norm = rsqrtf(squares + 1.0e-6f);
+        #pragma unroll
+        for (int part = 0; part < features / warp_size; ++part) {
+            output[part * warp_size + lane] =
+                __float2bfloat16_rn(components[part] * inverse_norm);
+        }
+    }
+}
+
+__device__ float load_gate(const TextGdnPrepared& input, int index, int, float& beta) {
+    beta = input.beta[index];
+    return input.decay[index];
+}
+
+__device__ float load_gate(const Convolved& input, int index, int head, float& beta) {
+    const float negative_a = -expf(__bfloat162float(input.a_log[head]));
+    const float delta = __bfloat162float(input.a[index]) + __bfloat162float(input.dt_bias[head]);
+    const float softplus = fmaxf(delta, 0.0f) + log1pf(expf(-fabsf(delta)));
+    beta = sigmoid(__bfloat162float(input.b[index]));
+    return expf(negative_a * softplus);
+}
+
+template <class Input>
+__device__ void scan_decay(Shared& shared, const Input& input, int first, int valid, int head) {
+    const int lane = threadIdx.x;
+    if (lane < warp_size) {
+        float logs[2];
+        #pragma unroll
+        for (int part = 0; part < 2; ++part) {
+            const int row = part * warp_size + lane;
+            float beta = 0.0f;
+            const float gate = row < valid
+                                   ? load_gate(input, (first + row) * text_gdn_value_heads + head,
+                                               head, beta)
+                                   : 1.0f;
+            shared.beta[row] = beta;
+            logs[part] = __log2f(gate + 1.0e-10f);
+        }
+        #pragma unroll
+        for (int offset = 1; offset < warp_size; offset *= 2) {
+            #pragma unroll
+            for (float& log : logs) {
+                const float earlier = __shfl_up_sync(all_lanes, log, offset);
+                if (lane >= offset) {
+                    log += earlier;
+                }
+            }
+        }
+        logs[1] += __shfl_sync(all_lanes, logs[0], warp_size - 1);
+        #pragma unroll
+        for (int part = 0; part < 2; ++part) {
+            const int row = part * warp_size + lane;
+            shared.log_prefix[row] = logs[part];
+            shared.prefix[row] = exp2_approx(logs[part]);
+        }
+    }
+}
+
+__device__ void form_scores(Shared& shared, int warp, int lane) {
+    constexpr int tiles = rows / tile;
+    float* result = shared.product[warp];
+    for (int item = warp; item < tiles * tiles; item += warps) {
+        const int base_row = item / tiles * tile;
+        const int base_col = item % tiles * tile;
+        if (base_col <= base_row) {
+            product<wmma::col_major, features>(shared.k[base_row], features, shared.k[base_col],
+                                               features, result);
+        }
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            const int row = base_row + index / tile;
+            const int col = base_col + index % tile;
+            float lower = 0.0f;
+            if (row > col) {
+                lower = result[index] * exp2_approx(shared.log_prefix[row] - shared.log_prefix[col])
+                        * shared.beta[row];
+            }
+            shared.inverse[row][col] = __float2bfloat16_rn(lower);
+        }
+        __syncwarp();
+        if (base_col <= base_row) {
+            product<wmma::col_major, features>(shared.q[base_row], features, shared.k[base_col],
+                                               features, result);
+        }
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            const int row = base_row + index / tile;
+            const int col = base_col + index % tile;
+            float lower = 0.0f;
+            if (row >= col) {
+                lower = result[index] * exp2_approx(shared.log_prefix[row] - shared.log_prefix[col])
+                        * query_scale;
+            }
+            shared.qk[row][col] = __float2bfloat16_rn(lower);
+        }
+        __syncwarp();
+    }
+}
+
+__device__ void invert_eight(Shared& shared) {
+    if (threadIdx.x < rows) {
+        constexpr int half = 8;
+        const int row = threadIdx.x;
+        const int diagonal = row % half;
+        const int first = row - diagonal;
+        float values[half];
+        #pragma unroll
+        for (int col = 0; col < half; ++col) {
+            values[col] = col == diagonal ? 1.0f
+                                          : __bfloat162float(shared.inverse[row][first + col]);
+        }
+        #pragma unroll
+        for (int pivot = 0; pivot < half - 1; ++pivot) {
+            const float negative = -values[pivot];
+            #pragma unroll
+            for (int col = 0; col < pivot; ++col) {
+                const float prior = __shfl_sync(all_lanes, values[col], pivot, half);
+                if (diagonal > pivot) {
+                    values[col] = fmaf(negative, prior, values[col]);
+                }
+            }
+            if (diagonal > pivot) {
+                values[pivot] = negative;
+            }
+        }
+        #pragma unroll
+        for (int col = 0; col < half; ++col) {
+            shared.inverse[row][first + col] = __float2bfloat16_rn(values[col]);
+        }
+    }
+    __syncthreads();
+}
+
+__device__ unsigned pack_bf16(BF16 first, BF16 second) {
+    return unsigned(__bfloat16_as_ushort(first)) | (unsigned(__bfloat16_as_ushort(second)) << 16);
+}
+
+__device__ void mma_eight(unsigned lhs, unsigned rhs, float& first, float& second) {
+    asm("{ .reg .f32 ignored_first, ignored_second;\n"
+        "mma.sync.aligned.m16n8k8.row.col.f32.bf16.bf16.f32 "
+        "{%0,%1,ignored_first,ignored_second}, {%2,%2}, {%3}, {%4,%4,%4,%4}; }"
+        : "=f"(first), "=f"(second) : "r"(lhs), "r"(rhs), "f"(0.0f));
+}
+
+__device__ void invert_sixteen(Shared& shared, int warp, int lane) {
+    constexpr int half = 8;
+    if (warp < rows / (2 * half)) {
+        const int first = warp * 2 * half;
+        const int lower = first + half;
+        const int row = lane / 4;
+        const int col = (lane % 4) * 2;
+        const auto diagonal = pack_bf16(shared.inverse[lower + row][lower + col],
+                                        shared.inverse[lower + row][lower + col + 1]);
+        const auto off_diagonal = pack_bf16(shared.inverse[lower + col][first + row],
+                                            shared.inverse[lower + col + 1][first + row]);
+        const auto upper = pack_bf16(shared.inverse[first + col][first + row],
+                                      shared.inverse[first + col + 1][first + row]);
+        float first_result;
+        float second_result;
+        mma_eight(diagonal, off_diagonal, first_result, second_result);
+        const auto correction = pack_bf16(__float2bfloat16_rn(-first_result),
+                                          __float2bfloat16_rn(-second_result));
+        mma_eight(correction, upper, first_result, second_result);
+        shared.inverse[lower + row][first + col] = __float2bfloat16_rn(first_result);
+        shared.inverse[lower + row][first + col + 1] = __float2bfloat16_rn(second_result);
+    }
+    __syncthreads();
+}
+
+template <int half>
+__device__ void invert_larger(Shared& shared, int warp, int lane) {
+    constexpr int axis = half / tile;
+    constexpr int tiles_per_block = axis * axis;
+    if (warp < rows / (2 * half) * tiles_per_block) {
+        const int block = warp / tiles_per_block;
+        const int first = 2 * half * block;
+        const int row = warp % tiles_per_block / axis * tile;
+        const int col = warp % axis * tile;
+        float* result = shared.product[warp];
+        BF16* intermediate = shared.intermediate + block * half * half;
+        product<wmma::row_major, half>(&shared.inverse[first + half + row][first + half], rows,
+                                       &shared.inverse[first + half][first + col], rows, result);
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            intermediate[(row + index / tile) * half + col + index % tile] =
+                __float2bfloat16_rn(-result[index]);
+        }
+    }
+    __syncthreads();
+    if (warp < rows / (2 * half) * tiles_per_block) {
+        const int block = warp / tiles_per_block;
+        const int first = 2 * half * block;
+        const int row = warp % tiles_per_block / axis * tile;
+        const int col = warp % axis * tile;
+        float* result = shared.product[warp];
+        const BF16* intermediate = shared.intermediate + block * half * half;
+        product<wmma::row_major, half>(intermediate + row * half, half,
+                                       &shared.inverse[first][first + col], rows, result);
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            shared.inverse[first + half + row + index / tile][first + col + index % tile] =
+                __float2bfloat16_rn(result[index]);
+        }
+    }
+    __syncthreads();
+}
+
+__device__ const BF16* values(const TextGdnPrepared& input) {
+    return input.v;
+}
+
+__device__ const BF16* values(const Convolved& input) {
+    return input.qkv + 2 * text_gdn_qk_width;
+}
+
+template <class Input>
+__device__ void correct_values(Shared& shared, const Input& input, int first, int valid,
+                                int head, int warp, int lane) {
+    constexpr int tiles = rows / tile;
+    constexpr int stride = std::is_same_v<Input, Convolved> ? text_gdn_qkv_width
+                                                            : text_gdn_value_width;
+    const BF16* value = values(input) + head * features;
+    float* result = shared.product[warp];
+    for (int item = warp; item < features / tile * tiles; item += warps) {
+        const int base_value = item / tiles * tile;
+        const int base_row = item % tiles * tile;
+        product<wmma::col_major, features>(shared.state[base_value], features, shared.k[base_row],
+                                           features, result);
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            const int row = base_row + index % tile;
+            const int channel = base_value + index / tile;
+            const BF16 prediction = __float2bfloat16_rn(result[index] * shared.prefix[row]);
+            shared.corrected[channel][row] =
+                row < valid ? __hsub(value[std::size_t(first + row) * stride + channel], prediction)
+                            : BF16{};
+        }
+        __syncwarp();
+    }
+}
+
+__device__ void update_values(Shared& shared, int warp, int lane) {
+    constexpr int tiles = rows / tile;
+    float* result = shared.product[warp];
+    for (int item = warp; item < features / tile * tiles; item += warps) {
+        const int base_value = item / tiles * tile;
+        const int base_row = item % tiles * tile;
+        product<wmma::col_major, rows>(shared.corrected[base_value], rows,
+                                      shared.inverse[base_row], rows, result);
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            const int row = base_row + index % tile;
+            const int channel = base_value + index / tile;
+            const float transfer = exp2_approx(shared.log_prefix[rows - 1] - shared.log_prefix[row]);
+            shared.nv[channel][row] = __float2bfloat16_rn(result[index]);
+            shared.dv[channel][row] = __float2bfloat16_rn(result[index] * transfer);
+        }
+        __syncwarp();
+    }
+}
+
+__device__ void finish(Shared& shared, float* state, BF16* output, int valid, int warp, int lane) {
+    constexpr int token_tiles = rows / tile;
+    constexpr int feature_tiles = features / tile;
+    float* result = shared.product[warp];
+    for (int item = warp; item < feature_tiles * token_tiles; item += warps) {
+        const int base_value = item / token_tiles * tile;
+        const int base_row = item % token_tiles * tile;
+        product<wmma::col_major, features>(shared.state[base_value], features, shared.q[base_row],
+                                           features, result);
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            const int row = base_row + index % tile;
+            result[index] = result[index] * shared.prefix[row] * query_scale;
+        }
+        product<wmma::col_major, rows>(shared.nv[base_value], rows, shared.qk[base_row], rows,
+                                      result, true);
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            const int row = base_row + index % tile;
+            if (row < valid) {
+                const int channel = base_value + index / tile;
+                output[std::size_t(row) * text_gdn_value_width + channel] =
+                    __float2bfloat16_rn(result[index]);
+            }
+        }
+        __syncwarp();
+    }
+    for (int item = warp; item < feature_tiles * feature_tiles; item += warps) {
+        const int base_value = item / feature_tiles * tile;
+        const int base_key = item % feature_tiles * tile;
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            const int value = base_value + index / tile;
+            const int key = base_key + index % tile;
+            result[index] = state[value * features + key] * shared.prefix[rows - 1];
+        }
+        product<wmma::row_major, rows>(shared.dv[base_value], rows, &shared.k[0][base_key],
+                                      features, result, true);
+        for (int index = lane; index < tile * tile; index += warp_size) {
+            const int value = base_value + index / tile;
+            const int key = base_key + index % tile;
+            state[value * features + key] = result[index];
+        }
+        __syncwarp();
+    }
+}
+
+template <class Input>
+__global__ void recur(int token_count, Input input, float* recurrent, BF16* observable) {
+    extern __shared__ __align__(32) unsigned char storage[];
+    auto& shared = *reinterpret_cast<Shared*>(storage);
+    const int head = blockIdx.x;
+    const int warp = threadIdx.x / warp_size;
+    const int lane = threadIdx.x % warp_size;
+    auto* state = recurrent + head * features * features;
+    for (int first = 0; first < token_count; first += rows) {
+        const int valid = min(token_count - first, rows);
+        scan_decay(shared, input, first, valid, head);
+        prepare(shared, input, first, valid, head, head / heads_per_qk);
+        for (int index = threadIdx.x; index < features * features; index += threads) {
+            shared.state[index / features][index % features] = __float2bfloat16_rn(state[index]);
+        }
+        __syncthreads();
+        form_scores(shared, warp, lane);
+        __syncthreads();
+        invert_eight(shared);
+        invert_sixteen(shared, warp, lane);
+        invert_larger<16>(shared, warp, lane);
+        invert_larger<32>(shared, warp, lane);
+        for (int index = threadIdx.x; index < rows * rows; index += threads) {
+            auto& element = shared.inverse[index / rows][index % rows];
+            element = __float2bfloat16_rn(__bfloat162float(element) * shared.beta[index % rows]);
+        }
+        correct_values(shared, input, first, valid, head, warp, lane);
+        __syncthreads();
+        update_values(shared, warp, lane);
+        __syncthreads();
+        finish(shared, state, observable + std::size_t(first) * text_gdn_value_width
+                                      + head * features, valid, warp, lane);
+        __syncthreads();
+    }
+}
+
+template <class Input>
+cudaError_t launch(int tokens, Input input, float* recurrent, BF16* observable,
+                    cudaStream_t stream) {
+    const auto kernel = recur<Input>;
+    const auto status = cudaFuncSetAttribute(
+        kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, sizeof(Shared));
+    if (status != cudaSuccess) {
+        return status;
+    }
+    void* arguments[] = {&tokens, &input, &recurrent, &observable};
+    return cudaLaunchKernel(kernel, dim3(text_gdn_value_heads), dim3(threads), arguments,
+                            sizeof(Shared), stream);
+}
+
+}
+
+cudaError_t text_gdn_chunk_forward(int token_count, TextGdnPrepared input,
+                                   float* recurrent, BF16* observable, cudaStream_t stream) {
+    if (token_count == 0) {
+        return cudaSuccess;
+    }
+    if (token_count < 0 || token_count > text_attention_max_tokens || !input.q || !input.k
+        || !input.v || !input.decay || !input.beta || !recurrent || !observable) {
+        return cudaErrorInvalidValue;
+    }
+    return launch(token_count, input, recurrent, observable, stream);
+}
+
+cudaError_t text_gdn_chunk_convolved(int token_count, const BF16* convolved,
+                                     const BF16* b, const BF16* a, TextGdnWeights weights,
+                                     float* recurrent, BF16* observable, cudaStream_t stream) {
+    if (token_count == 0) {
+        return cudaSuccess;
+    }
+    if (token_count < 0 || token_count > text_attention_max_tokens || !convolved || !b || !a
+        || !weights.a_log || !weights.dt_bias || !recurrent || !observable) {
+        return cudaErrorInvalidValue;
+    }
+    return launch(token_count, Convolved{convolved, b, a, weights.a_log, weights.dt_bias},
+                  recurrent, observable, stream);
+}
