diff --git a/include/sglang/mxfp8_fast_decode.h b/include/sglang/mxfp8_fast_decode.h
new file mode 100644
index 0000000..94c7d6c
--- /dev/null
+++ b/include/sglang/mxfp8_fast_decode.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "sglang/mxfp8_gqa.h"
+
+namespace sglang::decoder {
+
+inline constexpr int fast_gqa_max_lanes = 4;
+inline constexpr int fast_gqa_min_tokens = 512;
+inline constexpr int fast_gqa_max_tokens = 65536;
+inline constexpr int fast_gqa_max_parts = 64;
+inline constexpr int fast_gqa_partial_stride = 2 * mxfp8_head_dim + 3;
+
+constexpr int fast_gqa_parts(int capacity) {
+    const int pages = (capacity + mxfp8_page_size - 1) / mxfp8_page_size;
+    return pages < fast_gqa_max_parts ? pages : fast_gqa_max_parts;
+}
+
+constexpr std::size_t fast_gqa_workspace_elements(int capacity) {
+    return capacity >= fast_gqa_min_tokens && capacity <= fast_gqa_max_tokens
+        ? mxfp8_query_heads * (fast_gqa_parts(capacity) * fast_gqa_partial_stride + 1)
+        : 0;
+}
+
+struct FastGqaLane {
+    Mxfp8KvCache cache;
+    Mxfp8PageTable pages;
+    const __nv_bfloat16* queries;
+    __nv_bfloat16* output;
+    float* scratch;
+    const int* device_position;
+    int position;
+};
+
+struct FastGqaBatch {
+    FastGqaLane lanes[fast_gqa_max_lanes];
+};
+
+cudaError_t fast_decode_gqa_attention(FastGqaBatch batch, int count, cudaStream_t stream);
+cudaError_t fast_decode_gqa_fallback(FastGqaBatch batch, int count, cudaStream_t stream);
+
+}
