+void check_geometry(const fs::path& fixture) {
+    std::array<std::int64_t, 3> shape{};
+    read_exact(fixture / "grid.i64", shape);
+    const auto grid = vision::validate_grid(shape);
+    std::vector<std::int64_t> expected_hw(grid.patches() * 2);
+    std::vector<std::int64_t> expected_cu(grid.time + 1);
+    read_exact(fixture / "vision_hw.i64", expected_hw);
+    read_exact(fixture / "vision_cu.i64", expected_cu);
+    for (int row = 0; row < grid.patches(); ++row) {
+        int height, width;
+        vision::coordinates(grid, row, height, width);
+        if (height != expected_hw[row * 2] || width != expected_hw[row * 2 + 1]) {
+            throw std::runtime_error("Spatial patch order differs at row " + std::to_string(row));
+        }
+    }
+    for (int frame = 0; frame <= grid.time; ++frame) {
+        if (expected_cu[frame] != frame * grid.frame()) {
+            throw std::runtime_error("Temporal group boundary differs at " + std::to_string(frame));
+        }
+    }
+    std::printf("Geometry verified for %s (%d patches, %d spatial merges)\n",
+                fixture.c_str(), grid.patches(), grid.patches() / 4);
+}
+
