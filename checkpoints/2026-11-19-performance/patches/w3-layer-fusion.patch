diff --git a/src/text_decode_ops.cu b/src/text_decode_ops.cu
new file mode 100644
index 0000000000000000000000000000000000000000..8107fb26c997cb24435cfd077cf08660c689e00a
--- /dev/null
+++ b/src/text_decode_ops.cu
@@ -0,0 +1,181 @@
+#include "sglang/text_ops.h"
+
+#include "text_device.cuh"
+
+#include <cuda_fp8.h>
+
+namespace sglang {
+namespace {
+
+using namespace text_device;
+
+constexpr int decode_lanes = 4;
+constexpr int projection_pack = 8;
+constexpr int quant_warps = 4;
+
+struct ProjectionBatch {
+    const __nv_bfloat16* weight;
+    TextBf16Projection lanes[decode_lanes];
+};
+
+struct ProjectionPair {
+    ProjectionBatch matrices[2];
+};
+
+struct QuantizationBatch {
+    TextFp8Quantization lanes[decode_lanes];
+};
+
+template <int RowsPerWarp, int Warps>
+__device__ void gemv_batch4(const ProjectionBatch& batch, int out_width, int in_width) {
+    const int thread = threadIdx.x % warp_width;
+    const int first_row = (blockIdx.x * Warps + threadIdx.x / warp_width) * RowsPerWarp;
+    const auto* weight = batch.weight + std::size_t(first_row) * in_width;
+    float low[RowsPerWarp][decode_lanes]{};
+    float high[RowsPerWarp][decode_lanes]{};
+    for (int column = thread * projection_pack; column < in_width;
+         column += warp_width * projection_pack) {
+        uint4 rows[RowsPerWarp]{};
+#pragma unroll
+        for (int row = 0; row < RowsPerWarp; ++row) {
+            if (first_row + row < out_width) {
+                rows[row] = load_128(weight + std::size_t(row) * in_width + column);
+            }
+        }
+#pragma unroll
+        for (int lane = 0; lane < decode_lanes; ++lane) {
+            const auto input = load_128(batch.lanes[lane].input + column);
+#pragma unroll
+            for (int row = 0; row < RowsPerWarp; ++row) {
+                low[row][lane] = bf16x2_dot(rows[row].x, input.x, low[row][lane]);
+                high[row][lane] = bf16x2_dot(rows[row].y, input.y, high[row][lane]);
+                low[row][lane] = bf16x2_dot(rows[row].z, input.z, low[row][lane]);
+                high[row][lane] = bf16x2_dot(rows[row].w, input.w, high[row][lane]);
+            }
+        }
+    }
+#pragma unroll
+    for (int row = 0; row < RowsPerWarp; ++row) {
+#pragma unroll
+        for (int lane = 0; lane < decode_lanes; ++lane) {
+            const float sum = warp_sum(low[row][lane] + high[row][lane]);
+            if (thread == 0 && first_row + row < out_width) {
+                batch.lanes[lane].output[first_row + row] = __float2bfloat16_rn(sum);
+            }
+        }
+    }
+}
+
+__global__ void bf16_gemv_batch4_kernel(const __grid_constant__ ProjectionBatch batch,
+                                        int out_width, int in_width) {
+    gemv_batch4<2, 8>(batch, out_width, in_width);
+}
+
+__global__ void bf16_gemv_pair_batch4_kernel(const __grid_constant__ ProjectionPair pair,
+                                             int out_width, int in_width) {
+    gemv_batch4<1, 2>(pair.matrices[blockIdx.y], out_width, in_width);
+}
+
+__global__ void quantize_fp8_batch4_kernel(const __grid_constant__ QuantizationBatch batch,
+                                           int groups) {
+    const int group = blockIdx.x * quant_warps + threadIdx.x / warp_width;
+    if (group >= groups) {
+        return;
+    }
+    const auto quantization = batch.lanes[blockIdx.y];
+    const int lane = threadIdx.x % warp_width;
+    const int word = group * warp_width + lane;
+    const auto bits = reinterpret_cast<const uint2*>(quantization.input)[word];
+    const float first = __uint_as_float(bits.x << 16);
+    const float second = __uint_as_float(bits.x & 0xffff0000u);
+    const float third = __uint_as_float(bits.y << 16);
+    const float fourth = __uint_as_float(bits.y & 0xffff0000u);
+    const float maximum = warp_max(fmaxf(fmaxf(fabsf(first), fabsf(second)),
+                                         fmaxf(fabsf(third), fabsf(fourth))));
+    float reciprocal = 0.0f;
+    if (lane == 0) {
+        const float scale = __fdiv_rn(fmaxf(maximum, 1.0e-10f), 448.0f);
+        quantization.output.scales[group] = scale;
+        reciprocal = __fdiv_rn(1.0f, scale);
+    }
+    reciprocal = __shfl_sync(warp_mask, reciprocal, 0);
+    const auto lower = __nv_cvt_float2_to_fp8x2(make_float2(first * reciprocal, second * reciprocal),
+                                               __NV_SATFINITE, __NV_E4M3);
+    const auto upper = __nv_cvt_float2_to_fp8x2(make_float2(third * reciprocal, fourth * reciprocal),
+                                               __NV_SATFINITE, __NV_E4M3);
+    static_assert(text_fp8_group_size / warp_width == sizeof(std::uint32_t));
+    reinterpret_cast<std::uint32_t*>(quantization.output.values)[word] =
+        lower | (std::uint32_t(upper) << 16);
+}
+
+bool init_projection(ProjectionBatch& batch, const __nv_bfloat16* weight,
+                     const TextBf16Projection* lanes) {
+    if (!weight || !aligned(weight, 16) || !lanes) {
+        return false;
+    }
+    batch.weight = weight;
+    for (int lane = 0; lane < decode_lanes; ++lane) {
+        const auto entry = lanes[lane];
+        if (!entry.input || !entry.output || !aligned(entry.input, 16)) {
+            return false;
+        }
+        batch.lanes[lane] = entry;
+    }
+    return true;
+}
+
+constexpr int blocks_for(int elements, int per_block) {
+    return elements / per_block + (elements % per_block != 0);
+}
+
+}
+
+cudaError_t text_bf16_gemv_batch4(const __nv_bfloat16* weight, int out_width, int in_width,
+                                 const TextBf16Projection* lanes, cudaStream_t stream) {
+    ProjectionBatch batch;
+    if (out_width <= 0 || in_width <= 0 || in_width % projection_pack != 0 ||
+        !init_projection(batch, weight, lanes)) {
+        return cudaErrorInvalidValue;
+    }
+    void* args[]{&batch, &out_width, &in_width};
+    return cudaLaunchKernel(bf16_gemv_batch4_kernel, blocks_for(out_width, 16),
+                            8 * warp_width, args, 0, stream);
+}
+
+cudaError_t text_bf16_gemv_pair_batch4(const __nv_bfloat16* weight_a, const __nv_bfloat16* weight_b,
+                                      int out_width, int in_width,
+                                      const TextBf16Projection* lanes_a,
+                                      const TextBf16Projection* lanes_b, cudaStream_t stream) {
+    ProjectionPair pair;
+    if (out_width <= 0 || in_width <= 0 || in_width % projection_pack != 0 ||
+        !init_projection(pair.matrices[0], weight_a, lanes_a) ||
+        !init_projection(pair.matrices[1], weight_b, lanes_b)) {
+        return cudaErrorInvalidValue;
+    }
+    void* args[]{&pair, &out_width, &in_width};
+    return cudaLaunchKernel(bf16_gemv_pair_batch4_kernel, dim3(blocks_for(out_width, 2), 2),
+                            2 * warp_width, args, 0, stream);
+}
+
+cudaError_t text_quantize_fp8_batch4(int width, const TextFp8Quantization* lanes,
+                                    cudaStream_t stream) {
+    if (!lanes || width <= 0 || width % text_fp8_group_size != 0) {
+        return cudaErrorInvalidValue;
+    }
+    QuantizationBatch batch;
+    for (int lane = 0; lane < decode_lanes; ++lane) {
+        const auto entry = lanes[lane];
+        if (!entry.input || !entry.output.values || !entry.output.scales ||
+            !aligned(entry.input, 8) || !aligned(entry.output.values, 4)) {
+            return cudaErrorInvalidValue;
+        }
+        batch.lanes[lane] = entry;
+    }
+    int groups = text_fp8_group_count(width);
+    void* args[]{&batch, &groups};
+    return cudaLaunchKernel(quantize_fp8_batch4_kernel,
+                            dim3(blocks_for(groups, quant_warps), decode_lanes),
+                            quant_warps * warp_width, args, 0, stream);
+}
+
+}
diff --git a/src/text_device.cuh b/src/text_device.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..b8a6024f24d1b6f8e7f64f1ae1d45f0e0c3c0eb0
--- /dev/null
+++ b/src/text_device.cuh
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include <cuda_runtime.h>
+
+namespace sglang::text_device {
+
+inline constexpr int warp_width = 32;
+inline constexpr unsigned int warp_mask = 0xffffffffu;
+
+inline bool aligned(const void* pointer, std::size_t alignment) {
+    return reinterpret_cast<std::uintptr_t>(pointer) % alignment == 0;
+}
+
+__device__ inline float warp_sum(float value) {
+    for (int offset = warp_width / 2; offset > 0; offset /= 2) {
+        value += __shfl_down_sync(warp_mask, value, offset);
+    }
+    return value;
+}
+
+__device__ inline float warp_max(float value) {
+    for (int offset = warp_width / 2; offset > 0; offset /= 2) {
+        value = fmaxf(value, __shfl_down_sync(warp_mask, value, offset));
+    }
+    return value;
+}
+
+__device__ inline uint4 load_128(const void* address) {
+    uint4 bits;
+    const auto global = __cvta_generic_to_global(address);
+    asm("ld.global.v4.b32 {%0, %1, %2, %3}, [%4];"
+        : "=r"(bits.x), "=r"(bits.y), "=r"(bits.z), "=r"(bits.w)
+        : "l"(global) : "memory");
+    return bits;
+}
+
+__device__ inline float bf16x2_dot(unsigned int lhs, unsigned int rhs, float sum) {
+    sum = fmaf(__uint_as_float(lhs << 16), __uint_as_float(rhs << 16), sum);
+    return fmaf(__uint_as_float(lhs & 0xffff0000u), __uint_as_float(rhs & 0xffff0000u), sum);
+}
+
+}
