@@ -0,0 +1,179 @@
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import json
+from pathlib import Path
+import signal
+import subprocess
+import threading
+
+from compare import load_rows, rankings, read_bundle
+from fixtures import EOS, HERE, digest, require, verify_checkpoint, write_json
+from run_native import Stream, choose_port, stop_server, trace_rows, wait_until_ready
+
+
+def cancel_run(_signal, _frame):
+    raise KeyboardInterrupt
+
+
+def served_request(port, name, case, barrier=None):
+    with Stream(port, case) as stream:
+        if barrier is not None:
+            barrier.wait(timeout=10)
+        stream.post()
+        stream.open()
+        tokens = []
+        prompt = case["prompt"]
+        for _ in range(case["max_tokens"] + 1):
+            event = stream.event()
+            require(isinstance(event, dict) and len(event["choices"]) == 1,
+                    f"{name}: missing SSE choice")
+            choice = event["choices"][0]
+            if not tokens:
+                require(choice["prompt_token_ids"] == prompt, f"{name}: prompt ID mismatch")
+            finish = choice["finish_reason"]
+            if finish is not None:
+                require(choice["token_ids"] == [] and finish in ("length", "stop"),
+                        f"{name}: malformed completion")
+                break
+            ids = choice["token_ids"]
+            require(len(ids) == 1, f"{name}: expected one streamed token")
+            tokens.extend(ids)
+        else:
+            raise ValueError(f"{name}: missing finish event")
+        usage = stream.event()
+        require(usage["choices"] == [] and usage["usage"]["prompt_tokens"] == len(prompt)
+                and usage["usage"]["completion_tokens"] == len(tokens),
+                f"{name}: inconsistent usage")
+        require(stream.event() == "[DONE]" and stream.response.read(1) == b"",
+                f"{name}: invalid SSE termination")
+        return {"name": name, "tokens": tokens, "finish": finish,
+                "request": stream.request, "events": stream.events}
+
+
+def check_reference(args, response, oracle, criteria):
+    name, generated = response["name"], response["tokens"]
+    expected = oracle["tokens"]
+    failures = []
+    steps = []
+    if name == "eos" and (generated != expected or response["finish"] != "stop"):
+        failures.append("eos_history_or_finish")
+    if name != "eos" and (len(generated) != len(expected) or response["finish"] != "length"):
+        failures.append("length_or_finish")
+    rows = load_rows(args.bundle, name, oracle)
+    repeats = load_rows(args.bundle, name, oracle, 1) if oracle["repeats"] == 2 else {}
+    same_prefix = 0
+    for step, (candidate, teacher) in enumerate(zip(generated, expected)):
+        if candidate == teacher:
+            same_prefix += 1
+        if step not in rows:
+            if candidate != teacher:
+                failures.append(f"unscored_history_at_{step}")
+                break
+            continue
+        ref, repeat = rows[step], repeats.get(step)
+        order = rankings(ref, criteria["top_k"])
+        winner = int(order[0])
+        require(winner == teacher or ref[teacher] == ref[winner],
+                f"{name}/{step}: SGLang recorded token is not a greedy winner")
+        require(0 <= candidate < len(ref), f"{name}/{step}: invalid native token ID")
+        margin = float(ref[winner] - ref[order[1]])
+        repeat_margin = None
+        clear = margin >= criteria["reference_margin_min"]
+        if repeat is not None:
+            other = rankings(repeat, 2)
+            repeat_margin = float(repeat[other[0]] - repeat[other[1]])
+            clear &= winner == other[0] and repeat_margin >= criteria["reference_margin_min"]
+        regret = float(ref[winner] - ref[candidate])
+        if (clear and candidate != winner) or (
+            not clear and (candidate not in order or regret > criteria["reference_margin_min"])
+        ):
+            failures.append(f"reference_winner_at_{step}")
+        steps.append({"step": step, "reference": teacher, "native": candidate,
+                      "reference_margin": margin, "repeat_margin": repeat_margin,
+                      "clear_margin": bool(clear), "reference_regret": regret})
+        if candidate != teacher:
+            break
+    return {"same_prefix": same_prefix, "steps": steps, "failures": failures}
+
+
+def run_width(args, inputs, oracle, thresholds, width):
+    output = args.output / f"width-{width}"
+    output.mkdir()
+    port = choose_port()
+    command = [str(args.server), "--checkpoint", str(args.checkpoint), "--device", "0",
+               "--port", str(port), "--max-active", str(width), "--trace-batches",
+               "--fp8-prefill", args.prefill]
+    if args.graph and width > 1:
+        command.append("--batch-cuda-graphs")
+    write_json(output / "command.json", command)
+    log_path = output / "server.log"
+    names = ["W1"] * width if args.archive_smoke else ["prose", "python", "unicode", "prose"][:width]
+    request_names = set(names)
+    if not args.archive_smoke:
+        request_names.add("eos")
+    requests = {name: {"prompt": inputs[name]["prompt"],
+                       "max_tokens": inputs[name].get("natural", len(oracle[name]["tokens"]))}
+                for name in request_names}
+    if "eos" in requests:
+        require(oracle["eos"]["finish"] == "stop" and oracle["eos"]["tokens"][-1] in EOS,
+                "Frozen EOS fixture did not reach checkpoint EOS")
+        requests["eos"]["stop_token_id"] = oracle["eos"]["tokens"][-1]
+    with log_path.open("wb") as log:
+        process = subprocess.Popen(command, cwd=output, stdout=log, stderr=log,
+                                   start_new_session=True)
+        try:
+            wait_until_ready(process, port, log_path)
+            offset = log_path.stat().st_size
+            barrier = threading.Barrier(width)
+            with ThreadPoolExecutor(max_workers=width) as pool:
+                futures = [pool.submit(served_request, port, name, requests[name], barrier)
+                           for name in names]
+                burst = [future.result() for future in futures]
+            scheduler = trace_rows(log_path, offset, width)
+            if "eos" in requests:
+                burst.append(served_request(port, "eos", requests["eos"]))
+        finally:
+            stop_server(process, None)
+    require(process.returncode == 0, f"Server exit {process.returncode}: {log_path}")
+    result = {"graph_requested": args.graph and width > 1, "scheduler": scheduler,
+              "full_width_decode_steps": sum(decode == width for _, decode, _ in scheduler),
+              "responses": [{**item, **check_reference(args, item, oracle[item["name"]], thresholds)}
+                            for item in burst]}
+    result["failures"] = [failure for response in result["responses"]
+                          for failure in response["failures"]]
+    if width > 1 and result["full_width_decode_steps"] < 2:
+        result["failures"].append("full_width_decode_not_observed_twice")
+    write_json(output / "report.json", result)
+    return result["failures"]
+
+
+def main():
+    signal.signal(signal.SIGTERM, cancel_run)
+    parser = argparse.ArgumentParser()
+    for name in ("server", "checkpoint", "bundle", "output"):
+        parser.add_argument(name, type=lambda value: Path(value).resolve())
+    parser.add_argument("--graph", action="store_true")
+    parser.add_argument("--archive-smoke", action="store_true")
+    parser.add_argument("--prefill", choices=("exact", "tensor-core"), default="exact")
+    parser.add_argument("--widths", nargs="+", type=int, choices=(1, 2, 3, 4),
+                        default=[1, 2, 3, 4])
+    args = parser.parse_args()
+    inputs, oracle = read_bundle(args.bundle)
+    verify_checkpoint(args.checkpoint)
+    if not args.archive_smoke:
+        require({"prose", "python", "unicode", "eos"} <= oracle.keys(),
+                "The HTTP holdout tests require a full independently captured fixture")
+    thresholds = json.loads((HERE / "criteria.json").read_text())
+    args.output.mkdir()
+    failures = {}
+    for width in args.widths:
+        failures[str(width)] = run_width(args, inputs, oracle, thresholds, width)
+        write_json(args.output / "report.json",
+                   {"server_sha256": digest(args.server), "prefill": args.prefill,
+                    "archive_smoke": args.archive_smoke,
+                    "width_failures": failures})
+    raise SystemExit(1 if any(failures.values()) else 0)
+
+
+if __name__ == "__main__":
+    main()
