diff --git a/tests/model_reference/reference.py b/tests/model_reference/reference.py
new file mode 100644
index 0000000..dc10400
--- /dev/null
+++ b/tests/model_reference/reference.py
@@ -0,0 +1,138 @@
+import argparse
+import json
+import os
+import tarfile
+from pathlib import Path
+
+from fixtures import (ARCHIVE_CASES, CHECKPOINT, CHECKPOINT_MANIFEST_SHA, EOS, SGLANG,
+                      SOURCE_SHA, VOCAB, digest, require, verify_checkpoint, write_json)
+
+
+def score_processor(base):
+    class Scores(base):
+        def __call__(self, logits, params):
+            from pathlib import Path
+
+            settings = params[0]
+            request = settings["__req__"]
+            step = len(request.output_ids)
+            assert list(request.origin_input_ids) == settings["prompt"]
+            if step == 0 and request.extend_end < len(request.origin_input_ids):
+                return logits
+            assert logits.shape == (1, 248320)
+            teacher = settings.get("teacher")
+            if teacher is not None:
+                assert list(request.output_ids) == teacher[:step] and step < len(teacher)
+            with Path(settings["output"]).open("ab") as output:
+                assert output.tell() == step * 248320 * 4
+                logits.float().cpu().contiguous().numpy().tofile(output)
+            if teacher is not None:
+                logits.fill_(-float("inf"))
+                logits[0, teacher[step]] = 0.0
+            return logits
+
+    return Scores.to_str()
+
+
+def verify_source(archive):
+    require(digest(archive) == SOURCE_SHA, "Unexpected SGLang source archive")
+    root = f"sglang-{SGLANG}/python/"
+    package = Path(os.environ["MODEL_REFERENCE_SGLANG_PYTHON"]).resolve()
+    with tarfile.open(archive, "r:gz") as source:
+        members = [member for member in source if (member.isfile() or member.issym())
+                   and member.name.startswith(root)]
+        expected = {member.name.removeprefix(root) for member in members}
+        actual = {str(path.relative_to(package)) for path in package.rglob("*")
+                  if (path.is_file() or path.is_symlink()) and "__pycache__" not in path.parts}
+        require(expected == actual, "SGLang Python tree members differ from pinned source")
+        for member in members:
+            path = package / member.name.removeprefix(root)
+            matches = (os.readlink(path) == member.linkname if member.issym()
+                       else path.read_bytes() == source.extractfile(member).read())
+            require(matches, f"SGLang source differs at {path}")
+    return package
+
+
+def verify_weights(checkpoint, manifest):
+    require(digest(manifest) == CHECKPOINT_MANIFEST_SHA, "Unexpected checkpoint manifest")
+    for line in manifest.read_text().splitlines():
+        sha, name = line.split(maxsplit=1)
+        require(digest(checkpoint / name) == sha, f"Unexpected checkpoint file {name}")
+
+
+def capture(engine, case, processor, destination):
+    settings = {"prompt": case["prompt"], "output": str(destination)}
+    teacher = case.get("teacher")
+    if teacher is not None:
+        settings["teacher"] = teacher
+    count = len(teacher) if teacher is not None else case["natural"]
+    stop_at_eos = case.get("stop_at_eos", False)
+    sampling = {"temperature": 0.0, "max_new_tokens": count,
+                "ignore_eos": not stop_at_eos, "custom_params": settings}
+    if stop_at_eos:
+        sampling["stop_token_ids"] = list(EOS)
+    response = engine.generate(
+        input_ids=case["prompt"], custom_logit_processor=processor,
+        sampling_params=sampling,
+    )
+    tokens = response["output_ids"]
+    finish = response["meta_info"]["finish_reason"]["type"]
+    require(teacher is None or teacher == tokens, "SGLang did not follow teacher")
+    require(destination.stat().st_size == len(tokens) * VOCAB * 4, "Bad SGLang row count")
+    require(response["meta_info"]["prompt_tokens"] == len(case["prompt"]),
+            "SGLang prompt length mismatch")
+    if stop_at_eos:
+        require(finish == "stop" and tokens[-1] in EOS, "SGLang did not observe checkpoint EOS")
+    return {"tokens": tokens, "finish": finish, "prompt": case["prompt"]}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("checkpoint", type=Path)
+    parser.add_argument("checkpoint_manifest", type=Path)
+    parser.add_argument("source_archive", type=Path)
+    parser.add_argument("inputs", type=Path)
+    parser.add_argument("output", type=lambda value: Path(value).resolve())
+    parser.add_argument("--all", action="store_true", help="also recapture archived cases")
+    parser.add_argument("--repeat", type=int, choices=(1, 2), default=2)
+    args = parser.parse_args()
+    verify_checkpoint(args.checkpoint)
+    verify_weights(args.checkpoint, args.checkpoint_manifest)
+    package = verify_source(args.source_archive)
+    import sglang
+    from sglang.srt.entrypoints.engine import Engine
+    from sglang.srt.sampling.custom_logit_processor import CustomLogitProcessor
+
+    require(Path(sglang.__file__).resolve().is_relative_to(package),
+            f"Wrong SGLang import: {sglang.__file__}")
+    args.output.mkdir()
+    cases = json.loads(args.inputs.read_text())
+    options = {"language_only": True, "skip_tokenizer_init": True,
+               "dtype": "bfloat16", "mamba_ssm_dtype": "float32", "kv_cache_dtype": "bfloat16",
+               "disable_radix_cache": True, "enable_custom_logit_processor": True,
+               "disable_decode_cuda_graph": True, "disable_prefill_cuda_graph": True,
+               "disable_overlap_schedule": True, "chunked_prefill_size": 128,
+               "max_running_requests": 1, "context_length": 4096, "mem_fraction_static": 0.45}
+    engine = Engine(model_path=str(args.checkpoint), **options)
+    try:
+        processor = score_processor(CustomLogitProcessor)
+        for name, case in cases.items():
+            if name in ARCHIVE_CASES and not args.all:
+                continue
+            if name == "eos":
+                case["stop_at_eos"] = True
+            for repeat in range(args.repeat):
+                base = args.output / f"{name}.{repeat}"
+                result = capture(engine, case, processor, Path(f"{base}.f32"))
+                write_json(Path(f"{base}.json"), result)
+    finally:
+        engine.shutdown()
+    write_json(args.output / "capture.json", {
+        "sglang_revision": SGLANG, "checkpoint_revision": CHECKPOINT,
+        "source_sha256": SOURCE_SHA, "checkpoint_manifest_sha256": CHECKPOINT_MANIFEST_SHA,
+        "inputs_sha256": digest(args.inputs), "engine_options": options, "repeats": args.repeat,
+    })
+
+
+if __name__ == "__main__":
+    main()
