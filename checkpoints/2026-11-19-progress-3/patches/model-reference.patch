+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+
+HERE = Path(__file__).resolve().parent
+VOCAB = 248320
+EOS = (248046, 248044)
+SGLANG = "f04d886bf79aa3d6237cbb12a3311838eb9f9bd8"
+CHECKPOINT = "c3a462cc3d38cf351f3b26cbd763469eeb74ef81"
+TOKENIZER_SHA = "0997f410c57a1f4e53b09e4be8f4a172d90edd9564368fb0847030937229b9f3"
+CONFIG_SHA = "74227dd615bf1ea975aa676bdf355a0379858c12f394b5365cd9dfa5fc2c70bc"
+GENERATION_SHA = "e70c136c1b78ddc1fb0905bac8e733a4dc448d4f852a5dd75143fffc70be550e"
+SOURCE_SHA = "56f58b8682457261ee3aa8deb9eeabbaee2fbea71c90af4387d28badc58e3aa4"
+CHECKPOINT_MANIFEST_SHA = "b54fe44144f1701a9369e8b912997ee5cab77cd176c8f97ad3fe63e78cf3c303"
+ARCHIVE_CASES = ("W1", "W2", "H2047", "C897", "C2017")
+HOLDOUTS = {
+    "prose": "The ferry paused beside the pier. Someone had left a paper bag on the bench. Inside",
+    "python": "def rotate_left(items, count):\n    if not items:\n        return []\n    count %= len(items)\n    return",
+    "unicode": "札幌の古本屋で「銀河鉄道の夜」を開いた。余白には café と書いてあり、その下に",
+    "eos": "<|im_start|>user\nReply with just OK.<|im_end|>\n"
+           "<|im_start|>assistant\n<think>\n\n</think>\n\nOK",
+}
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def digest(path):
+    with path.open("rb") as source:
+        return hashlib.file_digest(source, "sha256").hexdigest()
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+                    encoding="utf-8")
+
+
+def verify_checkpoint(checkpoint):
+    for name, sha in (("tokenizer.json", TOKENIZER_SHA), ("config.json", CONFIG_SHA),
+                      ("generation_config.json", GENERATION_SHA)):
+        require(digest(checkpoint / name) == sha, f"Unexpected checkpoint {name}")
+
+
+def read_ids(path):
+    return list(map(int, path.read_text().split()))
+
+
+def synthesize(checkpoint, archive):
+    from tokenizers import Tokenizer
+
+    verify_checkpoint(checkpoint)
+    tokenizer = Tokenizer.from_file(str(checkpoint / "tokenizer.json"))
+    cases = {}
+    for name in ARCHIVE_CASES:
+        base = archive / "fixtures" / name
+        prompt = read_ids(base.with_suffix(".prompt"))
+        teacher = read_ids(base.with_suffix(".teacher"))
+        cases[name] = {"prompt": prompt, "teacher": teacher}
+    w1 = cases["W1"]
+    for name, prompt, teacher in (
+        ("single", w1["prompt"][:1], w1["teacher"]),
+        ("edge127", w1["prompt"][:127], w1["prompt"][127:] + w1["teacher"]),
+        ("edge129", w1["prompt"] + w1["teacher"][:1], w1["teacher"][1:]),
+    ):
+        cases[name] = {"prompt": prompt, "teacher": teacher[:5]}
+    for name, text in HOLDOUTS.items():
+        cases[name] = {
+            "prompt": tokenizer.encode(text, add_special_tokens=False).ids,
+            "natural": 12 if name != "eos" else 8,
+        }
+    return cases
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("checkpoint", type=Path)
+    parser.add_argument("archive", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    write_json(args.output, synthesize(args.checkpoint, args.archive))
+
+
+if __name__ == "__main__":
+    main()
