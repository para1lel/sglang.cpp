index 0000000..047637a
--- /dev/null
+++ b/tests/model_reference/compare.py
@@ -0,0 +1,216 @@
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+from pathlib import Path
+
+import numpy as np
+
+from fixtures import CHECKPOINT, HERE, SGLANG, VOCAB, digest, require, verify_checkpoint, write_json
+
+
+def read_bundle(bundle):
+    name = "manifest.json" if (bundle / "manifest.json").exists() else "archive-manifest.json"
+    frozen_path = HERE / name
+    require(frozen_path.exists(), f"Missing pinned fixture manifest {frozen_path}")
+    frozen = frozen_path.read_bytes()
+    require((bundle / name).read_bytes() == frozen, f"Bundle differs from frozen {name}")
+    manifest = json.loads(frozen)
+    require(manifest["checkpoint_revision"] == CHECKPOINT and manifest["sglang_revision"] == SGLANG,
+            "Unexpected fixture provenance")
+    require(digest(HERE / "criteria.json") == manifest["criteria_sha256"], "Criteria digest changed")
+    for filename, expected in manifest["files"].items():
+        require(digest(bundle / filename) == expected, f"Fixture digest changed: {filename}")
+    inputs = json.loads((bundle / "inputs.json").read_text())
+    require(manifest["cases"].keys() <= inputs.keys(), "Fixture list differs from manifest")
+    return inputs, manifest["cases"]
+
+
+def rankings(scores, count):
+    threshold = np.partition(scores, scores.size - count)[-count]
+    candidates = np.flatnonzero(scores >= threshold)
+    return candidates[np.lexsort((candidates, -scores[candidates]))[:count]]
+
+
+def measure(reference, candidate, thresholds, repeat=None):
+    reference = np.asarray(reference, dtype=np.float64)
+    candidate = np.asarray(candidate, dtype=np.float64)
+    require(reference.shape == candidate.shape == (VOCAB,), "Wrong vocabulary shape")
+    require(np.isfinite(reference).all() and np.isfinite(candidate).all(), "Nonfinite logits")
+    count = thresholds["top_k"]
+    ref_order = rankings(reference, count)
+    got_order = rankings(candidate, count)
+    reference_winner, candidate_winner = int(ref_order[0]), int(got_order[0])
+    reference_margin = float(reference[ref_order[0]] - reference[ref_order[1]])
+    high_margin = reference_margin >= thresholds["reference_margin_min"]
+    repeat_delta = None
+    if repeat is not None:
+        repeat_order = rankings(repeat, 2)
+        repeat_margin = float(repeat[repeat_order[0]] - repeat[repeat_order[1]])
+        high_margin &= (int(repeat_order[0]) == reference_winner and
+                        repeat_margin >= thresholds["reference_margin_min"])
+        repeat_delta = float(np.max(np.abs(reference - repeat)))
+    ref_norm = np.linalg.norm(reference)
+    candidate_norm = np.linalg.norm(candidate)
+    require(ref_norm > 0 and candidate_norm > 0, "Zero logit norm")
+    relative_l2 = float(np.linalg.norm(candidate - reference) / ref_norm)
+    cosine = float(np.dot(candidate, reference) / (candidate_norm * ref_norm))
+    overlap = int(np.intersect1d(ref_order, got_order).size)
+    failures = []
+    if relative_l2 > thresholds["relative_l2_max"]:
+        failures.append("relative_l2")
+    if cosine < thresholds["cosine_min"]:
+        failures.append("cosine")
+    if overlap < thresholds["top_k_overlap_min"]:
+        failures.append("top_k_overlap")
+    if high_margin and candidate_winner != reference_winner:
+        failures.append("clear_margin_winner")
+    return {"relative_l2": relative_l2, "cosine": cosine, "top_k_overlap": overlap,
+            "reference_top_ids": ref_order.tolist(), "reference_winner": reference_winner,
+            "candidate_winner": candidate_winner, "reference_margin": reference_margin,
+            "candidate_margin": float(candidate[got_order[0]] - candidate[got_order[1]]),
+            "reference_regret": float(reference[reference_winner] - reference[candidate_winner]),
+            "clear_margin": bool(high_margin), "reference_repeat_max_abs": repeat_delta,
+            "failures": failures}
+
+
+def load_rows(bundle, name, case, repeat=0):
+    path = bundle / f"{name}.{repeat}.f32"
+    rows = np.fromfile(path, dtype="<f4")
+    require(rows.size == len(case["steps"]) * VOCAB and np.isfinite(rows).all(),
+            f"Invalid SGLang logits in {path}")
+    return dict(zip(case["steps"], rows.reshape(-1, VOCAB), strict=True))
+
+
+def native_rows(payload):
+    for row in payload["step_top_logits"]:
+        require(len(row) == VOCAB, "Native JSON omitted logits")
+        ids = np.asarray([item["token_id"] for item in row])
+        require(np.issubdtype(ids.dtype, np.integer) and
+                np.array_equal(np.sort(ids), np.arange(VOCAB)), "Native vocabulary ID mismatch")
+        dense = np.empty(VOCAB, dtype=np.float32)
+        dense[ids] = [item["logit"] for item in row]
+        require(np.isfinite(dense).all(), "Nonfinite native logits")
+        yield dense
+
+
+def invoke(args, output, tokens, budget, forced=None):
+    output.mkdir()
+    prompt_file = output / "prompt.txt"
+    prompt_file.write_text(",".join(map(str, tokens)) + "\n")
+    command = [str(args.generate), "--checkpoint", str(args.checkpoint), "--device", "0",
+               "--prompt-file", str(prompt_file), "--max-new-tokens", str(budget),
+               "--fp8-prefill", args.prefill, "--top-logits", str(VOCAB)]
+    env = os.environ.copy()
+    if forced is not None:
+        teacher = output / "teacher.txt"
+        teacher.write_text(" ".join(map(str, forced)) + "\n")
+        env["MODEL_REFERENCE_TEACHER"] = str(teacher)
+        env["MODEL_REFERENCE_TEACHER_TRACE"] = str(output / "trace.txt")
+        env["LD_PRELOAD"] = str(args.teacher)
+    write_json(output / "command.json", command)
+    with (output / "stdout.json").open("wb") as stdout, (output / "stderr.log").open("wb") as stderr:
+        subprocess.run(command, env=env, cwd=output, stdout=stdout, stderr=stderr, check=True,
+                       timeout=45)
+    result = json.loads((output / "stdout.json").read_text())
+    require(result["prompt_token_ids"] == tokens, "Native prompt identity changed")
+    return result
+
+
+def case_rows(args, inputs, cases, name, thresholds):
+    case = cases[name]
+    prompt = inputs[name]["prompt"]
+    tokens = case["tokens"]
+    output = args.output / name
+    payload = invoke(args, output, prompt, len(tokens), forced=tokens)
+    require(payload["output_token_ids"] == tokens and payload["finish_reason"] == "length",
+            f"Native teacher history changed for {name}")
+    trace = [tuple(map(int, line.split())) for line in (output / "trace.txt").read_text().splitlines()]
+    require([(row[0], row[2]) for row in trace] == list(enumerate(tokens)),
+            f"Teacher observer missed native readback for {name}")
+    ref = load_rows(args.bundle, name, case)
+    repeat = load_rows(args.bundle, name, case, 1) if case["repeats"] == 2 else {}
+    rows = []
+    for step, native in enumerate(native_rows(payload)):
+        require(int(np.argmax(native)) == trace[step][1],
+                f"Native raw argmax/readback mismatch at {name}/{step}")
+        if step not in ref:
+            continue
+        history = np.asarray(prompt + tokens[:step], dtype="<u4")
+        metrics = measure(ref[step], native, thresholds, repeat.get(step))
+        rows.append({"step": step, "input_tokens": len(history),
+                     "last_input_id": int(history[-1]),
+                     "history_sha256": hashlib.sha256(history.tobytes()).hexdigest(), **metrics})
+    require(len(payload["step_top_logits"]) == len(tokens) and len(rows) == len(case["steps"]),
+            f"Missing native rows for {name}")
+    return rows
+
+
+def check_hook(args, name, inputs):
+    prompt = inputs[name]["prompt"]
+    natural = invoke(args, args.output / "hook-natural", prompt, 3)
+    tokens = natural["output_token_ids"]
+    forced = invoke(args, args.output / "hook-identity", prompt, 3, forced=tokens)
+    require(len(tokens) == 3 and forced["output_token_ids"] == tokens and
+            all(np.array_equal(left, right) for left, right in
+                zip(native_rows(natural), native_rows(forced), strict=True)),
+            "Inert teacher hook changed same-history logits")
+    alternate_tokens = [(tokens[0] + 1031) % VOCAB, tokens[1]]
+    alternate = invoke(args, args.output / "hook-alternate", prompt, 2, forced=alternate_tokens)
+    natural_rows = native_rows(natural)
+    alternate_rows = native_rows(alternate)
+    require(alternate["output_token_ids"] == alternate_tokens and
+            np.array_equal(next(natural_rows), next(alternate_rows)) and
+            not np.array_equal(next(natural_rows), next(alternate_rows)),
+            "Changed teacher token did not take effect exclusively after its selection")
+    return {"case": name, "steps": len(tokens), "tokens": tokens,
+            "alternate_first_token": alternate_tokens[0]}
+
+
+def mutation_test(bundle, cases, thresholds):
+    rows = load_rows(bundle, "W1", cases["W1"])
+    reference = rows[0]
+    control = measure(reference, reference, thresholds)
+    require(not control["failures"], "Identity scores failed")
+    changed = {"next_position": measure(reference, rows[1], thresholds),
+               "permuted_vocab": measure(reference, np.roll(reference, 1031), thresholds)}
+    require(all(row["failures"] for row in changed.values()), "Score mutation escaped detection")
+    return {name: details["failures"] for name, details in changed.items()}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("bundle", type=Path)
+    parser.add_argument("--self-test", action="store_true")
+    for name in ("generate", "checkpoint", "teacher", "output"):
+        parser.add_argument(f"--{name}", type=lambda value: Path(value).resolve())
+    parser.add_argument("--prefill", choices=("exact", "tensor-core"), default="exact")
+    parser.add_argument("--case", action="append")
+    args = parser.parse_args()
+    inputs, cases = read_bundle(args.bundle)
+    thresholds = json.loads((HERE / "criteria.json").read_text())
+    mutations = mutation_test(args.bundle, cases, thresholds)
+    if args.self_test:
+        print(json.dumps(mutations, indent=2))
+        return
+    require(all((args.generate, args.checkpoint, args.teacher, args.output)),
+            "Native comparison requires --generate, --checkpoint, --teacher, and --output")
+    verify_checkpoint(args.checkpoint)
+    args.output.mkdir()
+    names = args.case or list(cases)
+    require(set(names) <= cases.keys() and len(set(names)) == len(names), "Unknown or repeated case")
+    evidence = {"native_sha256": digest(args.generate), "teacher_sha256": digest(args.teacher),
+                "prefill": args.prefill, "mutations": mutations,
+                "hook_identity": check_hook(args, "W1", inputs), "cases": {}}
+    report = args.output / "report.json"
+    for name in names:
+        evidence["cases"][name] = case_rows(args, inputs, cases, name, thresholds)
+        write_json(report, evidence)
+    passed = not any(row["failures"] for rows in evidence["cases"].values() for row in rows)
+    print(f"{len(names)} cases, {sum(map(len, evidence['cases'].values()))} rows, pass={passed}")
+    raise SystemExit(0 if passed else 1)
+
+
+if __name__ == "__main__":
+    main()
