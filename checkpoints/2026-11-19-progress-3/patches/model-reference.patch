+#include <cuda_runtime_api.h>
+#include <dlfcn.h>
+
+#include <cstdio>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <vector>
+
+namespace {
+
+constexpr std::size_t vocabulary = 248320;
+
+template <class Function>
+Function next_symbol(const char* name) {
+    auto symbol = reinterpret_cast<Function>(dlsym(RTLD_NEXT, name));
+    if (!symbol) {
+        std::fprintf(stderr, "model reference: cannot interpose %s\n", name);
+        std::abort();
+    }
+    return symbol;
+}
+
+auto copy = next_symbol<decltype(&cudaMemcpyAsync)>("cudaMemcpyAsync");
+auto sync = next_symbol<decltype(&cudaStreamSynchronize)>("cudaStreamSynchronize");
+
+struct Teacher {
+    Teacher() {
+        const char* path = std::getenv("MODEL_REFERENCE_TEACHER");
+        const char* trace = std::getenv("MODEL_REFERENCE_TEACHER_TRACE");
+        if (!path || !trace) {
+            std::abort();
+        }
+        std::ifstream input(path);
+        for (int token; input >> token;) {
+            if (token < 0 || token >= static_cast<int>(vocabulary)) {
+                std::abort();
+            }
+            tokens.push_back(token);
+        }
+        output.open(trace);
+        if (!input.eof() || tokens.empty() || !output) {
+            std::abort();
+        }
+    }
+
+    std::vector<int> tokens;
+    std::ofstream output;
+    std::size_t step = 0;
+};
+
+struct Readback {
+    int* host = nullptr;
+    void* device = nullptr;
+    cudaStream_t stream = nullptr;
+    bool scores = false;
+};
+
+thread_local Readback pending;
+
+}
+
+extern "C" cudaError_t cudaMemcpyAsync(void* destination, const void* source, std::size_t bytes,
+                                      cudaMemcpyKind kind, cudaStream_t stream) {
+    const auto status = copy(destination, source, bytes, kind, stream);
+    if (status != cudaSuccess) {
+        return status;
+    }
+    if (pending.host && pending.stream == stream && kind == cudaMemcpyDeviceToHost &&
+        bytes == vocabulary * sizeof(std::uint16_t)) {
+        pending.scores = true;
+    } else if (kind == cudaMemcpyDeviceToHost && bytes == sizeof(int)) {
+        pending = {static_cast<int*>(destination), const_cast<void*>(source), stream, false};
+    } else if (pending.stream == stream) {
+        pending = {};
+    }
+    return status;
+}
+
+extern "C" cudaError_t cudaStreamSynchronize(cudaStream_t stream) {
+    const auto status = sync(stream);
+    if (pending.stream != stream) {
+        return status;
+    }
+    const auto readback = pending;
+    pending = {};
+    if (status != cudaSuccess || !readback.scores) {
+        return status;
+    }
+    static Teacher teacher;
+    if (teacher.step >= teacher.tokens.size()) {
+        std::abort();
+    }
+    const int forced = teacher.tokens[teacher.step];
+    teacher.output << teacher.step++ << ' ' << *readback.host << ' ' << forced << std::endl;
+    *readback.host = forced;
+    const auto overwritten = copy(readback.device, readback.host, sizeof(int),
+                                  cudaMemcpyHostToDevice, stream);
+    return overwritten == cudaSuccess ? sync(stream) : overwritten;
+}
