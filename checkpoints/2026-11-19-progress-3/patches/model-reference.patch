+++ b/tests/model_reference/bundle.py
@@ -0,0 +1,92 @@
+import argparse
+import json
+import shutil
+from pathlib import Path
+
+from fixtures import (ARCHIVE_CASES, CHECKPOINT, CHECKPOINT_MANIFEST_SHA, HERE, SGLANG, SOURCE_SHA,
+                      VOCAB, digest, require, write_json)
+
+
+ARCHIVE_STEPS = (0, 1, 3, 4)
+
+
+def archive_case(inputs, archive, output, name):
+    case = inputs[name]
+    original = archive / f"{name}.f32"
+    receipt = json.loads((archive / f"{name}.json").read_text())
+    require(receipt["output_ids"] == case["teacher"] and
+            receipt["meta_info"]["prompt_tokens"] == len(case["prompt"]),
+            f"Archived teacher history mismatch for {name}")
+    stride = 4 * VOCAB
+    require(original.stat().st_size == stride * len(case["teacher"]),
+            f"Archived vocabulary size mismatch for {name}")
+    with original.open("rb") as source, (output / f"{name}.0.f32").open("xb") as saved:
+        for step in ARCHIVE_STEPS:
+            source.seek(stride * step)
+            saved.write(source.read(stride))
+    return {"steps": ARCHIVE_STEPS, "tokens": case["teacher"][:max(ARCHIVE_STEPS) + 1],
+            "finish": "length", "repeats": 1, "source_sha256": digest(original)}
+
+
+def captured_case(inputs, capture, output, name):
+    primary = json.loads((capture / f"{name}.0.json").read_text())
+    repeat = json.loads((capture / f"{name}.1.json").read_text())
+    require(primary == repeat, f"SGLang repeat changed emitted history for {name}")
+    tokens = primary["tokens"]
+    require(primary["prompt"] == inputs[name]["prompt"] and tokens and
+            ("teacher" not in inputs[name] or tokens == inputs[name]["teacher"]),
+            f"Invalid captured history for {name}")
+    for index in range(2):
+        filename = f"{name}.{index}.f32"
+        source = capture / filename
+        require(source.stat().st_size == len(tokens) * VOCAB * 4,
+                f"Invalid vocabulary size for {filename}")
+        shutil.copyfile(source, output / filename)
+    return {"tokens": tokens, "finish": primary["finish"],
+            "steps": list(range(len(tokens))), "repeats": 2}
+
+
+def materialize(inputs_path, archive, capture, output):
+    inputs = json.loads(inputs_path.read_text())
+    output.mkdir()
+    shutil.copyfile(inputs_path, output / "inputs.json")
+    if capture is not None:
+        receipt_path = capture / "capture.json"
+        receipt = json.loads(receipt_path.read_text())
+        expected = {"sglang_revision": SGLANG, "checkpoint_revision": CHECKPOINT,
+                    "source_sha256": SOURCE_SHA, "checkpoint_manifest_sha256": CHECKPOINT_MANIFEST_SHA,
+                    "inputs_sha256": digest(inputs_path), "repeats": 2}
+        require(all(receipt[key] == value for key, value in expected.items()),
+                "Unexpected SGLang capture provenance")
+        shutil.copyfile(receipt_path, output / "capture.json")
+    cases = {}
+    for name in inputs:
+        if name not in ARCHIVE_CASES and capture is None:
+            continue
+        function, source = ((archive_case, archive) if name in ARCHIVE_CASES
+                            else (captured_case, capture))
+        cases[name] = function(inputs, source, output, name)
+    return {"sglang_revision": SGLANG, "checkpoint_revision": CHECKPOINT,
+            "criteria_sha256": digest(HERE / "criteria.json"), "cases": cases,
+            "files": {file.name: digest(file) for file in sorted(output.iterdir())}}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("inputs", type=Path)
+    parser.add_argument("archive", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--capture", type=Path)
+    args = parser.parse_args()
+    manifest = materialize(args.inputs, args.archive, args.capture, args.output)
+    name = "manifest.json" if args.capture is not None else "archive-manifest.json"
+    path = args.output / name
+    write_json(path, manifest)
+    frozen = HERE / name
+    require(frozen.exists(), f"Unfrozen candidate manifest written at {path}")
+    require(path.read_bytes() == frozen.read_bytes(),
+            f"Resynthesized bundle differs from {name}. Compare the two manifests.")
+
+
+if __name__ == "__main__":
+    main()
