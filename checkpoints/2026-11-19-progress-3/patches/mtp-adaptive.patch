+void VerificationPolicy::observe(int accepted, int drafted) {
+    const int sample = score_scale * accepted / drafted;
+    score_ = (3 * score_ + sample) / 4;
+    if (observations_ < 2) {
+        ++observations_;
+    }
+    if (observations_ == 2) {
+        parallel_ = parallel_ ? score_ >= 45 * score_scale / 100 :
+                                score_ >= 60 * score_scale / 100;
+    }
