+bool Allocations::try_allocate(const std::function<void()>& allocate) {
+    auto& blocks = state_->blocks;
+    const auto initial_count = blocks.size();
+    const auto initial_bytes = state_->bytes;
+    try {
+        allocate();
+        return true;
+    } catch (const AllocationExhausted&) {
+        const auto last_error = cudaPeekAtLastError();
+        if (last_error == cudaErrorMemoryAllocation) {
+            cudaGetLastError();
+        } else {
+            check(last_error, "Check verifier allocation failure");
+        }
+        while (blocks.size() > initial_count) {
+            const CleanupError freed{cudaFree(blocks.back()), "Release unused verifier allocation"};
+            if (freed) {
+                state_->failure(freed);
+                state_->uncertain = freed;
+                std::swap(blocks[state_->uncertain_blocks++], blocks.back());
+                freed.raise();
+            }
+            blocks.pop_back();
+        }
+        state_->bytes = initial_bytes;
+        return false;
+    }
+}
+
