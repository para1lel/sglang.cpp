diff --git a/tests/segmented_prefill.cpp b/tests/segmented_prefill.cpp
new file mode 100644
index 0000000..f380890
--- /dev/null
+++ b/tests/segmented_prefill.cpp
@@ -0,0 +1,202 @@
+#include "sglang/decoder_batch.h"
+
+#include <algorithm>
+#include <chrono>
+#include <iostream>
+#include <iterator>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+
+namespace {
+
+using namespace sglang;
+using Selection = std::array<bool, decoder_batch_max_lanes>;
+using Clock = std::chrono::steady_clock;
+
+void require(bool condition, const std::string& message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+std::vector<int> prompt(int rows, int seed) {
+    std::vector<int> ids;
+    for (int row = 0; row < rows; ++row) {
+        ids.push_back(256 + (37 * row + seed * (997 + row * 11)) % 20000);
+    }
+    return ids;
+}
+
+struct Comparison {
+    Comparison(const Decoder& decoder, int budget)
+        : budget(budget), baseline(decoder, {budget, false}), segmented(decoder, {budget, true}) {}
+
+    void admit(int lane, int rows, int seed, int generated) {
+        DecoderOptions options;
+        options.max_new_tokens = generated;
+        const auto ids = prompt(rows, seed);
+        baseline.admit(lane, ids, options);
+        segmented.admit(lane, ids, options);
+        active[lane] = true;
+    }
+
+    void cancel(int lane) {
+        baseline.cancel(lane);
+        segmented.cancel(lane);
+        active[lane] = false;
+    }
+
+    DecoderBatchStepStats step(Selection selected);
+
+    void drain() {
+        for (int index = 0; std::any_of(active.begin(), active.end(), [](bool lane) {
+                 return lane;
+             }); ++index) {
+            require(index < 32, "Exceeded drain limit");
+            step(active);
+        }
+    }
+
+    void report(const char* name) const {
+        std::cout << name << " budget=" << budget << " steps=" << steps
+                  << " compared_bf16_values=" << values << " scored_ids=" << scored
+                  << " packed_steps=" << packed_steps << " packed_rows=" << packed_rows
+                  << " peak_workspace_bytes=" << peak_workspace
+                  << " per_request_prefill_ms=" << baseline_ms
+                  << " segmented_prefill_ms=" << segmented_ms << '\n';
+    }
+
+    const int budget;
+    DecoderBatch baseline;
+    DecoderBatch segmented;
+    Selection active{};
+    int steps = 0;
+    int scored = 0;
+    int packed_steps = 0;
+    int packed_rows = 0;
+    std::size_t values = 0;
+    std::size_t peak_workspace = 0;
+    double baseline_ms = 0;
+    double segmented_ms = 0;
+};
+
+DecoderBatchStepStats Comparison::step(Selection selected) {
+    DecoderBatchStepStats old_stats;
+    DecoderBatchStepStats new_stats;
+    DecoderBatchLogits expected;
+    DecoderBatchLogits actual;
+    const auto start = Clock::now();
+    const auto old_steps = baseline.advance_chunked(selected, &old_stats, &expected);
+    const auto midpoint = Clock::now();
+    const auto new_steps = segmented.advance_chunked(selected, &new_stats, &actual);
+    const auto end = Clock::now();
+    require(old_stats.prefill_rows == new_stats.prefill_rows, "Prefill plans differ");
+    require(old_stats.packed_prefill_rows == 0, "Control dispatched packed prefill");
+    const auto& rows = new_stats.prefill_rows;
+    const int decodes = std::count_if(new_steps.begin(), new_steps.end(),
+                                      [](const auto& result) { return result.decode; });
+    require(std::accumulate(rows.begin(), rows.end(), decodes) <= budget, "Exceeded budget");
+    require(*std::max_element(rows.begin(), rows.end()) <= decoder_batch_prefill_rows,
+            "Exceeded per-request chunk bound");
+    const int packed = new_stats.packed_prefill_rows;
+    if (std::count_if(rows.begin(), rows.end(), [](int count) { return count > 1; }) > 1) {
+        require(packed == std::accumulate(rows.begin(), rows.end(), 0,
+                                         [](int sum, int count) { return sum + (count > 1 ? count : 0); }),
+                "Missing multi-request packed dispatch");
+        ++packed_steps;
+        packed_rows += packed;
+        peak_workspace = std::max(peak_workspace, new_stats.prefill_workspace_bytes);
+        baseline_ms += std::chrono::duration<double, std::milli>(midpoint - start).count();
+        segmented_ms += std::chrono::duration<double, std::milli>(end - midpoint).count();
+    } else {
+        require(packed == 0, "Unexpected packed dispatch");
+    }
+    for (int lane = 0; lane < decoder_batch_max_lanes; ++lane) {
+        const auto& old_step = old_steps[lane];
+        const auto& new_step = new_steps[lane];
+        require(old_step.token == new_step.token && old_step.finish_reason == new_step.finish_reason
+                    && old_step.decode == new_step.decode,
+                "Committed step differs in slot " + std::to_string(lane));
+        const auto& reference = expected[lane];
+        const auto& logits = actual[lane];
+        require(reference.size() == logits.size() &&
+                    logits.size() == (new_step.token ? 248320u : 0u),
+                "Missing or unexpected dense BF16 logits");
+        const auto mismatch = std::mismatch(reference.begin(), reference.end(), logits.begin());
+        require(mismatch.first == reference.end(),
+                "BF16 mismatch at step " + std::to_string(steps) + ", slot " +
+                    std::to_string(lane) + ", token " +
+                    std::to_string(std::distance(reference.begin(), mismatch.first)));
+        values += logits.size();
+        scored += new_step.token.has_value();
+        if (new_step.finish_reason) {
+            active[lane] = false;
+        }
+    }
+    ++steps;
+    return new_stats;
+}
+
+void tied(const Decoder& decoder, int budget) {
+    Comparison comparison(decoder, budget);
+    for (int lane = 0; lane < decoder_batch_max_lanes; ++lane) {
+        comparison.admit(lane, 129, lane + 1, 3);
+    }
+    const int rows = budget / decoder_batch_max_lanes;
+    require(comparison.step(comparison.active).prefill_rows == std::array{rows, rows, rows, rows},
+            "Tied prompt unfairness");
+    comparison.drain();
+    comparison.report("tied");
+}
+
+void ragged(const Decoder& decoder, int budget) {
+    Comparison comparison(decoder, budget);
+    const std::array lengths{127, 128, 129, 7};
+    for (int lane = 0; lane < decoder_batch_max_lanes; ++lane) {
+        comparison.admit(lane, lengths[lane], lane + 11, 4);
+    }
+    const auto first = comparison.step(comparison.active);
+    if (budget == decoder_batch_max_prefill_rows) {
+        require(first.prefill_rows == std::array{127, 128, 128, 7}, "Ragged 127/128/129 plan");
+    }
+    comparison.drain();
+    comparison.report("ragged");
+}
+
+void mixed(const Decoder& decoder, int budget) {
+    Comparison comparison(decoder, budget);
+    comparison.admit(0, 17, 21, 9);
+    comparison.step(comparison.active);
+    comparison.admit(1, 255, 22, 3);
+    comparison.admit(2, 260, 23, 3);
+    comparison.admit(3, 11, 24, 3);
+    const auto first = comparison.step(comparison.active);
+    require(first.prefill_rows[0] == 0 && first.prefill_rows[1] < 255 &&
+                first.prefill_rows[2] < 260 && first.packed_prefill_rows > 0,
+            "Expected active decode plus packed partial-prefill lanes");
+    comparison.cancel(1);
+    comparison.admit(1, 129, 25, 4);
+    comparison.step({true, true, false, true});
+    comparison.drain();
+    comparison.report("mixed_cancel_reuse");
+}
+
+}
+
+int main(int argc, char** argv) {
+    if (argc != 2) {
+        return 2;
+    }
+    try {
+        const sglang::Decoder decoder(argv[1]);
+        for (int budget : {sglang::decoder_batch_prefill_rows, sglang::decoder_batch_max_prefill_rows}) {
+            tied(decoder, budget);
+            ragged(decoder, budget);
+            mixed(decoder, budget);
+        }
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
