+#include "sglang/decoder_batch.h"
+
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string_view>
+#include <vector>
+
+namespace {
+
+constexpr int lane_count = sglang::decoder_batch_max_lanes;
+
+int number(const std::string_view input) {
+    int result = 0;
+    const auto parsed = std::from_chars(input.data(), input.data() + input.size(), result);
+    if (parsed.ec != std::errc() || parsed.ptr != input.data() + input.size()) {
+        throw std::invalid_argument("Expected an integer");
+    }
+    return result;
+}
+
+std::vector<int> read_tokens(std::istream& input, int count) {
+    std::vector<int> tokens(count);
+    for (auto& token : tokens) {
+        if (!(input >> token)) {
+            throw std::runtime_error("Missing input token");
+        }
+    }
+    return tokens;
+}
+
+void run(const char* checkpoint, int rows, int policy, int steps, const char* history_path) {
+    if (steps < 1 || steps > 1024) {
+        throw std::invalid_argument("Expected 1 to 1024 steps");
+    }
+    std::ifstream history(history_path);
+    std::array<std::vector<int>, lane_count> prompts;
+    std::array<std::vector<int>, lane_count> teacher;
+    std::array<std::ofstream, lane_count> scores;
+    for (int slot = 0; slot < lane_count; ++slot) {
+        prompts[slot] = read_tokens(history, 8192);
+        teacher[slot] = read_tokens(history, steps);
+        scores[slot].open("lane-" + std::to_string(slot) + ".bf16", std::ios::binary);
+        scores[slot].exceptions(std::ios::failbit | std::ios::badbit);
+    }
+    if (int extra = 0; history >> extra || !history.eof()) {
+        throw std::runtime_error("Unexpected trailing history");
+    }
+    sglang::Decoder decoder(checkpoint, 0);
+    sglang::DecoderBatch batch(decoder, rows, policy & 1, policy & 2, policy & 4, policy & 8);
+    std::ofstream winners("winners.tsv");
+    winners.exceptions(std::ios::failbit | std::ios::badbit);
+    batch.set_replay([&](int slot, int step, int winner, const void* data, std::size_t bytes) {
+        scores[slot].write(static_cast<const char*>(data), bytes);
+        const int forced = teacher[slot].at(step);
+        winners << slot << '\t' << step << '\t' << winner << '\t' << forced << '\n';
+        return forced;
+    });
+    const sglang::DecoderOptions options{.max_new_tokens = steps};
+    for (int slot = 0; slot < lane_count; ++slot) {
+        batch.admit(slot, std::move(prompts[slot]), options);
+    }
+    std::array<bool, lane_count> selected{true, true, true, true};
+    while (std::any_of(selected.begin(), selected.end(), [](bool value) { return value; })) {
+        const auto result = batch.advance_chunked(selected);
+        for (int slot = 0; slot < lane_count; ++slot) {
+            if (result[slot].finish_reason) {
+                selected[slot] = false;
+            }
+        }
+    }
+    if (batch.request_device_allocation_bytes() != 0) {
+        throw std::runtime_error("Finished replay retains request allocations");
+    }
+}
+
+}
+
+int main(int argc, char** argv) {
+    try {
+        if (argc != 6) {
+            throw std::invalid_argument(
+                "usage: batch-replay CHECKPOINT ROWS POLICY STEPS HISTORY");
+        }
+        const int policy = number(argv[3]);
+        if (policy < 0 || policy > 15) {
+            throw std::invalid_argument("Expected a policy mask from 0 to 15");
+        }
+        run(argv[1], number(argv[2]), policy, number(argv[4]), argv[5]);
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
