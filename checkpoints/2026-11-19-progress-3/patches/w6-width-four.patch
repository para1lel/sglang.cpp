index 0000000..85fae44
--- /dev/null
+++ b/apps/schedule-parity.cpp
@@ -0,0 +1,542 @@
+#include "sglang/decoder_batch.h"
+#include "sglang/decoder_prefill.h"
+#include "sglang/schedule_parity.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <numeric>
+#include <span>
+#include <string>
+
+namespace sglang {
+namespace {
+
+using namespace decoder;
+using Clock = std::chrono::steady_clock;
+constexpr int prompt_rows = 131072;
+constexpr int teacher_steps = 16;
+constexpr int diagnostic_lane = 2;
+constexpr int width = decoder_batch_max_lanes;
+constexpr int tile_rows = 2048;
+constexpr std::size_t history_bytes = gdn_layers * gdn_history_elements * sizeof(Bf16);
+constexpr std::size_t recurrent_bytes = gdn_layers * gdn_state_elements * sizeof(float);
+constexpr std::size_t checkpoint_bytes = history_bytes + recurrent_bytes;
+
+struct Fixture {
+    std::vector<int> prompt = std::vector<int>(prompt_rows);
+    std::array<int, teacher_steps> teacher{};
+};
+
+using Fixtures = std::array<Fixture, width>;
+using Requests = std::array<Request*, width>;
+using Selection = std::array<bool, width>;
+
+template <typename Element>
+void read(std::ifstream& file, std::span<Element> data) {
+    file.read(reinterpret_cast<char*>(data.data()), static_cast<std::streamsize>(data.size_bytes()));
+    if (!file) {
+        throw std::runtime_error("Truncated parity input");
+    }
+}
+
+Fixtures load_fixtures(const std::filesystem::path& path) {
+    Fixtures fixtures;
+    std::ifstream file(path, std::ios::binary);
+    for (auto& lane : fixtures) {
+        read(file, std::span<int>(lane.prompt));
+        read(file, std::span<int>(lane.teacher));
+    }
+    if (file.peek() != std::ifstream::traits_type::eof()) {
+        throw std::runtime_error("Unexpected additional parity inputs");
+    }
+    return fixtures;
+}
+
+void transfer(void* destination, const void* source, std::size_t bytes, cudaMemcpyKind kind,
+              cudaStream_t stream) {
+    check(cudaMemcpyAsync(destination, source, bytes, kind, stream), "Copy parity buffer");
+}
+
+template <typename Element>
+void dump(const std::filesystem::path& path, const Element* data, std::size_t count) {
+    std::vector<Element> host(count);
+    check(cudaMemcpy(host.data(), data, count * sizeof(Element), cudaMemcpyDeviceToHost),
+          "Read parity buffer");
+    std::ofstream file(path, std::ios::binary);
+    file.exceptions(std::ios::badbit | std::ios::failbit);
+    file.write(reinterpret_cast<const char*>(host.data()),
+               static_cast<std::streamsize>(count * sizeof(Element)));
+}
+
+void sync(cudaStream_t stream) {
+    check(cudaStreamSynchronize(stream), "Complete parity work");
+}
+
+class GdnCheckpoint {
+public:
+    explicit GdnCheckpoint(Allocations& allocations)
+        : data_(allocations.allocate<std::byte>(width * checkpoint_bytes)) {}
+
+    void save(const Requests& requests, cudaStream_t stream) const {
+        for (int lane = 0; lane < width; ++lane) {
+            const auto state = requests[lane]->states[0];
+            transfer(history(lane), state.history, history_bytes, cudaMemcpyDeviceToDevice, stream);
+            transfer(recurrent(lane), state.recurrent, recurrent_bytes, cudaMemcpyDeviceToDevice,
+                     stream);
+        }
+    }
+
+    void restore(const Requests& requests, cudaStream_t stream) const {
+        for (int lane = 0; lane < width; ++lane) {
+            if (!requests[lane]) {
+                continue;
+            }
+            const auto state = requests[lane]->states[0];
+            transfer(state.history, history(lane), history_bytes, cudaMemcpyDeviceToDevice, stream);
+            transfer(state.recurrent, recurrent(lane), recurrent_bytes, cudaMemcpyDeviceToDevice,
+                     stream);
+        }
+    }
+
+    void save_lane(const std::filesystem::path& path, int lane) const {
+        dump(path, history(lane), checkpoint_bytes);
+    }
+
+private:
+    std::byte* history(int lane) const { return data_ + lane * checkpoint_bytes; }
+    std::byte* recurrent(int lane) const { return history(lane) + history_bytes; }
+    std::byte* data_;
+};
+
+enum class Route { host, device, graph };
+
+struct Timing {
+    const Clock::time_point first = Clock::now();
+    double ms() const {
+        return std::chrono::duration<double, std::milli>(Clock::now() - first).count();
+    }
+};
+
+void dump_kv_tail(const std::filesystem::path& path, const Request& request) {
+    std::ofstream file(path, std::ios::binary);
+    file.exceptions(std::ios::badbit | std::ios::failbit);
+    constexpr int pages = tile_rows / mxfp8_page_size;
+    constexpr int first_page = (prompt_rows - tile_rows) / mxfp8_page_size;
+    for (const auto& cache : request.caches) {
+        for (const auto* data : {cache.key_payload, cache.value_payload,
+                                 cache.key_scales, cache.value_scales}) {
+            const std::size_t per_page = data == cache.key_payload || data == cache.value_payload
+                ? mxfp8_payload_bytes_per_page : mxfp8_scale_bytes_per_page;
+            std::vector<char> host(pages * per_page);
+            check(cudaMemcpy(host.data(), data + first_page * per_page, host.size(),
+                             cudaMemcpyDeviceToHost), "Read parity KV tail");
+            file.write(host.data(), static_cast<std::streamsize>(host.size()));
+        }
+    }
+}
+
+void poison_future(const Requests& requests, int position, cudaStream_t stream) {
+    for (auto* request : requests) {
+        for (const auto& cache : request->caches) {
+            const auto payload_offset = (position / mxfp8_page_size) *
+                                        mxfp8_payload_bytes_per_page;
+            const auto scale_offset = (position / mxfp8_page_size) * mxfp8_scale_bytes_per_page;
+            for (auto* ptr : {cache.key_payload, cache.value_payload}) {
+                check(cudaMemsetAsync(ptr + payload_offset, 0x7f, mxfp8_payload_bytes_per_page,
+                                      stream), "Poison padding payload");
+            }
+            for (auto* ptr : {cache.key_scales, cache.value_scales}) {
+                check(cudaMemsetAsync(ptr + scale_offset, 0xff, mxfp8_scale_bytes_per_page, stream),
+                      "Poison padding scale");
+            }
+        }
+    }
+}
+
+}
+
+class ScheduleParityProbe {
+public:
+    ScheduleParityProbe(const Decoder& owner, Fixtures fixtures, std::filesystem::path output)
+        : model_(*owner.model_), input_(std::move(fixtures)), output_(std::move(output)),
+          batch_(owner, 8192, true, true, true, true, true), buffers_(model_.device),
+          early_(buffers_), final_(buffers_), variant_(buffers_),
+          trace_(buffers_.allocate<std::byte>(parity_trace_bytes)) {
+        buffers_.open_stream();
+        for (int lane = 0; lane < width; ++lane) {
+            batch_.admit(lane, input_[lane].prompt, {.max_new_tokens = teacher_steps + 1});
+            requests_[lane] = &batch_.parity_request(lane);
+        }
+        std::cout << "bytes requests=" << batch_.request_device_allocation_bytes()
+                  << " probe=" << buffers_.bytes() << " model=" << owner.model_device_allocation_bytes()
+                  << '\n';
+    }
+
+    void run(int rows, bool cancel_only) {
+        prefill(rows);
+        const std::array<int, width> canonical{0, 1, 2, 3};
+        if (cancel_only) {
+            projection_policy(canonical, rows);
+            cancellation(canonical, rows);
+            return;
+        }
+        const std::array<int, width> reversed{3, 2, 1, 0};
+        const std::array<int, width> single{2, 0, 1, 3};
+        const std::array<int, width> pair{2, 0, 1, 3};
+        decode("host1", single, 1, Route::host, 15, final_);
+        decode("host2", pair, 2, Route::host, 15, final_);
+        decode("host3", pair, 3, Route::host, 15, final_);
+        decode("host4", canonical, 4, Route::host, 15, final_);
+        decode("device4", canonical, 4, Route::device, 15, final_);
+        decode("graph4", canonical, 4, Route::graph, 15, final_);
+        decode("graph_permutation", reversed, 4, Route::graph, 15, final_);
+        decode("graph_neighbors", canonical, 4, Route::graph, 4, final_, true);
+        poison_future(requests_, rows, buffers_.stream());
+        decode("graph_poison", canonical, 4, Route::graph, 15, final_);
+        historical(false);
+        historical(true);
+        prefill_variant(rows);
+        decode("variant_graph4", canonical, 4, Route::graph, 15, variant_);
+        decode("variant_host2", pair, 2, Route::host, 15, variant_);
+        replace_baseline_tail(rows);
+        benchmark(canonical, rows);
+        projection_policy(canonical, rows);
+        cancellation(canonical, rows);
+    }
+
+private:
+    void prefill(int goal) {
+        const auto stream = buffers_.stream();
+        PrefillWorkspace workspace(stream, tile_rows, true, true);
+        const Timing watch;
+        for (int position = 0; position < goal; position += tile_rows) {
+            if (position == goal - tile_rows) {
+                early_.save(requests_, stream);
+            }
+            for (int lane = 0; lane < width; ++lane) {
+                model_.prefill_chunk(*requests_[lane], input_[lane].prompt.data() + position,
+                                     tile_rows, position, workspace);
+            }
+            sync(stream);
+            if ((position / tile_rows + 1) % 4 == 0) {
+                std::cout << "prefill rows=" << position + tile_rows << " ms=" << watch.ms()
+                          << " workspace=" << workspace.bytes() << '\n';
+            }
+        }
+        for (auto* request : requests_) {
+            model_.compute_logits(request->work, stream);
+        }
+        final_.save(requests_, stream);
+        sync(stream);
+        for (int lane = 0; lane < width; ++lane) {
+            dump(output_ / ("prefill." + std::to_string(lane) + ".bf16"),
+                 requests_[lane]->work.logits, vocab_size);
+        }
+        workspace.close();
+        prefix_ = goal;
+        if (goal == prompt_rows) {
+            final_.save_lane(output_ / "prefill.gdn", diagnostic_lane);
+            dump_kv_tail(output_ / "prefill.kv", *requests_[diagnostic_lane]);
+        }
+    }
+
+    void prefill_variant(int goal) {
+        const auto stream = buffers_.stream();
+        early_.restore(requests_, stream);
+        const int rows = tile_rows / 2;
+        PrefillWorkspace workspace(stream, rows, true, true);
+        for (int position = goal - tile_rows; position < goal; position += rows) {
+            for (int lane = 0; lane < width; ++lane) {
+                model_.prefill_chunk(*requests_[lane], input_[lane].prompt.data() + position,
+                                     rows, position, workspace);
+            }
+        }
+        for (auto* request : requests_) {
+            model_.compute_logits(request->work, stream);
+        }
+        variant_.save(requests_, stream);
+        workspace.close();
+        sync(stream);
+        for (int lane = 0; lane < width; ++lane) {
+            dump(output_ / ("variant_prefill." + std::to_string(lane) + ".bf16"),
+                 requests_[lane]->work.logits, vocab_size);
+        }
+        if (goal == prompt_rows) {
+            variant_.save_lane(output_ / "variant_prefill.gdn", diagnostic_lane);
+            dump_kv_tail(output_ / "variant_prefill.kv", *requests_[diagnostic_lane]);
+        }
+    }
+
+    void replace_baseline_tail(int goal) {
+        const auto stream = buffers_.stream();
+        early_.restore(requests_, stream);
+        PrefillWorkspace workspace(stream, tile_rows, true, true);
+        for (int lane = 0; lane < width; ++lane) {
+            model_.prefill_chunk(*requests_[lane], input_[lane].prompt.data() + goal - tile_rows,
+                                 tile_rows, goal - tile_rows, workspace);
+        }
+        workspace.close();
+        final_.restore(requests_, stream);
+        sync(stream);
+    }
+
+    void forward(std::span<ForwardLane> lanes, Route route) {
+        const auto stream = buffers_.stream();
+        if (route == Route::host) {
+            model_.forward(lanes.data(), static_cast<int>(lanes.size()), stream);
+            for (const auto& lane : lanes) {
+                model_.compute_logits(lane.request->work, stream);
+            }
+            return;
+        }
+        for (std::size_t index = 0; index < lanes.size(); ++index) {
+            teacher_[index].token_id = lanes[index].token_id;
+            transfer(lanes[index].request->work.argmax, &teacher_[index], sizeof(teacher_[index]),
+                     cudaMemcpyHostToDevice, stream);
+        }
+        model_.decode_batch_graph(lanes.data(), static_cast<int>(lanes.size()), buffers_,
+                                  route == Route::graph);
+    }
+
+    std::array<ForwardLane, width> decode_lanes(const std::array<int, width>& order, int step,
+                                               bool alter_neighbors) const {
+        std::array<ForwardLane, width> lanes;
+        for (int index = 0; index < width; ++index) {
+            const int lane = order[index];
+            int token = input_[lane].teacher[step];
+            if (alter_neighbors && lane != diagnostic_lane) {
+                token = input_[lane].prompt[static_cast<std::size_t>(step + lane)];
+            }
+            lanes[index] = {requests_[lane], token, prefix_ + step, TextGdnMode::decode};
+        }
+        return lanes;
+    }
+
+    void decode(const std::string& label, const std::array<int, width>& order, int count,
+                Route route, int steps, const GdnCheckpoint& checkpoint, bool neighbors = false) {
+        const auto stream = buffers_.stream();
+        buffers_.clear_graph();
+        checkpoint.restore(requests_, stream);
+        check(cudaMemsetAsync(trace_, 0, parity_trace_bytes, stream), "Clear parity tape");
+        requests_[diagnostic_lane]->work.parity_trace = trace_;
+        const Timing total;
+        for (int step = 0; step < steps; ++step) {
+            auto lanes = decode_lanes(order, step, neighbors);
+            const Timing iteration;
+            forward(std::span<ForwardLane>(lanes.data(), count), route);
+            sync(stream);
+            std::cout << "step " << label << ' ' << step << " ms=" << iteration.ms() << '\n';
+            for (int index = 0; index < count; ++index) {
+                const int lane = order[index];
+                dump(output_ / (label + "." + std::to_string(step) + "." + std::to_string(lane) +
+                                ".bf16"), requests_[lane]->work.logits, vocab_size);
+            }
+            if (step == 0) {
+                dump(output_ / (label + ".trace"), trace_, parity_trace_bytes);
+            }
+        }
+        buffers_.clear_graph();
+        requests_[diagnostic_lane]->work.parity_trace = nullptr;
+        std::cout << "decode " << label << " ms=" << total.ms() << '\n';
+    }
+
+    void historical(bool second) {
+        const auto stream = buffers_.stream();
+        buffers_.clear_graph();
+        final_.restore(requests_, stream);
+        const std::string label = second ? "historical7" : "historical0";
+        std::array<int, width> cursor{};
+        const auto advance = [&](std::span<const int> order) {
+            std::array<ForwardLane, width> lanes;
+            for (std::size_t index = 0; index < order.size(); ++index) {
+                const int lane = order[index];
+                const int step = cursor[lane];
+                lanes[index] = {requests_[lane], input_[lane].teacher[step],
+                                prefix_ + step, TextGdnMode::decode};
+            }
+            const auto route = order.size() == width ? Route::graph : Route::host;
+            if (route == Route::host) {
+                buffers_.clear_graph();
+            }
+            forward(std::span(lanes).first(order.size()), route);
+            sync(stream);
+            for (const int lane : order) {
+                dump(output_ / (label + "." + std::to_string(cursor[lane]++) + "." +
+                                std::to_string(lane) + ".bf16"),
+                     requests_[lane]->work.logits, vocab_size);
+            }
+        };
+        const std::array<int, 2> first{second ? 3 : 0, second ? 2 : 1};
+        const std::array<int, width> all = second ? std::array<int, width>{3, 2, 0, 1}
+                                                 : std::array<int, width>{3, 0, 1, 2};
+        advance(first);
+        advance(all);
+        if (second) {
+            advance(first);
+        }
+        for (int step = cursor[first[0]]; step < 15; ++step) {
+            advance(all);
+        }
+        const std::array<int, 2> last{second ? 0 : 3, second ? 1 : 2};
+        while (cursor[last[0]] < 15) {
+            advance(last);
+        }
+        buffers_.clear_graph();
+    }
+
+    void benchmark(const std::array<int, width>& order, int goal) {
+        const auto stream = buffers_.stream();
+        for (const auto route : {Route::host, Route::device, Route::graph}) {
+            for (int round = 0; round < 3; ++round) {
+                final_.restore(requests_, stream);
+                sync(stream);
+                for (int step = 0; step < 15; ++step) {
+                    auto lanes = decode_lanes(order, step, false);
+                    const Timing watch;
+                    forward(lanes, route);
+                    sync(stream);
+                    std::cout << "timing " << static_cast<int>(route) << ' ' << round << ' ' << step
+                              << " rows=" << goal << " ms=" << watch.ms() << '\n';
+                }
+                buffers_.clear_graph();
+            }
+        }
+    }
+
+    void set_packed_projection(bool packed) {
+        buffers_.clear_graph();
+        for (auto* request : requests_) {
+            request->work.parity_packed_fp8 = packed;
+        }
+    }
+
+    void projection_policy(const std::array<int, width>& order, int goal) {
+        const std::array<int, width> first{2, 0, 1, 3};
+        const std::array<int, width> second{3, 1, 2, 0};
+        decode("policy_pair_a", first, 2, Route::host, 15, final_);
+        decode("policy_pair_b", second, 2, Route::host, 15, final_);
+        set_packed_projection(true);
+        decode("policy_packed_graph4", order, 4, Route::graph, 15, final_);
+        const auto stream = buffers_.stream();
+        for (int round = 0; round < 3; ++round) {
+            for (int phase = 0; phase < 2; ++phase) {
+                const bool packed = (phase + round) % 2 == 0;
+                set_packed_projection(packed);
+                final_.restore(requests_, stream);
+                sync(stream);
+                for (int step = 0; step < 15; ++step) {
+                    auto lanes = decode_lanes(order, step, false);
+                    const Timing watch;
+                    forward(lanes, Route::graph);
+                    sync(stream);
+                    std::cout << "projection_timing " << packed << ' ' << round << ' ' << step
+                              << " rows=" << goal << " ms=" << watch.ms() << '\n';
+                }
+            }
+        }
+        set_packed_projection(false);
+    }
+
+    void cancellation(const std::array<int, width>& order, int goal) {
+        const auto stream = buffers_.stream();
+        const int cancelled = order[0];
+        const auto snapshot = [&](const std::string& phase, bool surviving) {
+            for (const int lane : order) {
+                if (!surviving || lane != cancelled) {
+                    dump(output_ / ("cancel." + phase + "." + std::to_string(lane) + ".bf16"),
+                         requests_[lane]->work.logits, vocab_size);
+                }
+            }
+        };
+        final_.restore(requests_, stream);
+        auto lanes = decode_lanes(order, 0, false);
+        forward(lanes, Route::graph);
+        sync(stream);
+        snapshot("expected_before", false);
+        buffers_.clear_graph();
+        for (int step = 1; step < 3; ++step) {
+            lanes = decode_lanes(order, step, false);
+            forward(std::span(lanes).subspan(1), Route::host);
+            sync(stream);
+            snapshot(step == 1 ? "expected_survivor" : "expected_recycled", true);
+        }
+
+        final_.restore(requests_, stream);
+        sync(stream);
+        for (int lane = 0; lane < width; ++lane) {
+            batch_.parity_cursor(lane, goal, 1, input_[lane].teacher[0]);
+        }
+        const Selection full{true, true, true, true};
+        const auto first = batch_.advance_chunked(full);
+        snapshot("before", false);
+        const auto before = batch_.request_device_allocation_bytes();
+        batch_.cancel(cancelled);
+        const auto after = batch_.request_device_allocation_bytes();
+        const auto next = batch_.advance_chunked(full);
+        snapshot("survivor", true);
+        batch_.admit(cancelled, {271, 760, 6511}, {.max_new_tokens = teacher_steps + 1});
+        const auto mixed = batch_.advance_chunked(full);
+        snapshot("recycled", true);
+        for (const int lane : order) {
+            if (first[lane].token != input_[lane].teacher[1] ||
+                (lane != cancelled && (next[lane].token != input_[lane].teacher[2] ||
+                                      mixed[lane].token != input_[lane].teacher[3]))) {
+                throw std::runtime_error("Cancellation changed the frozen greedy trajectory");
+            }
+        }
+        std::cout << "cancel before=" << before << " after=" << after
+                  << " recycled=" << batch_.request_device_allocation_bytes()
+                  << " survivor_ids=" << first[diagnostic_lane].token.value() << ','
+                  << next[diagnostic_lane].token.value() << ','
+                  << mixed[diagnostic_lane].token.value()
+                  << " replacement=" << mixed[cancelled].token.value() << '\n';
+    }
+
+    const Decoder::Model& model_;
+    Fixtures input_;
+    std::filesystem::path output_;
+    DecoderBatch batch_;
+    Allocations buffers_;
+    GdnCheckpoint early_;
+    GdnCheckpoint final_;
+    GdnCheckpoint variant_;
+    std::byte* trace_;
+    Requests requests_{};
+    std::array<TextLogitCandidate, width> teacher_{};
+    int prefix_ = 0;
+};
+
+}
+
+int main(int argc, char** argv) {
+    using namespace sglang;
+    try {
+        const bool cancel_only = argc == 6 && std::string_view(argv[5]) == "cancel";
+        if (argc != 5 && !cancel_only) {
+            throw std::invalid_argument("Usage: schedule-parity CHECKPOINT FIXTURES OUTPUT ROWS [cancel]");
+        }
+        std::cout << std::unitbuf;
+        const int rows = std::stoi(argv[4]);
+        if (rows < tile_rows || rows > prompt_rows || rows % tile_rows != 0) {
+            throw std::invalid_argument("Parity rows must be a whole number of 2048-token tiles");
+        }
+        const std::filesystem::path output(argv[3]);
+        if (!std::filesystem::create_directory(output)) {
+            throw std::invalid_argument("Parity output directory already exists");
+        }
+        auto fixtures = load_fixtures(argv[2]);
+        for (auto& lane : fixtures) {
+            lane.prompt.resize(rows);
+        }
+        const Decoder model(argv[1], 0);
+        ScheduleParityProbe probe(model, std::move(fixtures), output);
+        probe.run(rows, cancel_only);
+    } catch (const std::exception& exception) {
+        std::cerr << exception.what() << '\n';
+        return 1;
+    }
+}
