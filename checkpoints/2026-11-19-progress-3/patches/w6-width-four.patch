+++ b/include/sglang/schedule_parity.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include "sglang/decoder_internal.h"
+
+namespace sglang::decoder {
+
+enum class ParityField {
+    input_norm, residual, activation, activation_scales, first, second, third,
+    rotated_q, rotated_k, attention_raw, attention, projected, mlp_norm, gate, up,
+    swiglu, hidden, final_norm, count
+};
+
+inline constexpr std::size_t parity_stride = intermediate_size * sizeof(Bf16);
+inline constexpr std::size_t parity_layer_stride =
+    static_cast<std::size_t>(ParityField::count) * parity_stride;
+inline constexpr std::size_t parity_trace_bytes = layer_count * parity_layer_stride;
+
+template <typename Element>
+void parity_copy(Workspace& work, int layer, ParityField field, const Element* source,
+                 std::size_t count, cudaStream_t stream) {
+    if (work.parity_trace) {
+        auto* output = work.parity_trace + layer * parity_layer_stride +
+                       static_cast<std::size_t>(field) * parity_stride;
+        check(cudaMemcpyAsync(output, source, count * sizeof(Element), cudaMemcpyDeviceToDevice,
+                              stream), "Record schedule parity operand");
+    }
+}
+
+}
