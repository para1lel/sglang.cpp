+    return *state_->storage->slots.at(slot)->request;
+}
+
+void DecoderBatch::parity_cursor(int slot, int position, int generated, int token) {
+    state_->execution.clear_graph();
+    auto& lane = *state_->storage->slots.at(slot);
+    lane.position = position;
+    lane.generated = generated;
+    lane.last_token = token;
+    const TextLogitCandidate candidate{0.0f, token};
+    const auto stream = state_->execution.stream();
+    check(cudaMemcpyAsync(lane.request->work.argmax, &candidate, sizeof(candidate),
+                          cudaMemcpyHostToDevice, stream), "Set parity pending token");
+    check(cudaStreamSynchronize(stream), "Complete parity cursor update");
+}
