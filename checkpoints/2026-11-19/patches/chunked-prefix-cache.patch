diff -ruN selected/src/decoder_prefix_cache.cpp source/src/decoder_prefix_cache.cpp
--- selected/src/decoder_prefix_cache.cpp	1970-01-01 08:00:00.000000000 +0800
+++ source/src/decoder_prefix_cache.cpp	2026-11-19 01:56:40.593584652 +0800
@@ -0,0 +1,181 @@
+#include "sglang/decoder_prefix_cache.h"
+
+#include <algorithm>
+#include <utility>
+
+namespace sglang::decoder {
+namespace {
+
+constexpr std::size_t history_count = gdn_layers * gdn_history_elements;
+constexpr std::size_t recurrent_count = gdn_layers * gdn_state_elements;
+
+void copy_state(TextGdnState destination, TextGdnState source, cudaStream_t stream) {
+    check(cudaMemcpyAsync(destination.history, source.history, history_count * sizeof(Bf16),
+                          cudaMemcpyDeviceToDevice, stream), "Copy GDN history checkpoint");
+    check(cudaMemcpyAsync(destination.recurrent, source.recurrent, recurrent_count * sizeof(float),
+                          cudaMemcpyDeviceToDevice, stream), "Copy GDN recurrent checkpoint");
+}
+
+template <typename Items>
+std::size_t live(const Items& items) {
+    return std::count_if(items.begin(), items.end(), [](const auto& item) {
+        return item.use_count() > 1;
+    });
+}
+
+}
+
+BatchPrefixCache::BatchPrefixCache(int device, const DecoderBatchCacheOptions& options)
+    : memory_(device), limit_(options.checkpoints),
+      arena_(allocate_kv_storage(memory_, options.pages)) {
+    pages_.reserve(options.pages);
+    for (int page = 0; page < options.pages; ++page) {
+        pages_.push_back(std::make_shared<std::int32_t>(page));
+    }
+    const auto state_count = limit_ + decoder_batch_max_lanes;
+    auto* history = memory_.allocate<Bf16>(history_count * state_count);
+    auto* recurrent = memory_.allocate<float>(recurrent_count * state_count);
+    for (int index = 0; index < state_count; ++index) {
+        states_.push_back(std::make_shared<TextGdnState>(
+            TextGdnState{history + index * history_count, recurrent + index * recurrent_count}));
+    }
+    entries_.reserve(limit_);
+}
+
+PrefixEntry BatchPrefixCache::reserve(const std::vector<int>& prompt, int capacity) {
+    auto hit = entries_.end();
+    for (auto it = entries_.begin(); it != entries_.end(); ++it) {
+        if (it->key.size() < prompt.size() &&
+            (hit == entries_.end() || hit->key.size() < it->key.size()) &&
+            std::equal(it->key.begin(), it->key.end(), prompt.begin())) {
+            hit = it;
+        }
+    }
+    PrefixEntry lease;
+    if (hit != entries_.end()) {
+        lease = *hit;
+    }
+    const auto page_count = static_cast<std::size_t>((capacity - 1) / mxfp8_page_size + 1);
+    if (page_count > pages_.size()) {
+        throw std::length_error("Prefix KV arena cannot fit this request");
+    }
+    const auto needed = page_count - lease.pages.size();
+    lease.pages.reserve(page_count);
+    std::vector<long> cache_refs(pages_.size(), 1);
+    for (const auto& entry : entries_) {
+        for (const auto& page : entry.pages) {
+            ++cache_refs[*page];
+        }
+    }
+    const auto available = std::count_if(pages_.begin(), pages_.end(), [&](const auto& page) {
+        return page.use_count() == cache_refs[*page];
+    });
+    if (static_cast<std::size_t>(available) < needed) {
+        throw std::length_error("Prefix KV arena is full with active requests");
+    }
+    if (hit != entries_.end()) {
+        std::rotate(hit, hit + 1, entries_.end());
+    }
+    while (pages_.size() - live(pages_) < needed) {
+        evict();
+    }
+    for (const auto& page : pages_) {
+        if (lease.pages.size() == page_count) {
+            break;
+        }
+        if (page.use_count() == 1) {
+            lease.pages.push_back(page);
+        }
+    }
+    return lease;
+}
+
+void BatchPrefixCache::initialize(Request& request, const PrefixEntry& lease, cudaStream_t stream) {
+    std::vector<std::int32_t> table;
+    table.reserve(lease.pages.size());
+    for (const auto& page : lease.pages) {
+        table.push_back(*page);
+    }
+    request.initialize_shared_kv(arena_, std::move(table), stream);
+    if (lease.state) {
+        copy_state(request.states.front(), *lease.state, stream);
+    } else {
+        request.reset(stream);
+    }
+}
+
+PrefixEntry BatchPrefixCache::checkpoint(const std::vector<int>& prompt, const PrefixEntry& lease,
+                                        int depth) {
+    const auto state = std::find_if(states_.begin(), states_.end(), [](const auto& block) {
+        return block.use_count() == 1;
+    });
+    if (state == states_.end()) {
+        throw std::logic_error("Prefix staging snapshot pool invariant");
+    }
+    return {{prompt.begin(), prompt.begin() + depth},
+            {lease.pages.begin(), lease.pages.begin() + depth / mxfp8_page_size}, *state};
+}
+
+void BatchPrefixCache::copy_checkpoint(const PrefixEntry& entry, const Request& request,
+                                       cudaStream_t stream) {
+    copy_state(*entry.state, request.states.front(), stream);
+}
+
+void BatchPrefixCache::publish(PrefixEntry entry) {
+    const auto old = std::find_if(entries_.begin(), entries_.end(), [&](const auto& candidate) {
+        return entry.key == candidate.key;
+    });
+    if (old != entries_.end()) {
+        std::rotate(old, old + 1, entries_.end());
+        return;
+    }
+    if (static_cast<int>(entries_.size()) == limit_) {
+        evict();
+    }
+    entries_.push_back(std::move(entry));
+    ++counters.published;
+}
+
+void BatchPrefixCache::evict() {
+    entries_.erase(entries_.begin());
+    ++counters.evictions;
+}
+
+DecoderBatchCacheStats BatchPrefixCache::stats() const {
+    auto value = counters;
+    value.live_pages = live(pages_);
+    value.live_checkpoints = live(states_);
+    value.indexed = entries_.size();
+    value.arena_bytes = memory_.bytes();
+    return value;
+}
+
+std::vector<std::uint8_t> BatchPrefixCache::bytes(const std::vector<int>& prefix) const {
+    const auto hit = std::find_if(entries_.begin(), entries_.end(), [&](const auto& entry) {
+        return entry.key == prefix;
+    });
+    if (hit == entries_.end()) {
+        return {};
+    }
+    std::vector<std::uint8_t> packed(history_count * sizeof(Bf16) + recurrent_count * sizeof(float) +
+        hit->pages.size() * full_attention_layers * 2 *
+            (mxfp8_payload_bytes_per_page + mxfp8_scale_bytes_per_page));
+    auto* output = packed.data();
+    const auto read = [&](const void* input, std::size_t size) {
+        check(cudaMemcpy(output, input, size, cudaMemcpyDeviceToHost), "Inspect prefix checkpoint");
+        output += size;
+    };
+    read(hit->state->history, history_count * sizeof(Bf16));
+    read(hit->state->recurrent, recurrent_count * sizeof(float));
+    for (const auto& cache : arena_) {
+        for (const auto& page : hit->pages) {
+            read(cache.key_payload + *page * mxfp8_payload_bytes_per_page, mxfp8_payload_bytes_per_page);
+            read(cache.value_payload + *page * mxfp8_payload_bytes_per_page, mxfp8_payload_bytes_per_page);
+            read(cache.key_scales + *page * mxfp8_scale_bytes_per_page, mxfp8_scale_bytes_per_page);
+            read(cache.value_scales + *page * mxfp8_scale_bytes_per_page, mxfp8_scale_bytes_per_page);
+        }
+    }
+    return packed;
+}
+
+}
