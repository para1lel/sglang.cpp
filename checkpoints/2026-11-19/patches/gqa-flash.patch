+#include "sglang/decoder_internal.h"
+#include "sglang/mxfp8_flash.h"
+
+#include <algorithm>
+
+namespace sglang {
+namespace {
+
+using namespace decoder;
+
+struct Chunk {
+    PrefillWorkspace& work;
+    int position;
+    int rows;
+    cudaStream_t stream;
+    DecoderPrefill method;
+
+    TextFp8ActivationView quantize(const Bf16* input, int width) const {
+        check(text_quantize_fp8_rows(input, width, rows, work.activation, stream),
+              "Quantize prefill projection input");
+        return {work.activation.values, work.activation.scales};
+    }
+
+    void project(Fp8Weight weight, TextFp8ActivationView input, Bf16* output) const {
+        check(text_fp8_gemv_rows(weight.values, weight.scales, input, weight.rows, weight.columns,
+                                 rows, output, stream), "Run exact prefill FP8 projection");
+    }
+
+    void project(Bf16Weight weight, const Bf16* input, Bf16* output) const {
+        check(text_bf16_gemv_rows(weight.values, input, weight.rows, weight.columns,
+                                  rows, output, stream), "Run exact prefill BF16 projection");
+    }
+
+    void gdn(const GdnLayer& layer, TextGdnState state) const {
+        const auto input = quantize(work.normalized, hidden_size);
+        project(layer.qkv, input, work.gdn_qkv);
+        project(layer.z, input, work.gdn_z);
+        project(layer.b, work.normalized, work.gdn_b);
+        project(layer.a, work.normalized, work.gdn_a);
+        check(text_gdn_forward(rows, TextGdnMode::prefill, work.gdn_qkv, work.gdn_z, work.gdn_b,
+                               work.gdn_a, layer.recurrent, state, work.gdn_scratch,
+                               text_gdn_workspace_bytes(prefill_chunk_rows), work.attention, stream),
+              "Advance prefill Gated DeltaNet state");
+        project(layer.output, quantize(work.attention, text_gdn_value_width), work.projected_attention);
+    }
+
+    void gqa(const GqaLayer& layer, Mxfp8KvCache cache, Mxfp8PageTable pages) const {
+        const auto input = quantize(work.normalized, hidden_size);
+        project(layer.q_gate, input, work.q_gate);
+        project(layer.key, input, work.keys);
+        project(layer.value, input, work.values);
+        check(text_gqa_preprocess(position, rows, work.q_gate, work.keys, layer.query_norm,
+                                  layer.key_norm, work.rope_queries, work.rope_keys, stream),
+              "Normalize and rotate prefill Q/K");
+        check(mxfp8_kv_append(cache, pages, position, rows, work.rope_keys, work.values, stream),
+              "Append prefill MXFP8 KV");
+        if (method == DecoderPrefill::mxfp8_flash) {
+            check(mxfp8_flash_prefill(cache, pages, position + rows, position, rows,
+                                      work.rope_queries, work.attention,
+                                      Mxfp8FlashWeights::compensated, nullptr, 0, stream),
+                  "Read causal MXFP8 FlashAttention");
+        } else {
+            check(mxfp8_gqa_prefill(cache, pages, position + rows, position, rows,
+                                    work.rope_queries, work.attention, stream),
+                  "Read exact causal tiled MXFP8 attention");
+        }
+        check(text_gqa_postgate(rows, work.q_gate, work.attention, work.attention, stream),
+              "Gate prefill grouped-query attention");
+        project(layer.output, quantize(work.attention, text_gqa_q_width), work.projected_attention);
+    }
+
+    void mlp(const Layer& layer) const {
+        const auto input = quantize(work.normalized, hidden_size);
+        project(layer.mlp_gate, input, work.mlp_gate);
+        project(layer.mlp_up, input, work.mlp_up);
+        check(text_swiglu(work.mlp_gate, work.mlp_up, rows * intermediate_size,
+                          work.mlp_gate, stream), "Apply prefill SwiGLU");
+        project(layer.mlp_down, quantize(work.mlp_gate, intermediate_size), work.hidden);
+    }
+};
+
+}
+
+decoder::PrefillWorkspace::PrefillWorkspace(Allocations& memory)
+    : tokens(memory.allocate<int>(prefill_chunk_rows)),
+      hidden(memory.allocate<Bf16>(prefill_chunk_rows * hidden_size)),
+      normalized(memory.allocate<Bf16>(prefill_chunk_rows * hidden_size)),
+      residual(memory.allocate<Bf16>(prefill_chunk_rows * hidden_size)),
+      projected_attention(memory.allocate<Bf16>(prefill_chunk_rows * hidden_size)),
+      attention(memory.allocate<Bf16>(prefill_chunk_rows * std::max(text_gdn_value_width, text_gqa_q_width))),
+      mlp_gate(memory.allocate<Bf16>(prefill_chunk_rows * intermediate_size)),
+      mlp_up(memory.allocate<Bf16>(prefill_chunk_rows * intermediate_size)),
+      q_gate(memory.allocate<Bf16>(prefill_chunk_rows * text_gqa_q_gate_width)),
+      keys(memory.allocate<Bf16>(prefill_chunk_rows * text_gqa_kv_width)),
+      values(memory.allocate<Bf16>(prefill_chunk_rows * text_gqa_kv_width)),
+      rope_queries(memory.allocate<Bf16>(prefill_chunk_rows * text_gqa_q_width)),
+      rope_keys(memory.allocate<Bf16>(prefill_chunk_rows * text_gqa_kv_width)),
+      gdn_qkv(memory.allocate<Bf16>(prefill_chunk_rows * text_gdn_qkv_width)),
+      gdn_z(memory.allocate<Bf16>(prefill_chunk_rows * text_gdn_value_width)),
+      gdn_b(memory.allocate<Bf16>(prefill_chunk_rows * text_gdn_value_heads)),
+      gdn_a(memory.allocate<Bf16>(prefill_chunk_rows * text_gdn_value_heads)),
+      gdn_scratch(memory.allocate<Bf16>(text_gdn_workspace_bytes(prefill_chunk_rows) / sizeof(Bf16))),
+      activation{memory.allocate<std::uint8_t>(prefill_chunk_rows * intermediate_size),
+                 memory.allocate<float>(prefill_chunk_rows * text_fp8_group_count(intermediate_size))} {}
+
+bool Decoder::Model::prefill(Request& request, const std::vector<int>& prompt,
+                             DecoderPrefill method, const std::function<bool()>& cancelled) const {
+    const auto stream = request.memory.stream();
+    const int count = static_cast<int>(prompt.size());
+    int last_rows = 0;
+    for (int position = 0; position < count; position += last_rows) {
+        if (cancelled()) {
+            return false;
+        }
+        last_rows = std::min(prefill_chunk_rows, count - position);
+        if (last_rows == 1) {
+            forward(request, prompt[position], position, TextGdnMode::prefill);
+            continue;
+        }
+        if (!request.prefill_work) {
+            request.prefill_work = std::make_unique<PrefillWorkspace>(request.memory);
+        }
+        auto& work = *request.prefill_work;
+        auto& tokens = request.memory.transfers().prompt_tokens;
+        if (position == 0) {
+            tokens = prompt;
+        }
+        check(cudaMemcpyAsync(work.tokens, tokens.data() + position, last_rows * sizeof(int),
+                              cudaMemcpyHostToDevice, stream), "Upload prefill chunk tokens");
+        check(text_embedding_rows(embedding, vocab_size, hidden_size, work.tokens, last_rows,
+                                   work.residual, stream), "Gather prefill embeddings");
+        const Chunk chunk{work, position, last_rows, stream, method};
+        int gqa_index = 0;
+        int gdn_index = 0;
+        for (int index = 0; index < layer_count; ++index) {
+            const auto& layer = layers[index];
+            const auto* input = index == 0 ? work.residual : work.hidden;
+            auto* residual = index == 0 ? nullptr : work.residual;
+            check(text_rms_norm_rows(input, residual, layer.input_norm, hidden_size, last_rows,
+                                     work.normalized, residual, stream), "Normalize prefill layer input");
+            if (is_full_attention(index)) {
+                chunk.gqa(layer.gqa, request.caches[gqa_index++], request.pages);
+            } else {
+                chunk.gdn(layer.gdn, request.states[gdn_index++]);
+            }
+            check(text_rms_norm_rows(work.projected_attention, work.residual, layer.attention_norm,
+                                     hidden_size, last_rows, work.normalized, work.residual, stream),
+                  "Normalize prefill post-attention residual");
+            chunk.mlp(layer);
+        }
+    }
+    if (last_rows > 1) {
+        const auto& work = *request.prefill_work;
+        const auto last = (last_rows - 1) * hidden_size;
+        const auto bytes = hidden_size * sizeof(Bf16);
+        check(cudaMemcpyAsync(request.work.hidden, work.hidden + last, bytes,
+                              cudaMemcpyDeviceToDevice, stream), "Stage final prefill hidden row");
+        check(cudaMemcpyAsync(request.work.residual, work.residual + last, bytes,
+                              cudaMemcpyDeviceToDevice, stream), "Stage final prefill residual row");
+    }
+    return true;
+}
+
