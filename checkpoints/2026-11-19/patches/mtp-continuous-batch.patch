+#include "sglang/decoder_internal.h"
+
+#include <cstdio>
+#include <utility>
+
+namespace sglang::decoder {
+
+BatchVerification::BatchVerification(int device, int rows) : memory(device) {
+    static_assert(batch_verify_rows == text_gdn_max_verify_rows);
+    auto* history = memory.allocate<Bf16>(gdn_layers * gdn_history_elements);
+    auto* recurrent = memory.allocate<float>(gdn_layers * gdn_state_elements);
+    const int qkv = rows * text_gdn_qkv_width;
+    const int gates = rows * text_gdn_value_heads;
+    auto* inputs = memory.allocate<Bf16>(gdn_layers * (2 * qkv + 2 * gates));
+    for (int index = 0; index < gdn_layers; ++index) {
+        alternate_[index] = {history + index * gdn_history_elements,
+                             recurrent + index * gdn_state_elements};
+        auto* layer = inputs + index * (2 * qkv + 2 * gates);
+        replay_[index] = {layer, layer + qkv, layer + 2 * qkv, layer + 2 * qkv + gates};
+    }
+    z_ = memory.allocate<Bf16>(rows * text_gdn_value_width);
+    observable_ = memory.allocate<Bf16>(rows * text_gdn_value_width);
+    attention_ = memory.allocate<Bf16>(rows * text_gdn_value_width);
+    winners_ = memory.allocate<TextLogitCandidate>(rows);
+    for (int row = 0; row < rows; ++row) {
+        work[row].emplace(memory, attention_ + row * text_gdn_value_width, winners_ + row);
+    }
+    void* host = nullptr;
+    check(cudaMallocHost(&host, rows * sizeof(*host_winners_)),
+          "Allocate pinned batch verifier winners");
+    host_winners_ = static_cast<TextLogitCandidate*>(host);
+}
+
+BatchVerification::~BatchVerification() {
+    if (const auto status = cudaFreeHost(host_winners_); status != cudaSuccess) {
+        std::fprintf(stderr, "Release batch verifier winners: %s\n", cudaGetErrorString(status));
+    }
+}
+
+void BatchVerification::bind_gdn(int layer, int rows) {
+    const auto& inputs = replay_[layer];
+    for (int row = 0; row < rows; ++row) {
+        work[row]->gdn_qkv = inputs.qkv + row * text_gdn_qkv_width;
+        work[row]->gdn_z = z_ + row * text_gdn_value_width;
+        work[row]->gdn_b = inputs.b + row * text_gdn_value_heads;
+        work[row]->gdn_a = inputs.a + row * text_gdn_value_heads;
+    }
+}
+
+void BatchVerification::advance_gdn(Request& request, int layer, int rows, TextGdnWeights weights,
+                                     cudaStream_t stream) {
+    check(text_gdn_verify_tail(rows, replay_[layer].inputs(), z_, weights, request.states[layer],
+                               alternate_[layer], observable_, attention_, stream),
+          "Verify batch Gated DeltaNet candidates");
+}
+
+int BatchVerification::commit(Request& request, const std::array<Layer, layer_count>& layers,
+                               int rows, int committed, cudaStream_t stream) {
+    if (committed == 0) {
+        return 0;
+    }
+    if (committed < rows) {
+        int state = 0;
+        for (int layer = 0; layer < layer_count; ++layer) {
+            if (!is_full_attention(layer)) {
+                check(text_gdn_replay_prefix(committed, replay_[state].inputs(),
+                                             layers[layer].gdn.recurrent, request.states[state],
+                                             alternate_[state], stream), "Replay GDN prefix");
+                ++state;
+            }
+        }
+    }
+    std::swap(request.states, alternate_);
+    return committed < rows ? committed : 0;
+}
+
+void BatchVerification::transfer(int rows, cudaStream_t stream) {
+    check(cudaMemcpyAsync(host_winners_, winners_, rows * sizeof(*winners_),
+                           cudaMemcpyDeviceToHost, stream), "Read batch verifier winners");
+}
+
+int BatchVerification::token(int row) const {
+    const int id = host_winners_[row].token_id;
+    if (id < 0 || id >= vocab_size) {
+        throw std::runtime_error("Batch verifier did not return a valid token ID");
+    }
+    return id;
+}
+
+}
