+struct Decoder::Model::MtpGeneration {
+    const Model& model;
+    Request& target;
+    MtpDraftRequest& draft;
+    const DecoderOptions& options;
+    const DecoderCallbacks& callbacks;
+    DecoderResult& result;
+    std::vector<DecoderLogit> ranking{};
