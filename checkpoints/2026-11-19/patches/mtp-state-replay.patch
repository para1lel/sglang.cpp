+void TargetVerification::advance_gdn(int layer, TextGdnWeights weights) {
+    const auto initial = request_.states[layer];
+    const auto stream = request_.memory.stream();
+    const auto& work = work_.front();
+    if (replay_) {
+        auto& saved = replay_layers_[layer];
+        saved.weights = weights;
+        check(text_gdn_verify_tail(pending_rows_, saved.inputs, work.gdn_z, weights, initial,
+                                   checkpoints_.front()[layer], work.gdn_scratch,
+                                   work.attention, stream),
+              "Advance target GDN and retain its tail");
+        return;
+    }
+    TextGdnCheckpoints checkpoints;
+    for (int index = 0; index < pending_rows_; ++index) {
+        checkpoints.rows[index] = checkpoints_[index][layer];
+    }
+    check(text_gdn_verify(pending_rows_, work.gdn_qkv, work.gdn_z, work.gdn_b, work.gdn_a,
+                          weights, initial, checkpoints, work.gdn_scratch,
+                          text_gdn_workspace_bytes(pending_rows_), work.attention, stream),
+          "Advance and checkpoint target verification GDN");
+}
+
+void TargetVerification::replay_prefix(int count) {
+    const auto stream = request_.memory.stream();
+    for (int layer = 0; layer < gdn_layers; ++layer) {
+        const auto& saved = replay_layers_[layer];
+        check(text_gdn_replay_prefix(count, saved.inputs, saved.weights, request_.states[layer],
+                                     checkpoints_.front()[layer], stream),
+              "Recompute committed target GDN prefix");
+    }
+    replayed_rows_ += count;
+}
+
+void TargetVerification::read() {
+    if (pending_rows_ == 0 || ready_) {
+        throw std::logic_error("No target verification results pending");
+    }
+    const auto stream = request_.memory.stream();
+    check(cudaMemcpyAsync(host_winners_, device_winners_,
+                          pending_rows_ * sizeof(TextLogitCandidate), cudaMemcpyDeviceToHost,
+                          stream), "Read target verification winners");
+    if (host_logits_) {
+        for (int index = 0; index < pending_rows_; ++index) {
+            check(cudaMemcpyAsync(host_logits_ + index * vocab_size, work_[index].logits,
+                                  vocab_size * sizeof(Bf16), cudaMemcpyDeviceToHost, stream),
+                  "Read target verification logits");
+        }
+    }
+    check(cudaStreamSynchronize(stream), "Complete target verification round");
+    ready_ = true;
+}
+
+void TargetVerification::commit(int processed_rows) {
+    if (!ready_ || processed_rows < 0 || processed_rows > pending_rows_) {
+        throw std::logic_error("Invalid target verification commit");
+    }
+    if (processed_rows != 0) {
+        if (replay_ && processed_rows < pending_rows_) {
+            replay_prefix(processed_rows);
+        }
+        publish_checkpoint(request_, checkpoints_[replay_ ? 0 : processed_rows - 1]);
+        valid_prefix_ += processed_rows;
+    }
+    ready_ = false;
+    pending_rows_ = 0;
+}
+
+int TargetVerification::winner(int index) const {
+    const int token = host_winners_[index].token_id;
+    if (token < 0 || token >= vocab_size) {
+        throw std::runtime_error("Target verification winner falls outside vocabulary");
+    }
+    return token;
+}
+
+const Bf16* TargetVerification::logits(int index) const {
+    return host_logits_ ? host_logits_ + index * vocab_size : nullptr;
+}
