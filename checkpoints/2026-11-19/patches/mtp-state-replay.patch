+
+void TargetVerification::bind_gdn(int layer) {
+    if (!replay_) {
+        return;
+    }
+    const auto rows = replay_layers_[layer].inputs;
+    for (int index = 0; index < pending_rows_; ++index) {
+        work_[index].gdn_qkv = rows.qkv + index * text_gdn_qkv_width;
+        work_[index].gdn_b = rows.b + index * text_gdn_value_heads;
+        work_[index].gdn_a = rows.a + index * text_gdn_value_heads;
+    }
