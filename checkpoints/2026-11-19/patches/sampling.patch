+#include "sglang/decoder_sampling.h"
+
+#include <algorithm>
+#include <cmath>
+#include <numeric>
+#include <random>
+#include <stdexcept>
+
+namespace sglang::decoder {
+namespace {
+
+constexpr double sampling_epsilon = 1e-6;
+
+std::uint64_t request_seed(const std::optional<std::int64_t>& seed) {
+    if (seed) {
+        return static_cast<std::uint64_t>(*seed);
+    }
+    std::random_device entropy;
+    return (static_cast<std::uint64_t>(entropy()) << 32) | entropy();
+}
+
+double sample_uniform(std::uint64_t seed, std::uint64_t position) {
+    std::uint64_t bits = seed + 0x9e3779b97f4a7c15ULL * (position + 1);
+    bits = (bits ^ (bits >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    bits = (bits ^ (bits >> 27)) * 0x94d049bb133111ebULL;
+    return static_cast<double>((bits ^ (bits >> 31)) >> 11) * 0x1.0p-53;
+}
+
+float finite_logit(float logit) {
+    if (std::isfinite(logit)) {
+        return logit;
+    }
+    return std::isinf(logit) && logit > 0 ? 1e30f : -1e30f;
+}
+
+}
+
+bool uses_sampling(const DecoderOptions& options) {
+    return options.temperature >= sampling_epsilon;
+}
+
+void validate_sampling(const DecoderOptions& options) {
+    if (!std::isfinite(options.temperature) || options.temperature < 0) {
+        throw std::invalid_argument("temperature must be a finite nonnegative number");
+    }
+    if (!(options.top_p > 0 && options.top_p <= 1)) {
+        throw std::invalid_argument("top_p must be in (0, 1]");
+    }
+    if (uses_sampling(options) && options.top_k != -1 && options.top_k < 1) {
+        throw std::invalid_argument("top_k must be -1 or at least 1");
+    }
+    if (uses_sampling(options) && options.mtp_steps != 0) {
+        throw std::invalid_argument("MTP requires greedy generation (temperature < 1e-6)");
+    }
+}
+
+RequestSampler::RequestSampler(const DecoderOptions& options, int vocabulary)
+    : temperature_(options.temperature), top_p_(options.top_p), seed_(request_seed(options.seed)),
+      top_k_(options.top_k == -1 ? vocabulary : std::min<std::int64_t>(options.top_k, vocabulary)),
+      logits_(vocabulary), ranking_(top_k_ < vocabulary || top_p_ < 1 ? vocabulary : 0),
+      weights_(top_k_) {}
+
+int RequestSampler::sample(std::uint64_t position) {
+    std::transform(logits_.begin(), logits_.end(), logits_.begin(), finite_logit);
+    const auto maximum = std::max_element(logits_.begin(), logits_.end());
+    if (top_k_ == 1) {
+        return static_cast<int>(maximum - logits_.begin());
+    }
+    const auto weight = [&](float logit) {
+        return std::exp((static_cast<double>(logit) - *maximum) / temperature_);
+    };
+    const auto before = [&](int left, int right) {
+        return logits_[left] == logits_[right] ? left < right : logits_[left] > logits_[right];
+    };
+    if (!ranking_.empty()) {
+        std::iota(ranking_.begin(), ranking_.end(), 0);
+        if (top_k_ == static_cast<int>(ranking_.size())) {
+            std::sort(ranking_.begin(), ranking_.end(), before);
+        } else {
+            std::partial_sort(ranking_.begin(), ranking_.begin() + top_k_, ranking_.end(), before);
+        }
+    }
+    const auto token = [&](int rank) { return ranking_.empty() ? rank : ranking_[rank]; };
+    long double cutoff = 0;
+    if (top_p_ < 1) {
+        for (const float logit : logits_) {
+            cutoff += weight(logit);
+        }
+        cutoff *= top_p_;
+    }
+    long double mass = 0;
+    int kept = 0;
+    for (; kept < top_k_ && (top_p_ == 1 || mass <= cutoff); ++kept) {
+        weights_[kept] = weight(logits_[token(kept)]);
+        mass += weights_[kept];
+    }
+    const long double draw = sample_uniform(seed_, position) * mass;
+    long double cumulative = 0;
+    for (int rank = 0; rank < kept; ++rank) {
+        cumulative += weights_[rank];
+        if (draw < cumulative) {
+            return token(rank);
+        }
+    }
+    return static_cast<int>(maximum - logits_.begin());
+}
+
+}
