+MultimodalResult Decoder::generate_multimodal(
+    const std::vector<int>& prompt_token_ids, const std::vector<RotaryPosition>& prompt_positions,
+    const std::vector<VisualEmbeddingSpan>& visual_spans, int rotary_delta, int steps,
+    const std::vector<int>& teacher_tokens) const {
+    const auto& prompt = prompt_token_ids;
+    DecoderOptions options;
+    options.max_new_tokens = steps;
+    validate_request(prompt, options, false);
+    if (steps < 1 || prompt_positions.size() != prompt.size() ||
+        (!teacher_tokens.empty() && teacher_tokens.size() != static_cast<std::size_t>(steps - 1)) ||
+        std::any_of(teacher_tokens.begin(), teacher_tokens.end(),
+                    [](int id) { return id < 0 || id >= vocab_size; })) {
+        throw std::invalid_argument("Invalid multimodal generation inputs");
+    }
+    int largest_axis = -1;
+    for (const auto& axes : prompt_positions) {
+        for (const int axis : axes) {
+            if (axis < 0 || axis >= text_attention_max_tokens) {
+                throw std::invalid_argument("Multimodal rotary position out of range");
+            }
+            largest_axis = std::max(largest_axis, axis);
+        }
+    }
+    const int prompt_count = static_cast<int>(prompt.size());
+    if (rotary_delta != largest_axis + 1 - prompt_count ||
+        largest_axis + steps > text_attention_max_tokens) {
+        throw std::invalid_argument("Invalid multimodal rotary delta");
+    }
+    std::vector<const Bf16*> embeddings(prompt.size(), nullptr);
+    int previous_end = 0;
+    for (const auto& span : visual_spans) {
+        if (!span.device_embeddings || span.prompt_start < previous_end ||
+            span.prompt_start > prompt_count || span.rows < 1 ||
+            span.rows > prompt_count - span.prompt_start) {
+            throw std::invalid_argument("Invalid or overlapping visual embedding span");
+        }
+        for (int row = 0; row < span.rows; ++row) {
+            embeddings[span.prompt_start + row] = span.device_embeddings + row * hidden_size;
+        }
+        previous_end = span.prompt_start + span.rows;
+    }
+    DeviceScope selected_device(model_->device);
+    Request request(model_->device, prompt_count + steps - 1, model_->memory);
+    request.reset();
+    auto& host_logits = request.memory.transfers().logits;
+    host_logits.resize(vocab_size);
+    const auto stream = request.memory.stream();
+    for (int position = 0; position < prompt_count; ++position) {
+        const ForwardLane lane{&request, prompt[position], position, TextGdnMode::prefill,
+                               embeddings[position], &prompt_positions[position]};
+        model_->forward(&lane, 1, stream);
+    }
+    MultimodalResult result;
+    result.output_token_ids.reserve(steps);
+    result.logits.resize(static_cast<std::size_t>(vocab_size) * steps);
+    int winner = -1;
+    for (int step = 0; step < steps; ++step) {
+        if (step > 0) {
+            const int position = prompt_count + step - 1;
+            const int rotary = position + rotary_delta;
+            const RotaryPosition axes{rotary, rotary, rotary};
+            const int token = teacher_tokens.empty() ? winner : teacher_tokens[step - 1];
+            const ForwardLane lane{&request, token, position, TextGdnMode::decode, nullptr, &axes};
+            model_->forward(&lane, 1, stream);
+        }
+        model_->compute_logits(request);
+        winner = read_step(request);
+        result.output_token_ids.push_back(winner);
+        std::transform(host_logits.begin(), host_logits.end(),
+                       result.logits.begin() + static_cast<std::size_t>(step) * vocab_size,
+                       [](Bf16 value) { return __bfloat162float(value); });
+    }
+    request.memory.close();
+    selected_device.restore();
+    return result;
+}
+
