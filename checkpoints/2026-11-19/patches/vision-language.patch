+#include "sglang/decoder.h"
+
+#include "encoder.cuh"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+
+namespace fs = std::filesystem;
+using vision::check;
+using Int = std::int64_t;
+
+template <typename Element>
+std::vector<Element> read_file(const fs::path& path) {
+    std::ifstream stream(path, std::ios::binary | std::ios::ate);
+    const auto size = stream.tellg();
+    if (!stream || size < 0 || size % sizeof(Element)) {
+        throw std::runtime_error("Invalid input size for " + path.string());
+    }
+    std::vector<Element> values(size / sizeof(Element));
+    if (!stream.seekg(0) || !stream.read(reinterpret_cast<char*>(values.data()), size)) {
+        throw std::runtime_error("Cannot read " + path.string());
+    }
+    return values;
+}
+
+template <typename Element>
+void write_file(const fs::path& path, const std::vector<Element>& values) {
+    std::ofstream stream(path, std::ios::binary);
+    if (!stream.write(reinterpret_cast<const char*>(values.data()), values.size() * sizeof(Element))
+        || !stream.flush()) {
+        throw std::runtime_error("Cannot write " + path.string());
+    }
+}
+
+struct Fixture {
+    explicit Fixture(const fs::path& directory)
+        : geometry(read_file<Int>(directory / "grid.i64")),
+          metadata(read_file<Int>(directory / "spans.i64")),
+          patches(read_file<float>(directory / "patch.f32")) {
+        auto tokens = read_file<Int>(directory / "ids.i64");
+        auto axes = read_file<Int>(directory / "positions.i64");
+        auto delta_file = read_file<Int>(directory / "delta.i64");
+        if (tokens.empty() || axes.size() != 3 * tokens.size() || delta_file.size() != 1 ||
+            geometry.size() != 3 || metadata.empty() || metadata.size() % 5) {
+            throw std::runtime_error("Invalid fixture: " + directory.string());
+        }
+        ids.assign(tokens.begin(), tokens.end());
+        positions.resize(ids.size());
+        for (std::size_t index = 0; index < ids.size(); ++index) {
+            for (int axis = 0; axis < 3; ++axis) {
+                positions[index][axis] = axes[axis * ids.size() + index];
+            }
+        }
+        delta = delta_file[0];
+    }
+
+    std::array<Int, 3> grid() const { return {geometry[0], geometry[1], geometry[2]}; }
+
+    std::vector<sglang::VisualEmbeddingSpan> spans(vision::Embeddings output) const {
+        std::vector<sglang::VisualEmbeddingSpan> result;
+        int next_row = 0;
+        for (std::size_t offset = 0; offset < metadata.size(); offset += 5) {
+            const Int start = metadata[offset];
+            const Int rows = metadata[offset + 1];
+            const Int source = metadata[offset + 2];
+            if (source != next_row || rows < 1 || rows > output.rows - source ||
+                start < 0 || start >= static_cast<Int>(ids.size()) ||
+                rows > static_cast<Int>(ids.size()) - start ||
+                metadata[offset + 3] != source * 4 || metadata[offset + 4] != rows * 4) {
+                throw std::runtime_error("Invalid fixture vision span");
+            }
+            result.push_back({static_cast<int>(start), static_cast<int>(rows),
+                              output.device + source * vision::text_width});
+            next_row += static_cast<int>(rows);
+        }
+        if (next_row != output.rows) {
+            throw std::runtime_error("Fixture spans must cover every projected row");
+        }
+        return result;
+    }
+
+    std::vector<int> ids;
+    std::vector<sglang::RotaryPosition> positions;
+    std::vector<Int> geometry, metadata;
+    std::vector<float> patches;
+    int delta = 0;
+};
+
+void decode(const sglang::Decoder& decoder, const Fixture& fixture, vision::Embeddings embeddings,
+            const fs::path& directory, const std::string& label, int steps,
+            const std::vector<int>& teacher = {}) {
+    auto result = decoder.generate_multimodal(fixture.ids, fixture.positions,
+                                               fixture.spans(embeddings), fixture.delta, steps,
+                                               teacher);
+    std::vector<Int> ids(result.output_token_ids.begin(), result.output_token_ids.end());
+    write_file(directory / (label + ".ids.i64"), ids);
+    write_file(directory / (label + ".logits.f32"), result.logits);
+    std::printf("%s %s:", directory.filename().c_str(), label.c_str());
+    for (int id : result.output_token_ids) std::printf(" %d", id);
+    std::printf("\n");
+    std::fflush(stdout);
+}
+
+void run_case(const sglang::Decoder& decoder, const vision::Weights& weights,
+              const fs::path& fixture_path, const fs::path& output,
+              const fs::path& reference, int steps, bool controls) {
+    fs::create_directories(output);
+    Fixture fixture(fixture_path);
+    vision::Workspace work(fixture.grid());
+    if (fixture.patches.size() != static_cast<std::size_t>(work.rows) * vision::patch_width) {
+        throw std::runtime_error("Patch tensor size disagrees with the fixture grid");
+    }
+    vision::DeviceBuffer<float> pixels(fixture.patches.size());
+    const auto upload = [&] {
+        check(cudaMemcpy(pixels.get(), fixture.patches.data(), fixture.patches.size() * sizeof(float),
+                         cudaMemcpyHostToDevice), "Upload fixture pixels");
+    };
+    upload();
+    vision::Execution encoder(work, nullptr, nullptr);
+    auto embeddings = encoder.enqueue(weights, pixels.get());
+    check(cudaDeviceSynchronize(), "Complete vision embedding");
+    vision::Trace trace(output);
+    const int count = embeddings.rows * vision::text_width;
+    trace.save("embeddings", embeddings.device, count, nullptr);
+    decode(decoder, fixture, embeddings, output, "greedy", steps);
+    std::vector<int> teacher;
+    if (!reference.empty()) {
+        auto ids = read_file<Int>(reference / "greedy.ids.i64");
+        if (ids.size() < static_cast<std::size_t>(steps - 1)) {
+            throw std::runtime_error("Reference has too few teacher tokens");
+        }
+        teacher.assign(ids.begin(), ids.begin() + steps - 1);
+        decode(decoder, fixture, embeddings, output, "teacher", steps, teacher);
+        const auto oracle = read_file<vision::Bf16>(reference / "embeddings.bf16");
+        if (oracle.size() != static_cast<std::size_t>(count)) {
+            throw std::runtime_error("Reference has the wrong number of projected values");
+        }
+        check(cudaMemcpy(work.embeddings.get(), oracle.data(), oracle.size() * sizeof(vision::Bf16),
+                         cudaMemcpyHostToDevice), "Upload reference projected embeddings");
+        decode(decoder, fixture, embeddings, output, "vllm-embeddings", steps, teacher);
+    }
+    if (controls) {
+        check(cudaMemset(work.embeddings.get(), 0, count * sizeof(vision::Bf16)),
+              "Zero projected embeddings");
+        decode(decoder, fixture, embeddings, output, "zero-image", steps, teacher);
+        for (auto& pixel : fixture.patches) pixel = -pixel;
+        upload();
+        embeddings = encoder.enqueue(weights, pixels.get());
+        check(cudaDeviceSynchronize(), "Complete inverted-pixel vision embedding");
+        trace.save("inverted-embeddings", embeddings.device, count, nullptr);
+        decode(decoder, fixture, embeddings, output, "inverted-image", steps, teacher);
+    }
+}
+
+}
+
+int main(int argc, char** argv) {
+    try {
+        if (argc < 5 || argc > 6) {
+            std::fputs("usage: vision-language-check CHECKPOINT FIXTURES OUT STEPS [REFERENCE]\n",
+                       stderr);
+            return 2;
+        }
+        int devices = 0;
+        check(cudaGetDeviceCount(&devices), "Enumerate devices");
+        if (devices != 1) throw std::runtime_error("Expose one leased CUDA device");
+        cudaDeviceProp device{};
+        check(cudaGetDeviceProperties(&device, 0), "Identify device");
+        if (device.major != 10 || device.minor != 0) throw std::runtime_error("SM100 required");
+        const int steps = std::stoi(argv[4]);
+        if (steps < 1 || steps > 64) throw std::runtime_error("Steps must be in [1, 64]");
+        const fs::path checkpoint = argv[1], fixtures = argv[2], output = argv[3];
+        const fs::path reference = argc == 6 ? fs::path(argv[5]) : fs::path();
+        const sglang::Decoder decoder(checkpoint);
+        const vision::Weights weights(checkpoint / "outside.safetensors");
+        for (const std::string name : {"W1-image", "W1-video"}) {
+            run_case(decoder, weights, fixtures / name / "native", output / name,
+                     reference.empty() ? reference : reference / name, steps, name == "W1-image");
+        }
+        return 0;
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+}
