+}
+
+void validate_size(Size size, int frames, bool video, bool duplicate_single) {
+    require(size.height > 0 && size.width > 0 && size.height <= 16384 && size.width <= 16384 &&
+                frames > 0 && frames <= 768, "invalid frame size or count");
+    require(video || frames == 1, "one image frame required");
+    require(!video || frames >= pair_size || duplicate_single, "video resize requires at least two frames");
+}
+
+template<class T>
+std::vector<T> read_binary(const fs::path& file, std::size_t max_count) {
+    const auto bytes = fs::file_size(file);
+    require(bytes % sizeof(T) == 0 && bytes / sizeof(T) <= max_count, "invalid input byte length");
+    std::vector<T> data(bytes / sizeof(T));
+    std::ifstream input(file, std::ios::binary);
+    require(input.good(), "cannot open input");
+    if (bytes) {
+        require(static_cast<bool>(input.read(reinterpret_cast<char*>(data.data()), bytes)),
+                "cannot read input");
+    }
+    return data;
+}
+
+template<class Range>
+void write_binary(const fs::path& file, const Range& data) {
+    std::ofstream output(file, std::ios::binary);
+    output.write(reinterpret_cast<const char*>(data.data()), data.size() * sizeof(data[0]));
+    output.close();
+    require(output.good(), "cannot write output");
+}
+
+int rounded_multiple(int value, int unit) {
+    const int quotient = value / unit;
+    const int remainder = value % unit;
+    return (quotient + (2 * remainder > unit || (2 * remainder == unit && quotient % 2))) * unit;
+}
+
+Size resized_size(Size source, int frames, bool video) {
+    double height = source.height;
+    double width = source.width;
+    if (video && std::min(height, width) < factor) {
+        const double scale = factor / std::min(height, width);
+        height = std::trunc(height * scale);
+        width = std::trunc(width * scale);
+    }
+    require(std::max(height, width) <= 200.0 * std::min(height, width), "aspect ratio exceeds 200");
+    const int min_pixels = video ? 4096 : 65536;
+    const int max_pixels = video ? 25165824 : 16777216;
+    const int budget_frames = video ? frames : 1;
+    const int rounded_frames = video ? rounded_multiple(frames, pair_size) : 1;
+    Size output{rounded_multiple(static_cast<int>(height), factor),
+                rounded_multiple(static_cast<int>(width), factor)};
+    const double rounded_pixels = static_cast<double>(rounded_frames) * output.height * output.width;
+    const double source_pixels = budget_frames * height * width;
+    if (rounded_pixels > max_pixels) {
+        const double scale = std::sqrt(source_pixels / max_pixels);
+        output = {std::max(factor, static_cast<int>(std::floor(height / scale / factor)) * factor),
+                  std::max(factor, static_cast<int>(std::floor(width / scale / factor)) * factor)};
+    } else if (rounded_pixels < min_pixels) {
+        const double scale = std::sqrt(min_pixels / source_pixels);
+        output = {static_cast<int>(std::ceil(height * scale / factor)) * factor,
+                  static_cast<int>(std::ceil(width * scale / factor)) * factor};
+    }
+    require(output.height > 0 && output.width > 0, "resize produced an empty dimension");
+    return output;
+}
+
+double cubic(double distance) {
+    const double x = std::abs(distance);
+    constexpr double a = -0.5;
+    if (x < 1.0) {
+        return ((a + 2.0) * x - (a + 3.0)) * x * x + 1.0;
+    }
+    if (x < 2.0) {
+        return ((a * x - 5.0 * a) * x + 8.0 * a) * x - 4.0 * a;
+    }
+    return 0.0;
+}
+
+Filter make_filter(int input_size, int output_size) {
+    const double scale = static_cast<double>(input_size) / output_size;
+    const double stretch = std::max(1.0, scale);
+    Filter filter;
+    double max_weight = 0;
+    for (int index = 0; index < output_size; ++index) {
+        const double center = scale * (index + 0.5);
+        const int first = std::max(0, static_cast<int>(center - 2 * stretch + 0.5));
+        const int end = std::min(input_size, static_cast<int>(center + 2 * stretch + 0.5));
+        Tap tap{first, {}, {}};
+        double sum = 0;
+        for (int source = first; source < end; ++source) {
+            const double weight = cubic((source + 0.5 - center) / stretch);
+            tap.weights.push_back(weight);
+            sum += weight;
+        }
+        for (double& weight : tap.weights) {
+            weight /= sum;
+            max_weight = std::max(max_weight, weight);
+        }
+        filter.taps.push_back(std::move(tap));
+    }
+    filter.precision = 0;
+    while (filter.precision < 21 &&
+           std::round(std::ldexp(max_weight, filter.precision + 1)) < 32768) {
+        ++filter.precision;
+    }
+    for (Tap& tap : filter.taps) {
+        for (double weight : tap.weights) {
+            tap.fixed.push_back(static_cast<int>(std::round(std::ldexp(weight, filter.precision))));
+        }
+    }
+    return filter;
+}
+
+void resize_axis(const std::uint8_t* source, Size input, std::uint8_t* target, Size output,
+                 const Filter& filter, bool horizontal) {
+    for (int y = 0; y < output.height; ++y) {
+        for (int x = 0; x < output.width; ++x) {
+            const Tap& tap = filter.taps[horizontal ? x : y];
+            const int row = horizontal ? y : tap.first;
+            const int column = horizontal ? tap.first : x;
+            const auto* start = source + (static_cast<std::size_t>(row) * input.width + column) * 3;
+            const std::size_t stride = horizontal ? 3 : static_cast<std::size_t>(input.width) * 3;
+            for (int channel = 0; channel < 3; ++channel) {
+                std::int64_t value = 1 << (filter.precision - 1);
+                for (std::size_t weight = 0; weight < tap.fixed.size(); ++weight) {
+                    value += start[weight * stride + channel] * tap.fixed[weight];
+                }
+                target[(static_cast<std::size_t>(y) * output.width + x) * 3 + channel] =
+                    std::clamp<std::int64_t>(value >> filter.precision, 0, 255);
+            }
+        }
+    }
+}
+
+Bytes resize_frames(const Bytes& input, Size source, Size output, int frames) {
+    const bool change_width = source.width != output.width;
+    const bool change_height = source.height != output.height;
+    if (!change_width && !change_height) {
+        return input;
+    }
+    const Size middle{source.height, output.width};
+    const auto frame_bytes = [](Size size) { return std::size_t{3} * size.height * size.width; };
+    const auto horizontal = change_width ? make_filter(source.width, output.width) : Filter{};
+    const auto vertical = change_height ? make_filter(source.height, output.height) : Filter{};
+    Bytes temporary(change_width && change_height ? frame_bytes(middle) : 0);
+    Bytes result(frame_bytes(output) * frames);
+    for (int frame = 0; frame < frames; ++frame) {
+        const auto* start = input.data() + frame * frame_bytes(source);
+        auto* end = result.data() + frame * frame_bytes(output);
+        if (change_width) {
+            auto* stage = change_height ? temporary.data() : end;
+            resize_axis(start, source, stage, middle, horizontal, true);
+            start = stage;
+        }
+        if (change_height) {
+            resize_axis(start, middle, end, output, vertical, false);
+        }
+    }
+    return result;
+}
+
+Bytes pack_patches(const Bytes& pixels, Size output, int frames) {
+    Bytes packed;
+    const int time = (frames + pair_size - 1) / pair_size;
+    packed.reserve(static_cast<std::size_t>(time) * pair_size * output.height * output.width * 3);
+    for (int group = 0; group < time; ++group) {
+        for (int block_y = 0; block_y < output.height; block_y += factor) {
+            for (int block_x = 0; block_x < output.width; block_x += factor) {
+                for (int local_y = 0; local_y < factor; local_y += patch) {
+                    for (int local_x = 0; local_x < factor; local_x += patch) {
+                        for (int channel = 0; channel < 3; ++channel) {
+                            for (int within_pair = 0; within_pair < pair_size; ++within_pair) {
+                                const int frame = std::min(group * pair_size + within_pair, frames - 1);
+                                for (int y = 0; y < patch; ++y) {
+                                    const std::size_t row = static_cast<std::size_t>(frame) * output.height
+                                                            + block_y + local_y + y;
+                                    for (int x = 0; x < patch; ++x) {
+                                        const int column = block_x + local_x + x;
+                                        packed.push_back(pixels[(row * output.width + column) * 3 + channel]);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    return packed;
+}
+
+std::string timestamp(double seconds) {
+    std::array<char, 80> buffer{};
+    const auto result = std::to_chars(buffer.data(), buffer.data() + buffer.size(),
+                                      seconds, std::chars_format::fixed, 1);
+    require(result.ec == std::errc{}, "cannot format timestamp");
+    return "<" + std::string(buffer.data(), result.ptr) + " seconds>";
+}
+
+std::map<std::string, std::vector<Id>> timestamp_tokens(const fs::path& file) {
+    std::ifstream input(file);
+    require(input.good(), "cannot read timestamp vocabulary");
+    std::map<std::string, std::vector<Id>> lookup;
+    std::string literal;
+    int length;
+    while (input >> literal >> length) {
+        require(length > 0 && length <= 32, "invalid timestamp token count");
+        auto& ids = lookup["<" + literal + " seconds>"];
+        require(ids.empty(), "duplicate timestamp vocabulary entry");
+        ids.resize(length);
+        for (Id& id : ids) {
+            require(static_cast<bool>(input >> id), "invalid timestamp token");
+        }
+    }
+    return lookup;
+}
+
+Prompt expand_prompt(const std::vector<Id>& original, const std::vector<Id>& indices, double fps,
+                     const std::array<Id, 3>& grid, bool video,
+                     const std::map<std::string, std::vector<Id>>& lookup) {
+    const Id pad = video ? video_pad : image_pad;
+    const auto marker = std::find(original.begin(), original.end(), pad);
+    require(marker != original.end() && marker != original.begin() && marker + 1 != original.end() &&
+                marker[-1] == vision_start && marker[1] == vision_end,
+            "expected a single bounded template marker");
+    require(std::count(original.begin(), original.end(), image_pad) +
+                std::count(original.begin(), original.end(), video_pad) == 1,
+            "expected a single media item");
+    Prompt prompt;
+    Id base = 0;
+    const auto text = [&](Id token) {
+        prompt.ids.push_back(token);
+        for (auto& axis : prompt.positions) {
+            axis.push_back(base);
+        }
+        ++base;
+    };
+    std::for_each(original.begin(), video ? marker : marker - 1, text);
+    const Id merged_h = grid[1] / merge;
+    const Id merged_w = grid[2] / merge;
+    const Id visual = merged_h * merged_w;
+    for (Id group = 0; group < grid[0]; ++group) {
+        if (video) {
+            const auto first = static_cast<std::size_t>(group * pair_size);
+            const auto last = std::min(first + pair_size - 1, indices.size() - 1);
+            const double seconds = (static_cast<double>(indices[first]) / fps +
+                                    static_cast<double>(indices[last]) / fps) / 2.0;
+            const auto& tokens = lookup.at(timestamp(seconds));
+            std::for_each(tokens.begin(), tokens.end(), text);
+        }
+        text(vision_start);
+        const Id start = static_cast<Id>(prompt.ids.size());
+        const Id patches = grid[1] * grid[2];
+        const std::array span{start, visual, group * visual, group * patches, patches};
+        prompt.spans.insert(prompt.spans.end(), span.begin(), span.end());
+        for (Id row = 0; row < merged_h; ++row) {
+            for (Id column = 0; column < merged_w; ++column) {
+                prompt.ids.push_back(pad);
+                prompt.positions[0].push_back(base);
+                prompt.positions[1].push_back(base + row);
+                prompt.positions[2].push_back(base + column);
+            }
+        }
+        base += std::max(merged_h, merged_w);
+        text(vision_end);
+    }
+    std::for_each(video ? marker + 1 : marker + 2, original.end(), text);
+    prompt.delta = base - static_cast<Id>(prompt.ids.size());
+    return prompt;
+}
+
+void preprocess(const fs::path& input_dir, const fs::path& output_dir) {
+    static_assert(std::endian::native == std::endian::little);
+    static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559);
+    std::ifstream meta(input_dir / "input.txt");
+    std::string modality;
+    Size source{};
+    int frames{};
+    bool duplicate_single{};
+    double fps{};
+    require(static_cast<bool>(meta >> modality >> source.height >> source.width >> frames >> duplicate_single >> fps),
+            "invalid input metadata");
+    require(modality == "image" || modality == "video", "invalid modality");
+    const bool video = modality == "video";
+    validate_size(source, frames, video, duplicate_single);
+    require(!video || (std::isfinite(fps) && fps >= 0.001 && fps <= 1000000), "invalid source fps");
+    std::vector<Id> indices(video ? frames : 0);
+    for (Id& index : indices) {
+        require(static_cast<bool>(meta >> index) && index >= 0 && index <= 1000000000, "invalid frame index");
+    }
+    require(std::is_sorted(indices.begin(), indices.end()), "frame indices must be nondecreasing");
+    const auto input_bytes = static_cast<std::size_t>(frames) * source.height * source.width * 3;
+    require(input_bytes <= scratch_limit, "decoded frames exceed scratch limit");
+    const auto rgb = read_binary<std::uint8_t>(input_dir / "frames.rgb8", input_bytes);
+    require(rgb.size() == input_bytes, "decoded byte count differs from metadata");
+    const int resize_frames_count = video ? std::max(frames, pair_size) : frames;
+    const Size output = resized_size(source, resize_frames_count, video);
+    const Id time = (frames + pair_size - 1) / pair_size;
+    require(static_cast<std::size_t>(time) * pair_size * output.height * output.width * 3 <= scratch_limit / 4 &&
+                static_cast<std::size_t>(source.height) * output.width * 3 <= scratch_limit,
+            "resize exceeds scratch limit");
+    const std::array<Id, 3> grid{time, output.height / patch, output.width / patch};
+    const auto original = read_binary<Id>(input_dir / "template.i64", 262144);
+    const auto lookup = video ? timestamp_tokens(input_dir / "timestamps.txt")
+                              : std::map<std::string, std::vector<Id>>{};
+    const auto prompt = expand_prompt(original, indices, fps, grid, video, lookup);
+    const auto packed = pack_patches(resize_frames(rgb, source, output, frames), output, frames);
+    std::vector<float> normalized(packed.size());
+    std::transform(packed.begin(), packed.end(), normalized.begin(),
+                   [](std::uint8_t pixel) { return (static_cast<float>(pixel) - 127.5f) / 127.5f; });
+    std::vector<Id> positions;
+    for (const auto& axis : prompt.positions) {
+        positions.insert(positions.end(), axis.begin(), axis.end());
+    }
+    std::vector<Id> vision_hw;
+    std::vector<Id> vision_cu{0};
+    for (Id group = 0; group < grid[0]; ++group) {
+        for (Id block_h = 0; block_h < grid[1]; block_h += merge) {
+            for (Id block_w = 0; block_w < grid[2]; block_w += merge) {
+                for (Id local_h = 0; local_h < merge; ++local_h) {
+                    for (Id local_w = 0; local_w < merge; ++local_w) {
+                        vision_hw.push_back(block_h + local_h);
+                        vision_hw.push_back(block_w + local_w);
+                    }
+                }
+            }
+        }
+        vision_cu.push_back(vision_cu.back() + grid[1] * grid[2]);
+    }
+    fs::create_directories(output_dir);
+    write_binary(output_dir / "grid.i64", grid);
+    write_binary(output_dir / "ids.i64", prompt.ids);
+    write_binary(output_dir / "spans.i64", prompt.spans);
+    write_binary(output_dir / "positions.i64", positions);
+    write_binary(output_dir / "delta.i64", std::array{prompt.delta});
+    write_binary(output_dir / "vision_hw.i64", vision_hw);
+    write_binary(output_dir / "vision_cu.i64", vision_cu);
+    write_binary(output_dir / "patch.u8", packed);
+    write_binary(output_dir / "patch.f32", normalized);
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    try {
+        if (argc == 2 && std::string_view(argv[1]) == "--resize-shape") {
+            std::string modality;
+            Size source{};
+            int frames{};
+            require(static_cast<bool>(std::cin >> modality >> source.height >> source.width >> frames),
+                    "invalid input metadata");
+            require(modality == "image" || modality == "video", "invalid modality");
+            const bool video = modality == "video";
+            validate_size(source, frames, video, false);
+            const Size output = resized_size(source, frames, video);
+            std::cout << output.height << ' ' << output.width << '\n';
+        } else if (argc == 3) {
+            preprocess(argv[1], argv[2]);
+        } else {
+            std::cerr << "usage: preprocess INPUT_DIRECTORY OUTPUT_DIRECTORY | preprocess --resize-shape\n";
+            return 2;
+        }
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
