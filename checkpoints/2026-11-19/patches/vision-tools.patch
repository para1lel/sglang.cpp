+import hashlib
+import json
+import math
+import sys
+from pathlib import Path
+
+
+HEADER_SHA = "46c1becd13ef15aa93329585f790823aeebabd3fd070932fccd8ced6b45494e5"
+PAYLOAD_SHA = "c623c5ec68429f48689a011872157782c85508517faaa66de38250e0ad4b145b"
+CONFIG_SHA = "74227dd615bf1ea975aa676bdf355a0379858c12f394b5365cd9dfa5fc2c70bc"
+INVENTORY_SHA = "aeeb56a565922dfbd2268ab42ebaa8a9d606b5d02d84ee4c84e8126cfcdaad2a"
+PREPROCESS_SHA = "f27c049c6c09f34371e92b86f7b08e6a071f95772ca8c094ea7018f7d4f87932"
+CASES = ("W1-image", "W1-video")
+MEDIA_FILES = (
+    "patch.u8", "patch.f32", "grid.i64", "vision_hw.i64", "vision_cu.i64",
+    "spans.i64", "ids.i64", "positions.i64", "delta.i64",
+)
+
+
+def sha(path):
+    with path.open("rb") as source:
+        return hashlib.file_digest(source, "sha256").hexdigest()
+
+
+def tensor_shapes():
+    shapes = {
+        "patch_embed.proj.weight": [1152, 3, 2, 16, 16],
+        "patch_embed.proj.bias": [1152],
+        "pos_embed.weight": [2304, 1152],
+        "merger.norm.weight": [1152],
+        "merger.norm.bias": [1152],
+        "merger.linear_fc1.weight": [4608, 4608],
+        "merger.linear_fc1.bias": [4608],
+        "merger.linear_fc2.weight": [5120, 4608],
+        "merger.linear_fc2.bias": [5120],
+    }
+    block = {
+        "norm1.weight": [1152], "norm1.bias": [1152],
+        "norm2.weight": [1152], "norm2.bias": [1152],
+        "attn.qkv.weight": [3456, 1152], "attn.qkv.bias": [3456],
+        "attn.proj.weight": [1152, 1152], "attn.proj.bias": [1152],
+        "mlp.linear_fc1.weight": [4304, 1152], "mlp.linear_fc1.bias": [4304],
+        "mlp.linear_fc2.weight": [1152, 4304], "mlp.linear_fc2.bias": [1152],
+    }
+    for layer in range(27):
+        shapes.update({f"blocks.{layer}.{name}": shape for name, shape in block.items()})
+    return {f"model.visual.{name}": shape for name, shape in sorted(shapes.items())}
+
+
+def verify_checkpoint(checkpoint, inventory):
+    config = json.loads((checkpoint / "config.json").read_text())["vision_config"]
+    expected = {
+        "deepstack_visual_indexes": [], "depth": 27, "hidden_act": "gelu_pytorch_tanh",
+        "hidden_size": 1152, "in_channels": 3, "intermediate_size": 4304, "num_heads": 16,
+        "num_position_embeddings": 2304, "out_hidden_size": 5120, "patch_size": 16,
+        "spatial_merge_size": 2, "temporal_patch_size": 2,
+    }
+    if any(config.get(key) != value for key, value in expected.items()):
+        raise ValueError("Unexpected vision configuration")
+    shard = checkpoint / "outside.safetensors"
+    expected_shapes = tensor_shapes()
+    with shard.open("rb") as source:
+        prefix = source.read(8)
+        header_size = int.from_bytes(prefix, "little")
+        if not 0 < header_size <= 1 << 20:
+            raise ValueError("Unexpected safetensors header size")
+        header = source.read(header_size)
+        if hashlib.sha256(prefix + header).hexdigest() != HEADER_SHA:
+            raise ValueError("Unexpected safetensors header")
+        descriptors = json.loads(header)
+        if {name for name in descriptors if name.startswith("model.visual.")} != expected_shapes.keys():
+            raise ValueError("Unexpected vision tensor names")
+        if set(inventory["tensors"]) != expected_shapes.keys() or inventory["header_sha256"] != HEADER_SHA:
+            raise ValueError("Unexpected prerequisite vision inventory")
+        payload = hashlib.sha256()
+        for name, shape in expected_shapes.items():
+            desc = descriptors[name]
+            begin, end = desc["data_offsets"]
+            size = math.prod(shape) * 2
+            row = {"dtype": "BF16", "shape": shape, "file_byte_offset": 8 + header_size + begin, "bytes": size}
+            if desc["dtype"] != "BF16" or desc["shape"] != shape or end - begin != size:
+                raise ValueError(f"Unexpected checkpoint descriptor for {name}")
+            if inventory["tensors"][name] != row:
+                raise ValueError(f"Inventory mismatch for {name}")
+            source.seek(row["file_byte_offset"])
+            data = source.read(size)
+            if len(data) != size:
+                raise ValueError(f"Truncated tensor {name}")
+            payload.update(data)
+    if payload.hexdigest() != PAYLOAD_SHA:
+        raise ValueError("Unexpected checkpoint vision payload")
+    return PAYLOAD_SHA
+
+
+def main():
+    checkpoint, fixtures, output = map(Path, sys.argv[1:])
+    output.mkdir(parents=True, exist_ok=True)
+    inventory_path = fixtures / "vision-weights.json"
+    verify_files = {
+        inventory_path: INVENTORY_SHA,
+        checkpoint / "config.json": CONFIG_SHA,
+        fixtures / "results.json": PREPROCESS_SHA,
+    }
+    for file, digest in verify_files.items():
+        if sha(file) != digest:
+            raise ValueError(f"Input hash mismatch for {file}")
+    inventory = json.loads(inventory_path.read_text())
+    payload_digest = verify_checkpoint(checkpoint, inventory)
+    names = tensor_shapes()
+    rows = []
+    for name in names:
+        tensor = inventory["tensors"][name]
+        short = name.removeprefix("model.visual.")
+        rows.append(f'    {{"{short}", {tensor["file_byte_offset"]}ULL, {tensor["bytes"]}ULL}},\n')
+    (output / "checkpoint_manifest.inc").write_text("".join(rows))
+    fixtures_sha = {
+        f"{case}/{kind}/{name}": sha(fixtures / case / kind / name)
+        for case in CASES for kind in ("native", "oracle") for name in MEDIA_FILES
+    }
+    prerequisite = {
+        entry["case"]: entry for entry in json.loads((fixtures / "results.json").read_text())["cases"]
+    }
+    media_hashes = {}
+    for case in CASES:
+        entry = prerequisite[case]
+        media_pattern = "*.png" if case == "W1-image" else "*.mp4"
+        media, = (fixtures / case / "input").glob(media_pattern)
+        media_digest = sha(media)
+        if media_digest != entry["media_sha256"]:
+            raise ValueError(f"Media hash mismatch in {media}")
+        media_hashes[str(media.relative_to(fixtures))] = media_digest
+        for kind in ("native", "oracle"):
+            expected_hashes = dict(entry["hashes_of_exact_discrete_outputs"])
+            source = "native" if kind == "native" else "reference"
+            expected_hashes["patch.f32"] = entry[f"{source}_patch_f32_sha256"]
+            expected_hashes["patch.u8"] = entry[f"{source}_patch_u8_sha256"]
+            for name in MEDIA_FILES:
+                filename = f"{case}/{kind}/{name}"
+                if fixtures_sha[filename] != expected_hashes[name]:
+                    raise ValueError(f"Prerequisite fixture hash mismatch in {filename}")
+    control = output / "W1-video-isolation" / "fixture"
+    control.mkdir(parents=True, exist_ok=True)
+    grid = (fixtures / "W1-video" / "native" / "grid.i64").read_bytes()
+    patches = (fixtures / "W1-video" / "native" / "patch.f32").read_bytes()
+    if len(grid) != 24 or int.from_bytes(grid[:8], "little") != 2 or len(patches) % (2 * 1536 * 4):
+        raise ValueError("The W1 video isolation control requires two equal temporal groups")
+    (control / "grid.i64").write_bytes(grid)
+    (control / "patch.f32").write_bytes(patches[:len(patches) // 2] + bytes(len(patches) // 2))
+    identities = {
+        "native_target": "dc087912a794372485e78c0a6de5140ac43746e7",
+        "checkpoint_revision": "c3a462cc3d38cf351f3b26cbd763469eeb74ef81",
+        "config_sha256": sha(checkpoint / "config.json"),
+        "checkpoint_header_sha256": HEADER_SHA,
+        "vision_payload_sha256_in_tensor_name_order": payload_digest,
+        "vision_inventory_sha256": sha(inventory_path),
+        "manifest_sha256": sha(output / "checkpoint_manifest.inc"),
+        "preprocess_results_sha256": sha(fixtures / "results.json"),
+        "media_files_sha256": media_hashes,
+        "fixture_sha256": fixtures_sha,
+        "video_isolation_control_patch_sha256": sha(control / "patch.f32"),
+    }
+    (output / "inputs.json").write_text(json.dumps(identities, indent=2, sort_keys=True) + "\n")
+
+
+if __name__ == "__main__":
+    main()
