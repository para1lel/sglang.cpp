diff --git a/vision/encoder/encoder.cuh b/vision/encoder/encoder.cuh
new file mode 100644
index 0000000..f4ef22f
--- /dev/null
+++ b/vision/encoder/encoder.cuh
@@ -0,0 +1,278 @@
+#pragma once
+
+#include "kernels.cuh"
+
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+namespace vision {
+
+inline void check(cudaError_t status, std::string_view operation) {
+    if (status != cudaSuccess) {
+        throw std::runtime_error(std::string(operation) + ": " + cudaGetErrorString(status));
+    }
+}
+
+template <typename Element>
+class DeviceBuffer {
+public:
+    explicit DeviceBuffer(std::size_t count) {
+        check(cudaMalloc(&data_, count * sizeof(Element)), "cudaMalloc");
+    }
+    ~DeviceBuffer() {
+        if (data_) cudaFree(data_);
+    }
+    DeviceBuffer(const DeviceBuffer&) = delete;
+    DeviceBuffer& operator=(const DeviceBuffer&) = delete;
+    Element* get() const { return data_; }
+
+private:
+    Element* data_ = nullptr;
+};
+
+struct TensorDesc {
+    const char* name;
+    std::uint64_t offset;
+    std::size_t bytes;
+};
+
+inline constexpr TensorDesc tensors[] = {
+#include "checkpoint_manifest.inc"
+};
+static_assert(std::size(tensors) == 333);
+inline constexpr std::size_t weight_bytes = 921460192;
+
+struct Affine {
+    const Bf16* weight;
+    const Bf16* bias;
+};
+
+struct Block {
+    Affine norm1, qkv, attention, norm2, fc1, fc2;
+};
+
+class Weights {
+public:
+    explicit Weights(const std::filesystem::path& shard) : memory_(weight_bytes / sizeof(Bf16)) {
+        std::ifstream file(shard, std::ios::binary);
+        if (!file) throw std::runtime_error("Cannot open " + shard.string());
+        std::vector<char> staging;
+        std::size_t cursor = 0;
+        for (const auto& tensor : tensors) {
+            if (tensor.bytes > weight_bytes - cursor) throw std::runtime_error("Invalid manifest");
+            staging.resize(tensor.bytes);
+            file.seekg(tensor.offset);
+            if (!file.read(staging.data(), staging.size())) {
+                throw std::runtime_error(std::string("Cannot load ") + tensor.name);
+            }
+            Bf16* destination = memory_.get() + cursor / sizeof(Bf16);
+            check(cudaMemcpy(destination, staging.data(), tensor.bytes, cudaMemcpyHostToDevice),
+                  tensor.name);
+            by_name_.emplace(tensor.name, destination);
+            cursor += tensor.bytes;
+        }
+        if (cursor != weight_bytes) throw std::runtime_error("Incomplete vision payload");
+        patch = affine("patch_embed.proj");
+        learned_position = by_name_.at("pos_embed.weight");
+        for (int layer = 0; layer < depth; ++layer) {
+            auto name = "blocks." + std::to_string(layer) + ".";
+            blocks[layer] = {affine(name + "norm1"), affine(name + "attn.qkv"),
+                             affine(name + "attn.proj"), affine(name + "norm2"),
+                             affine(name + "mlp.linear_fc1"), affine(name + "mlp.linear_fc2")};
+        }
+        merge_norm = affine("merger.norm");
+        merge_fc1 = affine("merger.linear_fc1");
+        merge_fc2 = affine("merger.linear_fc2");
+    }
+
+    Affine patch, merge_norm, merge_fc1, merge_fc2;
+    const Bf16* learned_position;
+    std::array<Block, depth> blocks;
+
+private:
+    Affine affine(const std::string& prefix) const {
+        return {by_name_.at(prefix + ".weight"), by_name_.at(prefix + ".bias")};
+    }
+
+    DeviceBuffer<Bf16> memory_;
+    std::unordered_map<std::string, const Bf16*> by_name_;
+};
+
+inline Grid validate_grid(std::array<std::int64_t, 3> shape) {
+    constexpr int max_frame = 4096;
+    constexpr int max_patches = 16384;
+    auto [time, height, width] = shape;
+    if (time < 1 || time > max_patches || height < 2 || height > max_frame ||
+        width < 2 || width > max_frame || height % 2 || width % 2 ||
+        height * width > max_frame || time * height * width > max_patches) {
+        throw std::runtime_error("Unsupported grid: require positive T, even H/W, "
+                                 "H*W <= 4096, and T*H*W <= 16384");
+    }
+    return {static_cast<int>(time), static_cast<int>(height), static_cast<int>(width)};
+}
+
+struct Workspace {
+    explicit Workspace(std::array<std::int64_t, 3> shape)
+        : grid(validate_grid(shape)), rows(grid.patches()),
+          patches(rows * patch_width), residual(rows * hidden), norm(rows * hidden),
+          qkv(rows * 3 * hidden), qk(rows * 2 * hidden), context(rows * hidden),
+          projected(rows * hidden), intermediate(rows * feedforward),
+          merge_intermediate(rows * hidden), embeddings((rows / 4) * text_width),
+          rope(grid.frame() * (head_width / 2)) {}
+
+    const Grid grid;
+    const int rows;
+    DeviceBuffer<Bf16> patches, residual, norm, qkv, qk, context, projected;
+    DeviceBuffer<Bf16> intermediate, merge_intermediate, embeddings;
+    DeviceBuffer<float2> rope;
+};
+
+class Trace {
+public:
+    explicit Trace(std::filesystem::path directory) : directory_(std::move(directory)) {
+        std::filesystem::create_directories(directory_);
+    }
+
+    void save(const std::string& name, const Bf16* device, int count, cudaStream_t stream) {
+        check(cudaStreamSynchronize(stream), name);
+        staging_.resize(count);
+        auto bytes = staging_.size() * sizeof(Bf16);
+        check(cudaMemcpy(staging_.data(), device, bytes, cudaMemcpyDeviceToHost), name);
+        std::ofstream file(directory_ / (name + ".bf16"), std::ios::binary | std::ios::trunc);
+        if (!file.write(reinterpret_cast<const char*>(staging_.data()), bytes) || !file.flush()) {
+            throw std::runtime_error("Cannot write trace " + name);
+        }
+    }
+
+private:
+    std::filesystem::path directory_;
+    std::vector<Bf16> staging_;
+};
+
+struct Embeddings {
+    const Bf16* device;
+    int rows;
+};
+
+class Execution {
+public:
+    Execution(Workspace& work, cudaStream_t stream, Trace* trace)
+        : work_(work), stream_(stream), trace_(trace) {}
+
+    Embeddings enqueue(const Weights& weights, const float* input_patch) {
+        int rows = work_.rows;
+        Grid grid = work_.grid;
+        auto* residual = work_.residual.get();
+        auto* temporary = work_.projected.get();
+        auto* rotary = work_.rope.get();
+        cast_patch<<<blocks(rows * patch_width), threads, 0, stream_>>>(
+            input_patch, work_.patches.get(), rows * patch_width);
+        check(cudaGetLastError(), "Cast patch inputs");
+        gemm<true>(work_.patches.get(), weights.patch, residual, rows, patch_width, hidden);
+        save("patch", residual, rows * hidden);
+        position<<<blocks(rows * hidden), threads, 0, stream_>>>(
+            weights.learned_position, temporary, grid);
+        save("position", temporary, rows * hidden);
+        add<<<blocks(rows * hidden), threads, 0, stream_>>>(residual, temporary, rows * hidden);
+        save("embed", residual, rows * hidden);
+        rope_table<<<blocks(grid.frame() * head_width / 2), threads, 0, stream_>>>(rotary, grid);
+        check(cudaGetLastError(), "Build rotary table");
+        for (int layer = 0; layer < depth; ++layer) {
+            transformer(weights.blocks[layer], layer);
+        }
+        save("encoder", residual, rows * hidden);
+        return merge(weights);
+    }
+
+private:
+    static int blocks(int count) { return (count + threads - 1) / threads; }
+
+    void save(const std::string& name, const Bf16* data, int count) {
+        check(cudaGetLastError(), name);
+        if (trace_) trace_->save(name, data, count, stream_);
+    }
+
+    template <bool round_before_bias = false>
+    void gemm(const Bf16* input, Affine affine, Bf16* output, int rows, int in, int out) {
+        dim3 tiles((out + gemm_tile - 1) / gemm_tile, (rows + gemm_tile - 1) / gemm_tile);
+        linear<round_before_bias><<<tiles, threads, 0, stream_>>>(
+            input, affine.weight, affine.bias, output, rows, in, out);
+    }
+
+    void normalize(const Bf16* input, Affine affine, Bf16* output) {
+        layer_norm<<<work_.rows, threads, 0, stream_>>>(input, affine.weight, affine.bias, output);
+    }
+
+    void transformer(const Block& weights, int layer) {
+        std::string name = std::string("block") + (layer < 10 ? "0" : "") +
+                           std::to_string(layer) + ".";
+        int rows = work_.rows;
+        int width = rows * hidden;
+        auto* residual = work_.residual.get();
+        auto* norm = work_.norm.get();
+        auto* qkv = work_.qkv.get();
+        auto* qk = work_.qk.get();
+        auto* context = work_.context.get();
+        auto* projected = work_.projected.get();
+        auto* intermediate = work_.intermediate.get();
+        normalize(residual, weights.norm1, norm);
+        save(name + "norm1", norm, width);
+        gemm(norm, weights.qkv, qkv, rows, hidden, 3 * hidden);
+        save(name + "qkv", qkv, 3 * width);
+        apply_rope<<<blocks(2 * width), threads, 0, stream_>>>(
+            qkv, work_.rope.get(), qk, work_.grid);
+        save(name + "rope", qk, 2 * width);
+        int frame = work_.grid.frame();
+        attention<<<dim3(rows, heads), threads, frame * sizeof(float), stream_>>>(
+            qk, qkv, context, frame);
+        save(name + "context", context, width);
+        gemm(context, weights.attention, projected, rows, hidden, hidden);
+        save(name + "attention", projected, width);
+        add<<<blocks(width), threads, 0, stream_>>>(residual, projected, width);
+        save(name + "attention_residual", residual, width);
+        normalize(residual, weights.norm2, norm);
+        save(name + "norm2", norm, width);
+        gemm(norm, weights.fc1, intermediate, rows, hidden, feedforward);
+        save(name + "fc1", intermediate, rows * feedforward);
+        gelu<true><<<blocks(rows * feedforward), threads, 0, stream_>>>(
+            intermediate, rows * feedforward);
+        save(name + "gelu", intermediate, rows * feedforward);
+        gemm(intermediate, weights.fc2, projected, rows, feedforward, hidden);
+        save(name + "fc2", projected, width);
+        add<<<blocks(width), threads, 0, stream_>>>(residual, projected, width);
+        save(name + "hidden", residual, width);
+    }
+
+    Embeddings merge(const Weights& weights) {
+        int rows = work_.rows;
+        int output_rows = rows / 4;
+        auto* residual = work_.residual.get();
+        auto* norm = work_.norm.get();
+        auto* middle = work_.merge_intermediate.get();
+        auto* output = work_.embeddings.get();
+        save("merge.input", residual, rows * hidden);
+        normalize(residual, weights.merge_norm, norm);
+        save("merge.norm", norm, rows * hidden);
+        gemm(norm, weights.merge_fc1, middle, output_rows, merge_width, merge_width);
+        save("merge.fc1", middle, output_rows * merge_width);
+        gelu<false><<<blocks(output_rows * merge_width), threads, 0, stream_>>>(
+            middle, output_rows * merge_width);
+        save("merge.gelu", middle, output_rows * merge_width);
+        gemm(middle, weights.merge_fc2, output, output_rows, merge_width, text_width);
+        save("merge.output", output, output_rows * text_width);
+        return {output, output_rows};
+    }
+
+    Workspace& work_;
+    cudaStream_t stream_;
+    Trace* trace_;
+};
+
+}
diff --git a/vision/encoder/kernels.cuh b/vision/encoder/kernels.cuh
new file mode 100644
index 0000000..92f5679
--- /dev/null
+++ b/vision/encoder/kernels.cuh
@@ -0,0 +1,245 @@
+#pragma once
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <math_constants.h>
+#include <mma.h>
+
+namespace vision {
+
+using Bf16 = __nv_bfloat16;
+constexpr int hidden = 1152;
+constexpr int heads = 16;
+constexpr int head_width = 72;
+constexpr int feedforward = 4304;
+constexpr int patch_width = 1536;
+constexpr int merge_width = 4608;
+constexpr int text_width = 5120;
+constexpr int depth = 27;
+constexpr int table_side = 48;
+constexpr int threads = 128;
+constexpr int gemm_tile = 32;
+constexpr int wmma_tile = 16;
+
+struct Grid {
+    int time;
+    int height;
+    int width;
+
+    __host__ __device__ int frame() const { return height * width; }
+    __host__ __device__ int patches() const { return time * frame(); }
+};
+
+__device__ inline float fp32(Bf16 value) {
+    return __bfloat162float(value);
+}
+
+__device__ inline Bf16 bf16(float value) {
+    return __float2bfloat16_rn(value);
+}
+
+__global__ void cast_patch(const float* input, Bf16* output, int count) {
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index < count) output[index] = bf16(input[index]);
+}
+
+template <bool round_before_bias>
+__global__ void linear(const Bf16* input, const Bf16* weight, const Bf16* bias, Bf16* output,
+                       int rows, int input_width, int output_width) {
+    using namespace nvcuda::wmma;
+    __shared__ __align__(32) Bf16 activation[gemm_tile * wmma_tile];
+    __shared__ __align__(32) Bf16 kernel[gemm_tile * wmma_tile];
+    __shared__ __align__(32) float result[gemm_tile * gemm_tile];
+    int tile_row = blockIdx.y * gemm_tile;
+    int tile_column = blockIdx.x * gemm_tile;
+    int warp = threadIdx.x / 32;
+    int lane = threadIdx.x % 32;
+    int warp_row = warp / 2 * wmma_tile;
+    int warp_column = warp % 2 * wmma_tile;
+    fragment<accumulator, wmma_tile, wmma_tile, wmma_tile, float> sum;
+    fill_fragment(sum, 0.0f);
+
+    for (int offset = 0; offset < input_width; offset += wmma_tile) {
+        for (int slot = threadIdx.x; slot < gemm_tile * wmma_tile; slot += threads) {
+            int row = tile_row + slot / wmma_tile;
+            int column = tile_column + slot / wmma_tile;
+            int channel = offset + slot % wmma_tile;
+            activation[slot] = row < rows ? input[row * input_width + channel] : bf16(0.0f);
+            kernel[slot] = column < output_width ? weight[column * input_width + channel]
+                                                : bf16(0.0f);
+        }
+        __syncthreads();
+        fragment<matrix_a, wmma_tile, wmma_tile, wmma_tile, Bf16, row_major> left;
+        fragment<matrix_b, wmma_tile, wmma_tile, wmma_tile, Bf16, col_major> right;
+        load_matrix_sync(left, activation + warp_row * wmma_tile, wmma_tile);
+        load_matrix_sync(right, kernel + warp_column * wmma_tile, wmma_tile);
+        mma_sync(sum, left, right, sum);
+        __syncthreads();
+    }
+
+    float* tile = result + warp * wmma_tile * wmma_tile;
+    store_matrix_sync(tile, sum, wmma_tile, mem_row_major);
+    __syncwarp();
+    for (int slot = lane; slot < wmma_tile * wmma_tile; slot += 32) {
+        int row = tile_row + warp_row + slot / wmma_tile;
+        int column = tile_column + warp_column + slot % wmma_tile;
+        if (row < rows && column < output_width) {
+            const float sum = round_before_bias ? fp32(bf16(tile[slot])) : tile[slot];
+            output[row * output_width + column] = bf16(sum + fp32(bias[column]));
+        }
+    }
+}
+
+__device__ inline void coordinates(Grid grid, int index, int& height, int& width) {
+    int patch = index % grid.frame();
+    int block = patch / 4;
+    height = 2 * (block / (grid.width / 2)) + (patch / 2) % 2;
+    width = 2 * (block % (grid.width / 2)) + patch % 2;
+}
+
+__global__ void position(const Bf16* table, Bf16* output, Grid grid) {
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index >= grid.patches() * hidden) return;
+    int row, column;
+    coordinates(grid, index / hidden, row, column);
+    float source_h = float(row * (table_side - 1)) / float(grid.height - 1);
+    float source_w = float(column * (table_side - 1)) / float(grid.width - 1);
+    int h0 = int(source_h);
+    int w0 = int(source_w);
+    int h1 = min(h0 + 1, table_side - 1);
+    int w1 = min(w0 + 1, table_side - 1);
+    float h_high = source_h - float(h0);
+    float w_high = source_w - float(w0);
+    float h_low = 1.0f - h_high;
+    float w_low = 1.0f - w_high;
+    int channel = index % hidden;
+    float top_left = fp32(table[(h0 * table_side + w0) * hidden + channel]) * (h_low * w_low);
+    float top_right = fp32(table[(h0 * table_side + w1) * hidden + channel]) * (h_low * w_high);
+    float bottom_left = fp32(table[(h1 * table_side + w0) * hidden + channel]) * (h_high * w_low);
+    float bottom_right = fp32(table[(h1 * table_side + w1) * hidden + channel]) * (h_high * w_high);
+    output[index] = bf16(top_left + top_right + bottom_left + bottom_right);
+}
+
+__global__ void add(Bf16* destination, const Bf16* value, int count) {
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index < count) destination[index] = bf16(fp32(destination[index]) + fp32(value[index]));
+}
+
+template <bool maximum = false>
+__device__ inline float block_reduce(float value, float* partial) {
+    constexpr int warps = threads / 32;
+    int lane = threadIdx.x % 32;
+    for (int delta = 16; delta; delta /= 2) {
+        float peer = __shfl_down_sync(0xffffffff, value, delta);
+        value = maximum ? fmaxf(value, peer) : value + peer;
+    }
+    if (lane == 0) partial[threadIdx.x / 32] = value;
+    __syncthreads();
+    float total = partial[0];
+    for (int warp = 1; warp < warps; ++warp) {
+        total = maximum ? fmaxf(total, partial[warp]) : total + partial[warp];
+    }
+    __syncthreads();
+    return total;
+}
+
+__global__ void layer_norm(const Bf16* input, const Bf16* weight, const Bf16* bias, Bf16* output) {
+    __shared__ float partial[threads / 32];
+    int start = blockIdx.x * hidden;
+    float sum = 0.0f;
+    for (int channel = threadIdx.x; channel < hidden; channel += threads) {
+        sum += fp32(input[start + channel]);
+    }
+    float mean = block_reduce(sum, partial) / float(hidden);
+    float squares = 0.0f;
+    for (int channel = threadIdx.x; channel < hidden; channel += threads) {
+        float delta = fp32(input[start + channel]) - mean;
+        squares = fmaf(delta, delta, squares);
+    }
+    float inverse = rsqrtf(block_reduce(squares, partial) / float(hidden) + 1.0e-6f);
+    for (int channel = threadIdx.x; channel < hidden; channel += threads) {
+        float normalized = (fp32(input[start + channel]) - mean) * inverse;
+        output[start + channel] = bf16(normalized * fp32(weight[channel]) + fp32(bias[channel]));
+    }
+}
+
+__global__ void rope_table(float2* table, Grid grid) {
+    constexpr int frequencies = head_width / 4;
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index >= grid.frame() * (head_width / 2)) return;
+    int row, column;
+    coordinates(grid, index / (head_width / 2), row, column);
+    int frequency = index % (head_width / 2);
+    float fraction = float(frequency % frequencies) / float(frequencies);
+    float inverse = 1.0f / powf(10000.0f, fraction);
+    float angle = float(frequency < frequencies ? row : column) * inverse;
+    sincosf(angle, &table[index].y, &table[index].x);
+}
+
+__global__ void apply_rope(const Bf16* qkv, const float2* table, Bf16* qk, Grid grid) {
+    constexpr int half = head_width / 2;
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index >= grid.patches() * 2 * hidden) return;
+    int row = index / (2 * hidden);
+    int local = index % (2 * hidden);
+    int channel = local % head_width;
+    int source = row * 3 * hidden + local;
+    float2 angle = table[(row % grid.frame()) * half + channel % half];
+    float partner = channel < half ? -fp32(qkv[source + half]) : fp32(qkv[source - half]);
+    qk[index] = bf16(fp32(qkv[source]) * angle.x + partner * angle.y);
+}
+
+__global__ void attention(const Bf16* qk, const Bf16* qkv, Bf16* context, int frame) {
+    extern __shared__ float scores[];
+    __shared__ float partial[threads / 32];
+    int row = blockIdx.x;
+    int head = blockIdx.y * head_width;
+    int first = row / frame * frame;
+    const Bf16* query = qk + row * 2 * hidden + head;
+    float max_score = -CUDART_INF_F;
+    for (int key_row = threadIdx.x; key_row < frame; key_row += threads) {
+        const Bf16* key = qk + (first + key_row) * 2 * hidden + hidden + head;
+        float dot = 0.0f;
+        for (int channel = 0; channel < head_width; ++channel) {
+            dot = fmaf(fp32(query[channel]), fp32(key[channel]), dot);
+        }
+        constexpr float scaling = 0.11785113019775792f;
+        float score = fp32(bf16(fp32(bf16(dot)) * scaling));
+        scores[key_row] = score;
+        max_score = fmaxf(max_score, score);
+    }
+    max_score = block_reduce<true>(max_score, partial);
+    float sum = 0.0f;
+    for (int key_row = threadIdx.x; key_row < frame; key_row += threads) {
+        float exp_score = expf(scores[key_row] - max_score);
+        scores[key_row] = exp_score;
+        sum += exp_score;
+    }
+    sum = block_reduce(sum, partial);
+    for (int key_row = threadIdx.x; key_row < frame; key_row += threads) {
+        scores[key_row] = fp32(bf16(scores[key_row] / sum));
+    }
+    __syncthreads();
+    if (threadIdx.x < head_width) {
+        int channel = head + threadIdx.x;
+        float result = 0.0f;
+        for (int key_row = 0; key_row < frame; ++key_row) {
+            auto value = qkv[(first + key_row) * 3 * hidden + 2 * hidden + channel];
+            result = fmaf(scores[key_row], fp32(value), result);
+        }
+        context[row * hidden + channel] = bf16(result);
+    }
+}
+
+template <bool approximate>
+__global__ void gelu(Bf16* data, int count) {
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index >= count) return;
+    float value = fp32(data[index]);
+    float gate = approximate
+        ? tanhf(0.7978845608028654f * (value + 0.044715f * value * value * value))
+        : erff(value * 0.7071067811865475f);
+    data[index] = bf16(0.5f * value * (1.0f + gate));
+}
+
+}
diff --git a/vision/encoder/main.cu b/vision/encoder/main.cu
new file mode 100644
index 0000000..0f4c653
--- /dev/null
+++ b/vision/encoder/main.cu
@@ -0,0 +1,108 @@
+#include "encoder.cuh"
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+
+namespace fs = std::filesystem;
+using vision::check;
+
+class Stream {
+public:
+    Stream() { check(cudaStreamCreateWithFlags(&handle_, cudaStreamNonBlocking), "Create stream"); }
+    ~Stream() {
+        cudaStreamSynchronize(handle_);
+        cudaStreamDestroy(handle_);
+    }
+    Stream(const Stream&) = delete;
+    Stream& operator=(const Stream&) = delete;
+    cudaStream_t get() const { return handle_; }
+
+private:
+    cudaStream_t handle_ = nullptr;
+};
+
+template <typename Container>
+void read_exact(const fs::path& path, Container& container) {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    auto bytes = container.size() * sizeof(typename Container::value_type);
+    if (!file || file.tellg() != static_cast<std::streamoff>(bytes) ||
+        !file.seekg(0) || !file.read(reinterpret_cast<char*>(container.data()), bytes)) {
+        throw std::runtime_error("Cannot read exact tensor bytes from " + path.string());
+    }
+}
+
+void execute(const vision::Weights& weights, const fs::path& fixture, const fs::path& output,
+             bool final_only) {
+    std::array<std::int64_t, 3> shape{};
+    read_exact(fixture / "grid.i64", shape);
+    vision::Workspace work(shape);
+    std::vector<float> patches(work.rows * vision::patch_width);
+    read_exact(fixture / "patch.f32", patches);
+    vision::DeviceBuffer<float> device_patch(patches.size());
+    check(cudaMemcpy(device_patch.get(), patches.data(), patches.size() * sizeof(float),
+                     cudaMemcpyHostToDevice), "Upload patches");
+    vision::Trace trace(output);
+    Stream stream;
+    vision::Execution execution(work, stream.get(), final_only ? nullptr : &trace);
+    auto result = execution.enqueue(weights, device_patch.get());
+    trace.save("embeddings", result.device, result.rows * vision::text_width, stream.get());
+    std::printf("%s grid=[%d,%d,%d] patch_rows=%d merged_rows=%d text_width=%d\n",
+                output.parent_path().filename().c_str(), work.grid.time, work.grid.height,
+                work.grid.width, work.rows, result.rows, vision::text_width);
+}
+
+void describe_device() {
+    int count = 0;
+    check(cudaGetDeviceCount(&count), "Enumerate devices");
+    if (count != 1) throw std::runtime_error("Expose exactly one allocated GPU by UUID");
+    check(cudaSetDevice(0), "Select allocated GPU");
+    cudaDeviceProp device{};
+    int driver = 0, runtime = 0;
+    check(cudaGetDeviceProperties(&device, 0), "Read device properties");
+    check(cudaDriverGetVersion(&driver), "Read driver API version");
+    check(cudaRuntimeGetVersion(&runtime), "Read runtime version");
+    if (device.major != 10 || device.minor != 0) {
+        throw std::runtime_error("Harness requires SM100");
+    }
+    std::printf("device=%s compute=%d.%d driver_api=%d runtime=%d pci=%04x:%02x:%02x uuid=",
+                device.name, device.major, device.minor, driver, runtime, device.pciDomainID,
+                device.pciBusID, device.pciDeviceID);
+    for (unsigned char byte : device.uuid.bytes) std::printf("%02x", byte);
+    std::printf("\n");
+}
+
+}
+
+int main(int argc, char** argv) {
+    try {
+        if (argc < 4) {
+            std::fputs("usage: vision-encoder SHARD FIXTURE OUT [--final-only] [FIXTURE OUT ...]\n",
+                       stderr);
+            return 2;
+        }
+        describe_device();
+        vision::Weights weights(argv[1]);
+        bool final_only = false;
+        for (int argument = 2; argument < argc;) {
+            if (std::string_view(argv[argument]) == "--final-only") {
+                final_only = true;
+                ++argument;
+                continue;
+            }
+            if (argument + 1 >= argc) throw std::runtime_error("Missing fixture output path");
+            execute(weights, argv[argument], argv[argument + 1], final_only);
+            argument += 2;
+        }
+        return 0;
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+}
