+
+os.environ["CUDA_VISIBLE_DEVICES"] = ""
+os.environ["HF_HUB_OFFLINE"] = "1"
+os.environ["TRANSFORMERS_OFFLINE"] = "1"
+
+import cv2
+import numpy as np
+from PIL import Image
+import torch
+from transformers import AutoConfig, AutoProcessor
+from transformers.models.qwen2_vl.image_processing_qwen2_vl import smart_resize as image_resize
+from transformers.models.qwen3_5 import modeling_qwen3_5 as hf_model
+from transformers.models.qwen3_vl.video_processing_qwen3_vl import smart_resize as video_resize
+from transformers.video_utils import VideoMetadata
+from transformers.vision_utils import get_vision_cu_seqlens, get_vision_position_ids
+
+REVISION = "df9335cb5ce2f1f8e4f462c0b3c5d76a9c513250"
+VLLM_REVISION = "81a8cb063e6247fe254d7caf7e98a6691d71022a"
+SGLANG_REVISION = "f04d886bf79aa3d6237cbb12a3311838eb9f9bd8"
+ROOT = Path(__file__).resolve().parents[2]
+SGLANG_SOURCES = {
+    "multimodal/processors/base_processor.py": "2cfb2cd68459f3b3f4fbe9716b0d3469256eab3273f052fd6e13b7b86a336303",
+    "managers/mm_utils.py": "590dc056497a2b538e45da4483cdde79971d1be55efa6f7e8e07decb7bd7464b",
+    "layers/rotary_embedding/mrope.py": "49c1c1ccc46a13ed03a7409e94e39af6cc9107c3d728ffe2ac19ba86bbb04ce3",
+    "multimodal/mrope_rope_index.py": "bd334526334db73b8ad365ec42676cda664f0da0fdde667140d640251890707d",
+    "models/qwen3_5.py": "aad0f8801099d8a95855026524fec0bd5248ce774dbdb40e23c73c59fcee2e9d",
+    "models/qwen3_vl.py": "a7979e1fe7606d0acede19e41653adc5ce480cc1a6c7df253f3196f3ac7b8741",
+    "multimodal/processors/qwen_vl.py": "73b9e39634eba079738bb80271aeecad5bfdce0ffd5d51c0911a9ec260a3c216",
+    "multimodal/qwen_vl_media_processing.py": "359eb630b837c158f43462dcd6eb7620d5a3b7fd063a3be48206f321881fe3bc",
+}
+LANGUAGE = {"image": 248056, "video": 248057}
+VLLM_METHODS = ["_iter_mm_grid_hw", "_get_mrope_input_positions"]
+SOURCE_DATE = "2026-11-19"
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def pinned(relative):
+    return subprocess.check_output(["git", "-C", ROOT, "show", f"{REVISION}:{relative}"])
+
+
+def save_json(path, obj):
+    path.write_text(json.dumps(obj, indent=2) + "\n")
+
+
+def exact(path, expected, dtype):
+    expected = np.asarray(expected, dtype=dtype)
+    actual = np.fromfile(path, dtype=dtype)
+    np.testing.assert_array_equal(actual, expected.ravel(), err_msg=str(path))
+    return sha(actual.tobytes())
+
+
+def load_vllm_position_methods(path):
+    tree = ast.parse(path.read_text())
+    node, = [item for item in tree.body if isinstance(item, ast.ClassDef)
+             and item.name == "Qwen3VLForConditionalGeneration"]
+    methods = [item for item in node.body if isinstance(item, ast.FunctionDef)
+               and item.name in VLLM_METHODS]
+    assert sorted(item.name for item in methods) == sorted(VLLM_METHODS)
+    isolated_class = ast.ClassDef(name=node.name, bases=[], keywords=[], body=methods, decorator_list=[])
+    module = ast.fix_missing_locations(ast.Module(body=[isolated_class], type_ignores=[]))
+    scope = {"np": np, "torch": torch}
+    exec(compile(module, str(path), "exec", flags=__future__.annotations.compiler_flag), scope)
+    return scope[node.name]
+
+
+def load_sglang_methods():
+    sources = Path(__file__).resolve().with_name("sources")
+    for relative, digest in SGLANG_SOURCES.items():
+        assert sha((sources / Path(relative).name).read_bytes()) == digest, relative
+    spec = spec_from_file_location("pinned_sglang_positions", sources / "mrope_rope_index.py")
+    module = module_from_spec(spec)
+    spec.loader.exec_module(module)
+    path = sources / "qwen_vl.py"
+    method, = [node for node in ast.walk(ast.parse(path.read_text()))
+               if isinstance(node, ast.FunctionDef) and node.name == "build_input_ids_with_timestamps"]
+    scope = {"Modality": SimpleNamespace(IMAGE="image", VIDEO="video")}
+    exec(compile(ast.Module(body=[method], type_ignores=[]), str(path), "exec"), scope)
+    return module.get_rope_index, scope[method.name]
+
+
+def frozen(name, inputs, processor):
+    case_raw = pinned(f"benchmarks/media/{name}.case.json")
+    case = json.loads(case_raw)
+    raw = pinned(f"benchmarks/media/{name}.http-body")
+    assert sha(raw) == case["request_sha256"] and len(raw) == case["request_bytes"]
+    request = json.loads(raw)
+    message = request["messages"][0]
+    media, text = message["content"]
+    url = media[media["type"]]["url"]
+    prefix = f'data:{case["mime"]};base64,'
+    assert url.startswith(prefix)
+    payload = base64.b64decode(url[len(prefix):], validate=True)
+    assert len(payload) == case["media_bytes"] and sha(payload) == case["media_sha256"]
+    media_file = inputs / case["media_file"]
+    media_file.write_bytes(payload)
+    template_message = {**message, "content": [{"type": media["type"].removesuffix("_url")}, text]}
+    rendered = processor.apply_chat_template(
+        [template_message], tokenize=False, add_generation_prompt=True, enable_thinking=False
+    )
+    assert rendered == "".join(case["template_rendered_segments"])
+    assert text["text"] == "".join(case["text_segments"])
+    expected = case["media"]
+    if name == "W1-image":
+        frames = np.asarray(Image.open(io.BytesIO(payload)).convert("RGB"))[None, ...]
+        assert list(frames.shape[1:]) == expected["decoded_shape"]
+        assert sha(frames.tobytes()) == expected["decoded_rgb8_sha256"]
+        return case, rendered, frames, None, {"case_sha256": sha(case_raw)}
+    capture = cv2.VideoCapture(str(media_file), cv2.CAP_FFMPEG)
+    assert capture.isOpened()
+    fps = capture.get(cv2.CAP_PROP_FPS)
+    assert fps == expected["fps"]
+    decoded, pts = [], []
+    while True:
+        success, bgr = capture.read()
+        if not success:
+            break
+        pts.append(capture.get(cv2.CAP_PROP_POS_MSEC) / 1000)
+        decoded.append(cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB))
+    capture.release()
+    assert [sha(frame.tobytes()) for frame in decoded] == expected["decoded_rgb8_sha256"]
+    assert all(list(frame.shape) == expected["decoded_frame_shape"] for frame in decoded)
+    assert pts == expected["source_pts_seconds"]
+    io_kwargs = request["media_io_kwargs"]["video"]
+    assert io_kwargs["backend"] == io_kwargs["video_backend"] == "opencv"
+    assert request["mm_processor_kwargs"]["do_sample_frames"] is False
+    indices = np.linspace(0, len(decoded) - 1, min(io_kwargs["num_frames"], len(decoded)),
+                          dtype=int).tolist()
+    assert indices == expected["sample_indices"]
+    metadata = dict(expected["loader_metadata"])
+    assert metadata.pop("do_sample_frames") is False
+    assert metadata["frames_indices"] == indices
+    return (case, rendered, np.stack(decoded)[indices], metadata,
+            {"case_sha256": sha(case_raw), "decoded_frame_hashes": expected["decoded_rgb8_sha256"],
+             "selected_indices": indices, "pts_seconds": pts, "loader_metadata": expected["loader_metadata"]})
+
+
+def synthetic(name, modality, count, height, width, processor):
+    rng = np.random.default_rng(406921)
+    frames = rng.integers(0, 256, (count, height, width, 3), dtype=np.uint8)
+    content = [{"type": modality}, {"type": "text", "text": f"Describe {name}."}]
+    rendered = processor.apply_chat_template([{"role": "user", "content": content}],
+                                             tokenize=False, add_generation_prompt=True,
+                                             enable_thinking=False)
+    metadata = None
+    if modality == "video":
+        indices = [0, 2, 7, 9, 10][:count] if count > 1 else [7]
+        metadata = dict(total_num_frames=11, fps=4.0, frames_indices=indices)
+    return None, rendered, frames, metadata, {}
+
+
+def write_timestamp_dictionary(inputs, processor, metadata, frames):
+    if metadata is None:
+        return []
+    indices = metadata["frames_indices"]
+    fps = metadata["fps"]
+    stamps = [(indices[start] / fps + indices[min(start + 1, frames - 1)] / fps) / 2
+              for start in range(0, frames, 2)]
+    with (inputs / "timestamps.txt").open("w") as output:
+        for label in sorted({f"{seconds:.1f}" for seconds in stamps}):
+            tokens = processor.tokenizer(f"<{label} seconds>", add_special_tokens=False).input_ids
+            print(label, len(tokens), *tokens, file=output)
+    return stamps
+
+
+def run_case(name, native, output, processor, config, vllm_positions, sglang_methods, edge=None):
+    inputs = output / name / "input"
+    inputs.mkdir(parents=True)
+    modality = ("image" if name == "W1-image" else "video") if edge is None else edge[0]
+    case, rendered, frames, metadata, extra = (
+        frozen(name, inputs, processor) if edge is None else synthetic(name, *edge, processor)
+    )
+    frame_count, height, width, _ = frames.shape
+    video = modality == "video"
+    duplicate_single = video and frame_count == 1
+    indices = [] if metadata is None else metadata["frames_indices"]
+    fps = 0 if metadata is None else metadata["fps"]
+    (inputs / "input.txt").write_text(
+        f"{modality} {height} {width} {frame_count} {int(duplicate_single)} {fps}\n"
+        + " ".join(map(str, indices)) + "\n"
+    )
+    frames.tofile(inputs / "frames.rgb8")
+    template = processor.tokenizer(rendered, add_special_tokens=False).input_ids
+    np.asarray(template, dtype="<i8").tofile(inputs / "template.i64")
+    timestamps = write_timestamp_dictionary(inputs, processor, metadata, frame_count)
+    media_kwargs = {"images": Image.fromarray(frames[0])}
+    if video:
+        oracle_frames = np.repeat(frames, 2, axis=0) if duplicate_single else frames
+        oracle_meta = dict(metadata)
+        oracle_meta["frames_indices"] = indices * 2 if duplicate_single else indices.copy()
+        media_kwargs = {"videos": [oracle_frames], "video_metadata": [VideoMetadata(**oracle_meta)],
+                        "do_sample_frames": False, "cap_pixels_per_frame": False}
+    reference = processor(text=[rendered], return_tensors="pt", **media_kwargs)
+    discrete = processor(text=[rendered], return_tensors="pt", **media_kwargs,
+                         do_normalize=False, do_rescale=False)
+    pixel_key = "pixel_values_videos" if video else "pixel_values"
+    reference_pixels = reference[pixel_key].numpy()
+    reference_bytes = discrete[pixel_key].numpy()
+    assert reference_bytes.dtype == np.uint8 and reference_pixels.dtype == np.float32
+    grid = reference[f"{modality}_grid_thw"]
+    time, grid_h, grid_w = map(int, grid[0])
+    assert reference_pixels.shape == (time * grid_h * grid_w, 1536)
+    ids = reference.input_ids[0].tolist()
+    count = grid_h * grid_w // 4
+    runs = [list(items) for visual, items in groupby(enumerate(ids), lambda item: item[1] == LANGUAGE[modality])
+            if visual]
+    spans = np.array([[items[0][0], len(items), group * count, group * grid_h * grid_w, grid_h * grid_w]
+                      for group, items in enumerate(runs)], dtype="<i8")
+    positions_from_spans = [offset for start, length, *_ in spans
+                            for offset in range(start, start + length)]
+    assert len(spans) == time and all(length == count for _, length, *_ in spans)
+    assert positions_from_spans == [index for index, token in enumerate(ids) if token == LANGUAGE[modality]]
+    assert all(ids[start - 1] == 248053 and ids[start + length] == 248054 for start, length, *_ in spans)
+    dummy_hf = SimpleNamespace(config=config)
+    dummy_hf.get_vision_position_ids = hf_model.Qwen3_5Model.get_vision_position_ids.__get__(dummy_hf)
+    positions, delta = hf_model.Qwen3_5Model.get_rope_index(
+        dummy_hf, reference.input_ids, reference.mm_token_type_ids, **{f"{modality}_grid_thw": grid}
+    )
+    vllm_feature = SimpleNamespace(
+        modality=modality, mm_position=SimpleNamespace(offset=template.index(LANGUAGE[modality])),
+        data={f"{modality}_grid_thw": SimpleNamespace(data=grid[0])},
+    )
+    vllm_ids, vllm_delta = vllm_positions._get_mrope_input_positions(ids, [vllm_feature], config)
+    vllm_spans = list(vllm_positions._iter_mm_grid_hw(ids, [vllm_feature], 248057, 248053, 248054, 2))
+    assert vllm_spans == [(start, grid_h // 2, grid_w // 2, length) for start, length, *_ in spans]
+    torch.testing.assert_close(positions[:, 0, :], vllm_ids, rtol=0, atol=0)
+    assert delta.item() == vllm_delta
+    sglang_positions, sglang_builder = sglang_methods
+    sglang_pos, sglang_delta = sglang_positions(
+        2, 248056, 248057, 248053, config.model_type, input_ids=reference.input_ids,
+        **{f"{modality}_grid_thw": grid},
+    )
+    assert torch.equal(sglang_pos, positions) and torch.equal(sglang_delta, delta)
+    sglang_processor = SimpleNamespace(
+        IM_TOKEN_ID=248056, VIDEO_TOKEN_ID=248057, spatial_merge_size=2,
+        vision_start_token_id=248053, vision_end_token_id=248054, _processor=processor,
+    )
+    sglang_ids, sglang_spans, modalities = sglang_builder(
+        sglang_processor, template, None, None if video else grid, grid if video else None,
+        [timestamps] if video else None,
+    )
+    assert list(map(int, sglang_ids)) == ids
+    assert sglang_spans == [(start, start + length - 1) for start, length, *_ in spans]
+    assert modalities == [modality] * len(spans)
+    cu = get_vision_cu_seqlens(grid)
+    vision_hw = get_vision_position_ids(grid, config.vision_config.spatial_merge_size)
+    if case:
+        assert template == case["template_ids"]
+        assert grid[0].tolist() == case["grid_thw"]
+        assert ids == case["effective_input_ids"]
+        assert positions_from_spans == case["visual_input_positions"]
+        assert sha(reference_pixels.tobytes()) == case["processor_pixel_values"]["sha256"]
+        assert sha(json.dumps(ids, separators=(",", ":")).encode()) == case["effective_input_sha256"]
+        extra.update({key: case[key] for key in ("request_sha256", "media_sha256", "effective_input_sha256")})
+        if video:
+            assert timestamps == case["media"]["model_timestamps_seconds"]
+    target = output / name / "native"
+    subprocess.run([native, inputs, target], check=True)
+    oracle = output / name / "oracle"
+    oracle.mkdir()
+    arrays = {
+        "grid.i64": grid, "ids.i64": ids, "spans.i64": spans,
+        "positions.i64": positions[:, 0, :], "delta.i64": delta, "vision_hw.i64": vision_hw,
+        "vision_cu.i64": cu,
+    }
+    for artifact, array in arrays.items():
+        np.asarray(array, dtype="<i8").tofile(oracle / artifact)
+    reference_bytes.tofile(oracle / "patch.u8")
+    reference_pixels.tofile(oracle / "patch.f32")
+    hashes = {artifact: exact(target / artifact, array, "<i8") for artifact, array in arrays.items()}
+    actual = np.fromfile(target / "patch.f32", dtype="<f4").reshape(reference_pixels.shape)
+    actual_byte = np.fromfile(target / "patch.u8", dtype="u1").reshape(reference_bytes.shape)
+    errors = np.abs(actual.astype(np.float64) - reference_pixels)
+    byte_errors = np.abs(actual_byte.astype(np.int16) - reference_bytes)
+    report = {
+        "case": name, "frames_hwc": list(frames.shape), "decoded_rgb_sha256": sha(frames.tobytes()),
+        "timestamps_seconds": timestamps, "formatted_timestamps": [f"<{time:.1f} seconds>" for time in timestamps],
+        "grid_thw": grid[0].tolist(), "patch_shape": list(reference_pixels.shape),
+        "embed_shape": [len(positions_from_spans), config.vision_config.out_hidden_size],
+        "spans": spans.tolist(), "token_count": len(ids), "language_mrope_delta": delta.item(),
+        "first_decode_position": len(ids) + delta.item(), "vision_cu": cu.tolist(),
+        "pinned_sglang_tokens_inclusive_offsets_and_positions_exact": True,
+        "pinned_vllm_offsets_and_positions_exact": True,
+        "hashes_of_exact_discrete_outputs": hashes, "reference_patch_u8_sha256": sha(reference_bytes.tobytes()),
+        "native_patch_u8_sha256": sha(actual_byte.tobytes()),
+        "reference_patch_f32_sha256": sha(reference_pixels.tobytes()),
+        "native_patch_f32_sha256": sha(actual.tobytes()),
+        "uint8_differing_elements": int(np.count_nonzero(byte_errors)), "uint8_max_abs": int(byte_errors.max()),
+        "float32_differing_elements": int(np.count_nonzero(actual.view("<u4") != reference_pixels.view("<u4"))),
+        "float32_max_abs": float(errors.max()), "float32_rmse": float(np.sqrt(np.mean(errors**2))),
+        **extra,
+    }
+    print(json.dumps(report), flush=True)
+    assert report["uint8_differing_elements"] == report["float32_differing_elements"] == 0, name
+    return report
+
+
+def negative_checks(run, native, processor):
+    root = run / "rejected"
+    root.mkdir()
+    examples = {
+        "zero_height": ("video 0 32 2 0 4\n0 1\n", b"", "invalid frame size or count"),
+        "zero_frames": ("video 32 32 0 0 4\n", b"", "invalid frame size or count"),
+        "single_strict": ("video 33 47 1 0 4\n7\n", b"", "video resize requires at least two frames"),
+        "bad_fps": ("video 32 32 2 0 0\n0 1\n", b"", "invalid source fps"),
+        "short_rgb": ("image 32 32 1 0 0\n", b"\x00", "decoded byte count differs from metadata"),
+        "bad_aspect": ("image 10 2001 1 0 0\n", bytes(10 * 2001 * 3), "aspect ratio exceeds 200"),
+        "unsorted_timing": ("video 32 32 2 0 4\n7 2\n", b"", "frame indices must be nondecreasing"),
+    }
+    for name, (meta, raw, error) in examples.items():
+        inputs = root / name
+        inputs.mkdir()
+        (inputs / "input.txt").write_text(meta)
+        (inputs / "frames.rgb8").write_bytes(raw)
+        result = subprocess.run([native, inputs, inputs / "output"], capture_output=True, text=True)
+        assert result.returncode == 1 and result.stderr.strip() == error
+        assert not (inputs / "output").exists()
+    frames = np.zeros((1, 33, 47, 3), dtype=np.uint8)
+    try:
+        processor.video_processor(frames, do_sample_frames=False, cap_pixels_per_frame=False, return_tensors="pt")
+    except ValueError as error:
+        assert str(error) == "t:1 must be larger than temporal_factor:2"
+        examples["processor_single_strict"] = (None, None, str(error))
+    else:
+        raise AssertionError("expected the pinned processor to reject a single frame before resize")
+    return {name: error for name, (_, _, error) in examples.items()}
+
+
+def compare_resize_shapes(native, processor):
+    cases = [("image", 1, 1, 199), ("image", 1, 4097, 4129),
+             ("video", 2, 32, 32), ("video", 3, 2047, 4101), ("video", 5, 3001, 2457)]
+    results = []
+    for modality, frames, height, width in cases:
+        video = modality == "video"
+        size = (processor.video_processor if video else processor.image_processor).size
+        kwargs = dict(factor=32, min_pixels=size["shortest_edge"], max_pixels=size["longest_edge"])
+        expected = video_resize(frames, height, width, **kwargs) if video else image_resize(height, width, **kwargs)
+        result = subprocess.check_output([native, "--resize-shape"], text=True,
+                                         input=f"{modality} {height} {width} {frames}\n")
+        assert tuple(map(int, result.split())) == expected
+        results.append({"modality": modality, "source_thw": [frames, height, width], "resized_hw": expected})
+    return results
+
+
+def vision_inventory(checkpoint, run):
+    index = json.loads((checkpoint / "model.safetensors.index.json").read_bytes())["weight_map"]
+    names = {name: shard for name, shard in index.items() if name.startswith("model.visual.")}
+    assert set(names.values()) == {"outside.safetensors"}
+    with (checkpoint / "outside.safetensors").open("rb") as shard:
+        prefix = shard.read(8)
+        length, = struct.unpack("<Q", prefix)
+        assert 0 < length < 1000000
+        raw = shard.read(length)
+        header = json.loads(raw)
+    assert set(names) == {name for name in header if name.startswith("model.visual.")}
+    records = {}
+    for name in sorted(names):
+        entry = header[name]
+        begin, end = entry["data_offsets"]
+        assert entry["dtype"] == "BF16" and np.prod(entry["shape"]) * 2 == end - begin
+        assert end + length + 8 <= (checkpoint / names[name]).stat().st_size
+        records[name] = {"shape": entry["shape"], "dtype": entry["dtype"],
+                         "file_byte_offset": begin + length + 8, "bytes": end - begin}
+    count = len(records)
+    total = sum(record["bytes"] for record in records.values())
+    assert count == 333
+    save_json(run / "vision-weights.json",
+              {"shard": "outside.safetensors", "header_sha256": sha(prefix + raw),
+               "tensor_count": count, "vision_payload_bytes": total, "tensors": records})
+    return {"tensor_count": count, "vision_payload_bytes": total, "header_sha256": sha(prefix + raw)}
+
