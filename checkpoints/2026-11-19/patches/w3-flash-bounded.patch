+#pragma once
+
+#include "sglang/mxfp8_gqa.h"
+
+namespace study {
+
+enum class Method {
+    baseline, ordered, scalar, vector, split16, split32, split64, split128, split256,
+    bounded16, bounded32
+};
+
+constexpr int heads = sglang::mxfp8_query_heads;
+constexpr int width = sglang::mxfp8_head_dim;
+constexpr int query_elements = heads * width;
+
+struct Partial {
+    float maximum;
+    float denominator;
+    float numerator[width];
+};
+
+int slots(Method method, int capacity);
+int active_slots(Method method, int capacity, int visible);
+const char* name(Method method);
+cudaError_t attention(Method method, sglang::Mxfp8KvCache cache, sglang::Mxfp8PageTable pages,
+                      int capacity, const int* position, const __nv_bfloat16* query,
+                      __nv_bfloat16* output, Partial* scratch, int scratch_slots,
+                      cudaStream_t stream);
+cudaError_t check_scale_decode(unsigned int* mismatches, cudaStream_t stream);
+cudaError_t bounded16(sglang::Mxfp8KvCache cache, sglang::Mxfp8PageTable pages,
+                      int capacity, int position, const __nv_bfloat16* query,
+                      __nv_bfloat16* output, Partial* scratch, cudaStream_t stream);
+
+}
