+std::optional<cudaError_t> try_gate_up_pair(GateUpWeights weights, int n, int k,
+                                          const GateUpRow* rows, int count, bool fuse_epilogue,
+                                          cudaStream_t stream) {
+    if (n <= 0 || k <= 0 || !rows || count < 2 || count > text_fp8_max_batch ||
+        !weights.gate_values || !weights.up_values || !weights.gate_scales ||
+        !weights.up_scales || !aligned(weights.gate_scales, alignof(__nv_bfloat16)) ||
+        !aligned(weights.up_scales, alignof(__nv_bfloat16))) {
+        return std::nullopt;
+    }
+    for (int index = 0; index < count; ++index) {
+        const auto& row = rows[index];
+        if (!row.input.values || !row.input.scales || !row.gate ||
+            (!fuse_epilogue && !row.up) || !aligned(row.input.scales, alignof(float)) ||
+            !aligned(row.gate, alignof(__nv_bfloat16)) ||
+            (!fuse_epilogue && !aligned(row.up, alignof(__nv_bfloat16))) ||
+            !supports_wide_fp8(weights.gate_values, row.input, k) ||
+            !supports_wide_fp8(weights.up_values, row.input, k)) {
+            return std::nullopt;
+        }
+    }
+    switch (count) {
+    case 2: return launch_gate_up_pair<2>(weights, n, k, rows, fuse_epilogue, stream);
+    case 3: return launch_gate_up_pair<3>(weights, n, k, rows, fuse_epilogue, stream);
+    case 4: return launch_gate_up_pair<4>(weights, n, k, rows, fuse_epilogue, stream);
+    case 5: return launch_gate_up_pair<5>(weights, n, k, rows, fuse_epilogue, stream);
+    }
+    return std::nullopt;
 }
 
