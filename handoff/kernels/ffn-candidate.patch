+template <int Count>
+struct GateUpRows {
+    GateUpRow entries[Count];
+};
+
+template <int Count>
+__global__ void gate_up_pair_kernel(GateUpWeights weights, int n, int k, int groups,
+                                    GateUpRows<Count> rows, bool fuse_epilogue) {
+    const int lane = threadIdx.x % warp_width;
+    const int row = blockIdx.x * fp8_packed_warps + threadIdx.x / warp_width;
+    if (row >= n) {
+        return;
+    }
+    const auto row_offset = static_cast<std::size_t>(row) * k;
+    const int lane_group = lane / (warp_width / fp8_groups_per_warp);
+    const auto scale_offset = static_cast<std::size_t>(row / text_fp8_group_size) * groups +
+                              lane_group;
+    float gate_sums[Count]{};
+    float up_sums[Count]{};
+    for (int group = 0; group < groups; group += fp8_groups_per_warp) {
+        const auto col = static_cast<std::size_t>(group) * text_fp8_group_size +
+                         lane * fp8_pack_bytes;
+        const auto gate_weight = load_fp8_weight(weights.gate_values + row_offset + col);
+        const auto up_weight = load_fp8_weight(weights.up_values + row_offset + col);
+        const float gate_scale = __bfloat162float(weights.gate_scales[scale_offset + group]);
+        const float up_scale = __bfloat162float(weights.up_scales[scale_offset + group]);
+#pragma unroll
+        for (int index = 0; index < Count; ++index) {
+            const auto input = rows.entries[index].input;
+            const auto rhs = load_128(input.values + col);
+            const float scale = input.scales[group + lane_group];
+            gate_sums[index] = fmaf(fp8_pack_dot(gate_weight, rhs) * scale, gate_scale,
+                                   gate_sums[index]);
+            up_sums[index] = fmaf(fp8_pack_dot(up_weight, rhs) * scale, up_scale,
+                                 up_sums[index]);
+        }
+    }
+#pragma unroll
+    for (int index = 0; index < Count; ++index) {
+        const float gate_sum = warp_sum(gate_sums[index]);
+        const float up_sum = warp_sum(up_sums[index]);
+        if (lane == 0) {
+            const auto gate = __float2bfloat16_rn(gate_sum);
+            const auto up = __float2bfloat16_rn(up_sum);
+            if (fuse_epilogue) {
+                rows.entries[index].gate[row] = swiglu(gate, up);
+            } else {
+                rows.entries[index].gate[row] = gate;
+                rows.entries[index].up[row] = up;
+            }
+        }
+    }
+}
+
+template <int Count>
+cudaError_t launch_gate_up_pair(GateUpWeights weights, int n, int k, const GateUpRow* rows,
+                                bool fuse_epilogue, cudaStream_t stream) {
+    GateUpRows<Count> batch{};
+    std::copy_n(rows, Count, batch.entries);
+    int groups = text_fp8_group_count(k);
+    void* args[]{&weights, &n, &k, &groups, &batch, &fuse_epilogue};
+    return cudaLaunchKernel(gate_up_pair_kernel<Count>, divide_up(n, fp8_packed_warps),
+                            fp8_packed_warps * warp_width, args, 0, stream);
+}
