+cudaError_t swiglu_fp8_rows(const SwigluFp8Row* rows, int count, int width,
+                           cudaStream_t stream) {
+    if (!rows || count < 1 || count > swiglu_fp8_max_rows || width <= 0) {
+        return cudaErrorInvalidValue;
+    }
+    for (int index = 0; index < count; ++index) {
+        const auto& row = rows[index];
+        if (!row.gate || !row.up || !row.output.values || !row.output.scales) {
+            return cudaErrorInvalidValue;
+        }
+    }
+    if (count <= 4) {
+        return launch_swiglu_fp8_rows<4>(rows, count, width, stream);
+    }
+    if (count <= 16) {
+        return launch_swiglu_fp8_rows<16>(rows, count, width, stream);
+    }
+    return launch_swiglu_fp8_rows<swiglu_fp8_max_rows>(rows, count, width, stream);
+}
