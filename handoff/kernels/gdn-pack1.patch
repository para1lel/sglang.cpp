+template <int TileRows>
+cudaError_t launch_bf16_row_pack(const __nv_bfloat16* weight, int out_width, int in_width,
+                                const TextBf16Projection* rows, int count, cudaStream_t stream) {
+    Bf16RowPack batch{};
+    std::copy_n(rows, count, batch.entries);
+    void* parameters[] = {&weight, &out_width, &in_width, &count, &batch};
+    const dim3 grid(divide_up(out_width, block_warps), divide_up(count, TileRows));
+    return cudaLaunchKernel(bf16_row_pack_kernel<TileRows>, grid, block_threads,
+                            parameters, 0, stream);
+}
