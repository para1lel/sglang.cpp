+cudaError_t text_bf16_gemv_batch(const __nv_bfloat16* weight, int out_width,
+                                 int in_width, const TextBf16Projection* rows, int count,
+                                 cudaStream_t stream) {
+    if (!weight || !rows || out_width <= 0 || in_width <= 0 || count <= 0) {
+        return cudaErrorInvalidValue;
+    }
+    bool packed = in_width % 8 == 0 && aligned(weight, 16);
+    for (int i = 0; i < count; ++i) {
+        if (!rows[i].input || !rows[i].output) {
+            return cudaErrorInvalidValue;
+        }
+        packed = packed && aligned(rows[i].input, 16);
+    }
+    if (!packed) {
+        for (int i = 0; i < count; ++i) {
+            const auto status = text_bf16_gemv(weight, rows[i].input, out_width, in_width,
+                                              rows[i].output, stream);
+            if (status != cudaSuccess) {
+                return status;
+            }
+        }
+        return cudaSuccess;
+    }
+    while (count > 0) {
+        const int batch = std::min(count, bf16_row_pack_capacity);
+        const auto status = launch_bf16_row_pack<1>(weight, out_width, in_width, rows,
+                                                    batch, stream);
+        if (status != cudaSuccess) {
+            return status;
+        }
+        rows += batch;
+        count -= batch;
+    }
+    return cudaSuccess;
+}
 
