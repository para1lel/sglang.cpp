+constexpr int bf16_row_pack_capacity = 32;
+using Bf16RowPack = Bf16Projections<bf16_row_pack_capacity>;
+
+template <int TileRows>
+__global__ void bf16_row_pack_kernel(const __nv_bfloat16* weight, int out_width, int in_width,
+                                    int count, const __grid_constant__ Bf16RowPack batch) {
+    const int lane = threadIdx.x % warp_width;
+    const int channel = blockIdx.x * block_warps + threadIdx.x / warp_width;
+    if (channel >= out_width) {
+        return;
+    }
+    const int first = blockIdx.y * TileRows;
+    const int active = min(TileRows, count - first);
+    const auto* row_weight = weight + static_cast<std::size_t>(channel) * in_width;
+    float first_sums[TileRows]{};
+    float second_sums[TileRows]{};
+    for (std::size_t column = lane * 8; column < static_cast<std::size_t>(in_width);
+         column += warp_width * 8) {
+        const auto lhs = load_128(row_weight + column);
+        #pragma unroll
+        for (int index = 0; index < TileRows; ++index) {
+            if (index < active) {
+                const auto rhs = load_128(batch.entries[first + index].input + column);
+                first_sums[index] = bf16x2_dot(lhs.x, rhs.x, first_sums[index]);
+                second_sums[index] = bf16x2_dot(lhs.y, rhs.y, second_sums[index]);
+                first_sums[index] = bf16x2_dot(lhs.z, rhs.z, first_sums[index]);
+                second_sums[index] = bf16x2_dot(lhs.w, rhs.w, second_sums[index]);
+            }
+        }
+    }
+    #pragma unroll
+    for (int index = 0; index < TileRows; ++index) {
+        if (index < active) {
+            const float sum = warp_sum(first_sums[index] + second_sums[index]);
+            if (lane == 0) {
+                batch.entries[first + index].output[channel] = __float2bfloat16_rn(sum);
+            }
+        }
+    }
+}
