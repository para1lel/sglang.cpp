+template <bool Value>
+__device__ __forceinline__ void wide_issue_kv(WideRawKv& raw, const decoder::PagedDecodeLane& input,
+                                             int warp, int lane, int first, int end) {
+    const int count = min(wide_keys, end - first);
+    const int page = input.pages.device_pages[first / mxfp8_page_size];
+    const int slot = first % mxfp8_page_size;
+    const auto* payload = Value ? input.cache.value_payload : input.cache.key_payload;
+    const auto* scales = Value ? input.cache.value_scales : input.cache.key_scales;
+    const int channel = (lane % 16) * 16;
+    #pragma unroll 2
+    for (int index = lane / 16; index < wide_keys; index += 2) {
+        if (index < count) {
+            const auto data = payload_offset(page, slot + index, blockIdx.y) + channel;
+            wide_copy_async<16>(&raw.payload[warp][index][channel], payload + data);
+        }
+    }
+    if (lane < count) {
+        const auto exponent = scale_offset(page, slot + lane, blockIdx.y, 0);
+        wide_copy_async<8>(&raw.scales[warp][lane][0], scales + exponent);
+    }
+    asm volatile("cp.async.commit_group;" ::: "memory");
+}
+
+__device__ __forceinline__ void wide_read_kv(WideTile& tile, const WideRawKv& raw,
+                                            int warp, int lane, int count, bool& bad) {
+    asm volatile("cp.async.wait_group 0;" ::: "memory");
+    __syncwarp();
+    const int channel = (lane % 16) * 16;
+    #pragma unroll 2
+    for (int index = lane / 16; index < wide_keys; index += 2) {
+        auto* destination = &tile.kv[warp][index][channel];
+        if (index < count) {
+            const auto words = *reinterpret_cast<const uint4*>(&raw.payload[warp][index][channel]);
+            const auto scale = raw.scales[warp][index][channel / 32];
+            if (scale >= 15 && scale <= 148) {
+                wide_store_vector<true>(destination, words, scale, bad);
+            } else {
+                wide_store_vector<false>(destination, words, scale, bad);
+            }
+        } else {
+            auto* zeros = reinterpret_cast<uint4*>(destination);
+            zeros[0] = zeros[1] = make_uint4(0, 0, 0, 0);
+        }
+    }
+    __syncwarp();
+}
