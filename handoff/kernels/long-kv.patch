+template <int Bytes>
+__device__ __forceinline__ void wide_copy_async(void* target, const void* source) {
+    const auto shared = static_cast<unsigned int>(__cvta_generic_to_shared(target));
+    asm volatile("cp.async.ca.shared.global [%0], [%1], %2;"
+                 :: "r"(shared), "l"(source), "n"(Bytes) : "memory");
+}
