{"model":"benchmark","messages":[{"role":"user","content":[{"type":"video_url","video_url":{"url":"data:video/mp4;base64,"}},{"type":"text","text":"Describe the visible shapes, colors, and motion from the start to the end of this clip. Use plain English so a reader can draw the scene from your description. Begin with a brief overview, then describe the objects one by one. Name the background, foreground, and relative positions. Note any repeated patterns, changes if visible."}]}],"chat_template_kwargs":{"enable_thinking":false},"add_special_tokens":false,"add_generation_prompt":true,"max_tokens":128,"temperature":0,"seed":0,"ignore_eos":true,"return_token_ids":true,"stream":true,"stream_options":{"include_usage":true},"media_io_kwargs":{"video":{"video_backend":"opencv","backend":"opencv","num_frames":4}},"mm_processor_kwargs":{"do_sample_frames":false}}